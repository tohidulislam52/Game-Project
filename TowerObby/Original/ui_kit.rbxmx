		Tween(
			Bubble,
			FadeOutTime,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.In,
			{
				ImageTransparency = 1
			}
		)

		Tween(
			BubbleScale,
			FadeOutTime,
			Enum.EasingStyle.Quint,
