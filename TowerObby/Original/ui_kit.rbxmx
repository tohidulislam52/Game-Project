			MAGNET_SMOOTHNESS,
			DeltaTime
		)

	CurrentX =
		CurrentX
		+ ((TargetX - CurrentX)
			* PositionAlpha)

	CurrentY =
		CurrentY
		+ ((TargetY - CurrentY)
			* PositionAlpha)

	Button.Position = UDim2.new(
		OriginalPosition.X.Scale,

		OriginalPosition.X.Offset
			+ CurrentX,

		OriginalPosition.Y.Scale,

		OriginalPosition.Y.Offset
			+ CurrentY
	)

	local ScaleAlpha =
		SmoothAlpha(
			SCALE_SMOOTHNESS,
			DeltaTime
		)

	CurrentScale =
		CurrentScale
		+ ((TargetScale - CurrentScale)
			* ScaleAlpha)

	Scale.Scale = CurrentScale
end)

task.spawn(function()
	while Button.Parent and not Destroyed do
		task.wait(
			math.random(60, 100) / 10
		)

		if
