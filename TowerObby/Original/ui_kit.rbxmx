				<Item class="LocalScript" referent="RBX73BF00CDD0494E71998D4E1161861518">
					<Properties>
						<ProtectedString name="Source"><![CDATA[-- made by lft_productions

local TweenService = game:GetService("TweenService")

local Button = script.Parent

local HOVER_SOUND_ID = "rbxassetid://136108770017536"
local CLICK_SOUND_ID = "rbxassetid://122835655736085"
local IDLE_SOUND_ID = "rbxassetid://136108770017536"

local BUBBLE_IMAGE_ID = "rbxassetid://134746970554349"

local HOVER_SCALE = 1.045
local CLICK_SCALE = 0.91

local Hovering = false
local Clicking = false
local Destroyed = false

local OriginalPosition = Button.Position
local OriginalRotation = Button.Rotation

local AnimationGeneration = 0

Button.ClipsDescendants = false

local Scale = Button:FindFirstChildOfClass("UIScale")

if not Scale then
	Scale = Instance.new("UIScale")
	Scale.Scale = 1
	Scale.Parent = Button
end

local function RandomFloat(Minimum, Maximum)
	return Minimum + math.random() * (Maximum - Minimum)
end

local function CreateSound(Name, ID, Volume, Speed)
	local Sound = Instance.new("Sound")

	Sound.Name = Name
	Sound.SoundId = ID
	Sound.Volume = Volume
	Sound.PlaybackSpeed = Speed or 1

	Sound.Parent = Button

	return Sound
end

local HoverSound = CreateSound(
	"HoverSound",
	HOVER_SOUND_ID,
	0.32,
	1.05
)

local ClickSound = CreateSound(
	"ClickSound",
	CLICK_SOUND_ID,
	0.56,
	1
)

local IdleSound = CreateSound(
	"IdleSound",
	IDLE_SOUND_ID,
	0.1,
	1.1
)

local function PlaySound(Sound)
	if not Sound then
		return
	end

	if Sound.SoundId == "" then
		return
	end

	if Sound.SoundId == "rbxassetid://0" then
		return
	end

	Sound.TimePosition = 0
	Sound:Play()
end

local BubbleContainer = Instance.new("Frame")

BubbleContainer.Name = "BubbleContainer"
BubbleContainer.AnchorPoint = Vector2.new(0.5, 0.5)
BubbleContainer.Position = UDim2.fromScale(0.5, 0.5)
BubbleContainer.Size = UDim2.fromScale(1, 1)

BubbleContainer.BackgroundTransparency = 1
BubbleContainer.BorderSizePixel = 0
BubbleContainer.ClipsDescendants = false

BubbleContainer.ZIndex = Button.ZIndex + 20
BubbleContainer.Parent = Button

local function Tween(
	Object,
	Duration,
	Style,
	Direction,
	Properties
)
	local Animation = TweenService:Create(
		Object,
		TweenInfo.new(
			Duration,
			Style or Enum.EasingStyle.Quint,
			Direction or Enum.EasingDirection.Out
		),
		Properties
	)

	Animation:Play()

	return Animation
end

local function GetHoverPosition()
	return UDim2.new(
		OriginalPosition.X.Scale,
		OriginalPosition.X.Offset,
		OriginalPosition.Y.Scale,
		OriginalPosition.Y.Offset - 3
	)
end

local function GetPressedPosition()
	return UDim2.new(
		OriginalPosition.X.Scale,
		OriginalPosition.X.Offset,
		OriginalPosition.Y.Scale,
		OriginalPosition.Y.Offset + 3
	)
end

local function MakeBubble(Config)
	if Destroyed then
		return
	end

	Config = Config or {}

	local Width = math.max(
		Button.AbsoluteSize.X,
		1
	)

	local Size =
		Config.Size
		or math.random(7, 23)

	local XSpread =
		Config.XSpread
		or 0.4

	local StartX =
		Config.StartX
		or math.random(
			math.floor(-Width * XSpread),
			math.floor(Width * XSpread)
		)

	local StartY =
		Config.StartY
		or math.random(4, 15)

	local Height =
		Config.Height
		or math.random(75, 135)

	local Drift =
		Config.Drift
		or math.random(-28, 28)

	local Duration =
		Config.Duration
		or RandomFloat(1.0, 1.55)

	local FadeDelay =
		Config.FadeDelay
		or RandomFloat(0.04, 0.32)

	local FadeDuration =
		Config.FadeDuration
		or RandomFloat(0.38, 0.72)

	local EndTransparency =
		Config.EndTransparency
		or RandomFloat(0.03, 0.15)

	local StartScale =
		Config.StartScale
		or RandomFloat(0.28, 0.48)

	local FinalScale =
		Config.FinalScale
		or RandomFloat(0.82, 1.16)

	local Bubble = Instance.new("ImageLabel")

	Bubble.Name = "Bubble"

	Bubble.AnchorPoint =
		Vector2.new(
			0.5,
			0.5
		)

	Bubble.Position =
		UDim2.new(
			0.5,
			StartX,
			1,
			StartY
		)

	Bubble.Size =
		UDim2.fromOffset(
			Size,
			Size
		)

	Bubble.BackgroundTransparency = 1
	Bubble.BorderSizePixel = 0

	Bubble.Image = BUBBLE_IMAGE_ID
	Bubble.ImageTransparency = 1

	Bubble.Rotation =
		math.random(
			-25,
			25
		)

	Bubble.ZIndex =
		Button.ZIndex
		+ math.random(22, 27)

	Bubble.Parent =
		BubbleContainer

	local BubbleScale =
		Instance.new("UIScale")

	BubbleScale.Scale = StartScale
	BubbleScale.Parent = Bubble

	local FirstDrift =
		Drift * RandomFloat(0.35, 0.55)

	local FirstHeight =
		Height * RandomFloat(0.38, 0.5)

	task.delay(
		FadeDelay,
		function()

			if Destroyed then
				return
			end

			if not Bubble.Parent then
				return
			end

			Tween(
				Bubble,
				FadeDuration,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.Out,
				{
					ImageTransparency =
						EndTransparency
				}
			)

			Tween(
				BubbleScale,
				FadeDuration * 1.08,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out,
				{
					Scale = FinalScale
				}
			)

		end
	)

	Tween(
		Bubble,
		Duration * 0.48,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out,
		{
			Position =
				UDim2.new(
					0.5,
					StartX + FirstDrift,
					1,
					StartY - FirstHeight
				),

			Rotation =
				Bubble.Rotation
				+ math.random(-18, 18)
		}
	)

	task.delay(
		Duration * 0.45,
		function()

			if not Bubble.Parent then
				return
			end

			Tween(
				Bubble,
				Duration * 0.55,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Position =
						UDim2.new(
							0.5,
							StartX + Drift,
							1,
							StartY - Height
						),

					Rotation =
						Bubble.Rotation
						+ math.random(
							-35,
							35
						)
				}
			)

		end
	)

	task.delay(
		Duration * 0.35,
		function()

			if not Bubble.Parent then
				return
			end

			Tween(
				BubbleScale,
				Duration * 0.3,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Scale =
						FinalScale
						* RandomFloat(
							1.03,
							1.10
						)
				}
			)

		end
	)

	local FadeOutStart =
		Duration
		* RandomFloat(
			0.66,
			0.77
		)

	task.delay(
		FadeOutStart,
		function()

			if not Bubble.Parent then
				return
			end

			local FadeTime =
				math.max(
					Duration
					- FadeOutStart,
					0.3
				)

			Tween(
				Bubble,
				FadeTime,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.In,
				{
					ImageTransparency = 1
				}
			)

			Tween(
				BubbleScale,
				FadeTime,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.In,
				{
					Scale =
						FinalScale
						* RandomFloat(
							0.35,
							0.55
						)
				}
			)

		end
	)

	task.delay(
		Duration + 0.12,
		function()

			if Bubble then
				Bubble:Destroy()
			end

		end
	)
end

local function SpawnBubbleGroup(
	Amount,
	MinDelay,
	MaxDelay,
	Config
)
	for Index = 1, Amount do

		local Delay =
			(Index - 1)
			* RandomFloat(
				MinDelay,
				MaxDelay
			)

		Delay +=
			RandomFloat(
				0,
				MaxDelay * 0.75
			)

		task.delay(
			Delay,
			function()

				MakeBubble(Config)

			end
		)

	end
end

local function HoverBubbles()
	SpawnBubbleGroup(
		math.random(3, 5),
		0.04,
		0.09,
		{
			Height =
				math.random(
					55,
					90
				),

			Duration =
				RandomFloat(
					0.9,
					1.25
				),

			FadeDuration =
				RandomFloat(
					0.38,
					0.62
				),

			XSpread = 0.38
		}
	)
end

local function ClickBubbles()
	SpawnBubbleGroup(
		5,
		0.015,
		0.04,
		{
			Height =
				math.random(
					70,
					95
				),

			Duration =
				RandomFloat(
					0.85,
					1.1
				),

			FadeDelay =
				RandomFloat(
					0,
					0.12
				),

			XSpread = 0.34
		}
	)

	task.delay(
		0.08,
		function()

			SpawnBubbleGroup(
				7,
				0.025,
				0.065,
				{
					Height =
						math.random(
							90,
							135
						),

					Duration =
						RandomFloat(
							1.05,
							1.45
						),

					FadeDelay =
						RandomFloat(
							0.04,
							0.26
						),

					FadeDuration =
						RandomFloat(
							0.42,
							0.72
						),

					XSpread = 0.42
				}
			)

		end
	)

	task.delay(
		0.2,
		function()

			SpawnBubbleGroup(
				4,
				0.04,
				0.085,
				{
					Size =
						math.random(
							13,
							24
						),

					Height =
						math.random(
							110,
							155
						),

					Duration =
						RandomFloat(
							1.2,
							1.65
						),

					FadeDelay =
						RandomFloat(
							0.12,
							0.3
						),

					FadeDuration =
						RandomFloat(
							0.5,
							0.8
						),

					XSpread = 0.36
				}
			)

		end
	)
end

local function HoverEnter()
	if Destroyed then
		return
	end

	Hovering = true

	PlaySound(HoverSound)

	HoverBubbles()

	if Clicking then
		return
	end

	AnimationGeneration += 1

	Tween(
		Scale,
		0.42,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = HOVER_SCALE
		}
	)

	Tween(
		Button,
		0.42,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position =
				GetHoverPosition(),

			Rotation =
				OriginalRotation
			- 0.45
		}
	)
end

local function HoverLeave()
	if Destroyed then
		return
	end

	Hovering = false

	if Clicking then
		return
	end

	AnimationGeneration += 1

	Tween(
		Scale,
		0.48,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = 1
		}
	)

	Tween(
		Button,
		0.48,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position =
				OriginalPosition,

			Rotation =
				OriginalRotation
		}
	)
end

local function ClickAnimation()
	if Clicking then
		return
	end

	Clicking = true

	AnimationGeneration += 1

	local Generation =
		AnimationGeneration

	PlaySound(ClickSound)

	ClickBubbles()

	Tween(
		Scale,
		0.1,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out,
		{
			Scale = CLICK_SCALE
		}
	)

	Tween(
		Button,
		0.1,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out,
		{
			Position =
				GetPressedPosition(),

			Rotation =
				OriginalRotation
				+ 0.65
		}
	)

	task.delay(
		0.095,
		function()

			if Destroyed then
				return
			end

			if Generation ~= AnimationGeneration then
				return
			end

			Tween(
				Scale,
				0.3,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out,
				{
					Scale =
						Hovering
						and 1.065
						or 1.035
				}
			)

			Tween(
				Button,
				0.3,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out,
				{
					Position =
						UDim2.new(
							OriginalPosition.X.Scale,
							OriginalPosition.X.Offset,
							OriginalPosition.Y.Scale,
							OriginalPosition.Y.Offset - 4
						),

					Rotation =
						OriginalRotation
					- 0.7
				}
			)

		end
	)

	task.delay(
		0.31,
		function()

			if Destroyed then
				return
			end

			if Generation ~= AnimationGeneration then
				return
			end

			Tween(
				Scale,
				0.26,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Scale =
						Hovering
						and 1.035
						or 0.992
				}
			)

			Tween(
				Button,
				0.26,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Position =
						Hovering
						and GetHoverPosition()
						or OriginalPosition,

					Rotation =
						OriginalRotation
						+ 0.18
				}
			)

		end
	)

	task.delay(
		0.52,
		function()

			if Destroyed then
				return
			end

			if Generation ~= AnimationGeneration then
				return
			end

			Tween(
				Scale,
				0.38,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out,
				{
					Scale =
						Hovering
						and HOVER_SCALE
						or 1
				}
			)

			Tween(
				Button,
				0.38,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out,
				{
					Position =
						Hovering
						and GetHoverPosition()
						or OriginalPosition,

					Rotation =
						Hovering
						and OriginalRotation - 0.45
						or OriginalRotation
				}
			)

		end
	)

	task.delay(
		0.8,
		function()

			if Generation ~= AnimationGeneration then
				return
			end

			Clicking = false

		end
	)
end

Button.MouseEnter:Connect(
	HoverEnter
)

Button.MouseLeave:Connect(
	HoverLeave
)

Button.Activated:Connect(
	ClickAnimation
)

Button.AncestryChanged:Connect(function()

	if not Button:IsDescendantOf(game) then
		Destroyed = true
	end

end)

task.spawn(function()

	while
		Button.Parent
		and not Destroyed
	do

		task.wait(
			RandomFloat(
				5.5,
				9
			)
		)

		if
			not Hovering
			and not Clicking
			and not Destroyed
		then

			PlaySound(
				IdleSound
			)

			if math.random() < 0.7 then

				SpawnBubbleGroup(
					math.random(1, 3),
					0.1,
					0.22,
					{
						Height =
							math.random(
								45,
								75
							),

						Duration =
