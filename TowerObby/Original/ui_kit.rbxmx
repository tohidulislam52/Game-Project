			<Properties>
				<ProtectedString name="Source"><![CDATA[-- Preload the button pack's images and sounds before the player interacts.
local ContentProvider = game:GetService("ContentProvider")
local screenGui = script.Parent
local pack = screenGui:FindFirstChild("MegaPack")
if not pack then
	warn("[PreloadButtonAssets] MegaPack was not found.")
	return
end

local ids = {}
local seen = {}

local function addId(value)
	if typeof(value) ~= "string" then return end
	for digits in value:gmatch("rbxassetid://(%d+)") do
		if digits ~= "0" and not seen[digits] then
			seen[digits] = true
			table.insert(ids, digits)
		end
	end
end

-- Image IDs defined in the individual button scripts for burst particles,
-- plus the hover, click, and idle sound IDs.
local scriptAssetIds = {
	"101093482235249", "101434410779846", "103442007980360",
	"106427777463441", "110011178140123", "110028519824090",
	"111082385422912", "111618439943749", "114371893357657",
	"117887290906009", "119884033550057", "120415133302584",
	"120624533933389", "121657620859761", "122835655736085",
	"123615211721249", "126185390548906", "128616077930951",
	"133449971610824", "134734003678221", "134746970554349",
	"135804309692238", "136108770017536", "73552063953074",
	"73663005164552", "74034821318674", "74110488072850",
	"74315143119360", "81274757853826", "82245534076245",
	"82816180109392", "85387955042762", "85924614506626",
	"90381660940146", "91896537853337", "92628551554815",
	"94575482748360", "96160646700358", "98051473530755",
}
for _, id in ipairs(scriptAssetIds) do
	addId("rbxassetid://" .. id)
end

-- Include every image/sound already assigned in the GUI.
for _, item in ipairs(pack:GetDescendants()) do
	if item:IsA("ImageButton") or item:IsA("ImageLabel") then
		addId(item.Image)
	elseif item:IsA("Decal") then
		addId(item.Texture)
	elseif item:IsA("Sound") then
		addId(item.SoundId)
	end
end

-- PreloadAsync works on content-bearing instances. Use temporary, unparented
-- instances so the assets are requested without changing the visible GUI.
local preloadInstances = {}
for _, id in ipairs(ids) do
	local uri = "rbxassetid://" .. id
	local image = Instance.new("ImageLabel")
	image.Image = uri
	table.insert(preloadInstances, image)

	local sound = Instance.new("Sound")
	sound.SoundId = uri
	table.insert(preloadInstances, sound)
end

local ok, err = pcall(function()
	ContentProvider:PreloadAsync(preloadInstances)
end)

for _, instance in ipairs(preloadInstances) do
	instance:Destroy()
end

if ok then
	print(("[PreloadButtonAssets] Preloaded %d unique asset IDs."):format(#ids))
else
	warn(("[PreloadButtonAssets] Preload failed: %s"):format(tostring(err)))
end
]]></ProtectedString>
