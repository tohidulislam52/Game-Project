						Scale = 1
					}
				)

				Tween(
					Button,
					0.95,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					{
						Position =
							OriginalPosition,

						Rotation =
							OriginalRotation
					}
				)

			end

		end

	end

