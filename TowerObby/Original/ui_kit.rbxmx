	local StartX =
		math.cos(Angle)
		* StartDistance

	local StartY =
		math.sin(Angle)
		* StartDistance

	local EndX =
		math.cos(Angle)
		* EndDistance

	local EndY =
		math.sin(Angle)
		* EndDistance

	Particle.Position = UDim2.new(
		Origin.X,
		StartX,
		Origin.Y,
		StartY
	)

	local Width =
		math.random(2, 5)

	local Height =
		math.random(5, 11)

	Particle.Size = UDim2.fromOffset(
		Width,
		Height
	)

	Particle.BackgroundColor3 =
		Color3.fromRGB(
			255,
			255,
			255
		)

	Particle.BackgroundTransparency = 1
	Particle.BorderSizePixel = 0

	Particle.Rotation =
		math.deg(Angle)

	Particle.ZIndex =
		Button.ZIndex + 26

	Particle.Parent =
		FXContainer

	local Corner =
		Instance.new("UICorner")

	Corner.CornerRadius =
		UDim.new(1, 0)

	Corner.Parent =
		Particle

	local Duration =
		math.random(35, 55)
		/ 100

	Tween(
		Particle,
		0.1,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out,
		{
			BackgroundTransparency =
				math.random(8, 22)
				/ 100
		}
	)

	Tween(
		Particle,
		Duration,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position =
				UDim2.new(
					Origin.X,
					EndX,
					Origin.Y,
					EndY
				),

			Size =
				UDim2.fromOffset(
					1,
					2
				),

			BackgroundTransparency = 1,

			Rotation =
				Particle.Rotation
				+ math.random(
					-50,
					50
				)
		}
	)

	task.delay(Duration + 0.05, function()
		if Particle then
			Particle:Destroy()
		end
	end)
end

local function ParticlePulse(Origin, Amount)
	for Index = 1, Amount do
		task.delay(
			(Index - 1)
				* math.random(5, 14)
				/ 1000,
			function()
				CreateParticle(Origin)
			end
		)
	end
end

local function ClickEffect(Origin)
	CreateRing(
		Origin,
		8,
		65,
		0.12,
		1,
		0.5,
		2.6
	)

	task.delay(0.045, function()
		CreateRing(
			Origin,
			5,
			90,
			0.35,
			1,
			0.7,
			1.8
		)
	end)

	task.delay(0.12, function()
		CreateRing(
			Origin,
			3,
			115,
			0.6,
			1,
			0.9,
			1
		)
	end)

	ParticlePulse(
		Origin,
		12
	)
end

local function HoverEffect()
	CreateRing(
		Vector2.new(0.5, 0.5),
		15,
		50,
		0.75,
		1,
		0.55,
		1.2
	)
end

local function HoverEnter()
	if Destroyed then
		return
	end

	Hovering = true

	PlaySound(HoverSound)

	HoverEffect()

	Tween(
		GlowStroke,
		0.35,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out,
		{
			Transparency = 0.55,
			Thickness = 3
		}
	)

	if Clicking then
		return
	end

	Tween(
		Scale,
		0.38,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = 1.045
		}
	)

	Tween(
		Button,
		0.38,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position = GetHoverPosition(),
			Rotation = OriginalRotation - 0.35
		}
	)
end

local function HoverLeave()
	if Destroyed then
		return
	end

	Hovering = false

	Tween(
		GlowStroke,
		0.45,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out,
		{
			Transparency = 1,
			Thickness = 2
		}
	)

	if Clicking then
		return
	end

	Tween(
		Scale,
		0.42,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = 1
		}
	)

	Tween(
		Button,
		0.42,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position = OriginalPosition,
			Rotation = OriginalRotation
		}
	)
end

local function ClickAnimation()
	if Clicking then
		return
	end

	Clicking = true

	PlaySound(ClickSound)

	ClickEffect(LastClickPosition)

	Tween(
		GlowStroke,
		0.1,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out,
		{
			Transparency = 0.08,
			Thickness = 4
		}
	)

	Tween(
		Scale,
		0.085,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out,
		{
			Scale = 0.91
		}
	)

	task.delay(0.08, function()
		if Destroyed then
			return
		end

		Tween(
			Scale,
			0.25,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out,
			{
				Scale =
					Hovering
					and 1.075
					or 1.04
			}
		)
	end)

	task.delay(0.26, function()
		if Destroyed then
			return
		end

		Tween(
			GlowStroke,
			0.48,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out,
			{
				Transparency =
					Hovering
					and 0.55
					or 1,

				Thickness =
					Hovering
					and 3
					or 2
			}
		)

		Tween(
			Scale,
			0.4,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out,
			{
				Scale =
					Hovering
					and 1.045
					or 1
			}
		)
	end)

	task.delay(0.65, function()
		Clicking = false
	end)
end

Button.InputBegan:Connect(function(Input)
	if
		Input.UserInputType
		== Enum.UserInputType.MouseButton1
		or
		Input.UserInputType
		== Enum.UserInputType.Touch
	then

		LastClickPosition =
			GetLocalClickPosition(
				Input.Position
			)
	end
end)

Button.MouseButton1Down:Connect(function()
	if not UserInputService.TouchEnabled then

		local MousePosition =
			UserInputService:GetMouseLocation()

		LastClickPosition =
			GetLocalClickPosition(
				MousePosition
			)
	end
end)

Button.MouseEnter:Connect(HoverEnter)
Button.MouseLeave:Connect(HoverLeave)

Button.Activated:Connect(
	ClickAnimation
)

Button.AncestryChanged:Connect(function()
	if not Button:IsDescendantOf(game) then
		Destroyed = true
	end
end)

task.spawn(function()
	while
		Button.Parent
		and not Destroyed
	do

		task.wait(
			math.random(55, 90)
				/ 10
		)

		if
			not Hovering
			and not Clicking
			and not Destroyed
		then

			PlaySound(IdleSound)

			CreateRing(
				Vector2.new(
					0.5,
					0.5
				),
				12,
				48,
				0.9,
				1,
				0.75,
				1
			)

			Tween(
				Scale,
				0.75,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Scale = 1.012
				}
			)

			task.wait(0.76)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then

				Tween(
					Scale,
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					{
						Scale = 1
					}
				)
			end
		end
	end
end)]]></ProtectedString>
