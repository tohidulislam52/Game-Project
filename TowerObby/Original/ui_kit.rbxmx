local function HoverEnter()
	if Destroyed then
		return
	end

	Hovering = true

	PlaySound(HoverSound)

	if Clicking then
		return
	end

	Tween(
		Scale,
		0.36,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = HOVER_SCALE
		}
	)

	Tween(
		Button,
		0.36,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position = GetHoverPosition(),
			Rotation = OriginalRotation - 0.4
		}
	)

	BubbleRise(3)
end

local function HoverLeave()
	if Destroyed then
		return
	end

	Hovering = false

	if Clicking then
		return
	end

	Tween(
		Scale,
		0.4,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = 1
		}
	)

	Tween(
		Button,
		0.4,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position = OriginalPosition,
			Rotation = OriginalRotation
		}
	)
