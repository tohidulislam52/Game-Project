						<ProtectedString name="Source"><![CDATA[-- made by lft_productions

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Button = script.Parent

local HOVER_SOUND_ID = "rbxassetid://136108770017536"
local CLICK_SOUND_ID = "rbxassetid://122835655736085"
local IDLE_SOUND_ID = "rbxassetid://136108770017536"

local Hovering = false
local Clicking = false
local Destroyed = false

local OriginalPosition = Button.Position
local OriginalRotation = Button.Rotation

local LastClickPosition = Vector2.new(0.5, 0.5)

Button.ClipsDescendants = false

local Scale = Button:FindFirstChildOfClass("UIScale")

if not Scale then
	Scale = Instance.new("UIScale")
	Scale.Scale = 1
	Scale.Parent = Button
end

local function Tween(Object, Time, Style, Direction, Properties)
	local Animation = TweenService:Create(
		Object,
		TweenInfo.new(
			Time,
			Style or Enum.EasingStyle.Quint,
			Direction or Enum.EasingDirection.Out
		),
		Properties
	)

	Animation:Play()

	return Animation
end

local function CreateSound(Name, ID, Volume, Speed)
	local Sound = Instance.new("Sound")

	Sound.Name = Name
	Sound.SoundId = ID
	Sound.Volume = Volume
	Sound.PlaybackSpeed = Speed or 1
	Sound.Parent = Button

	return Sound
end

local HoverSound = CreateSound(
	"HoverSound",
	HOVER_SOUND_ID,
	0.3,
	1.05
)

local ClickSound = CreateSound(
	"ClickSound",
	CLICK_SOUND_ID,
	0.55,
	1
)

local IdleSound = CreateSound(
	"IdleSound",
	IDLE_SOUND_ID,
	0.1,
	1.08
)

local function PlaySound(Sound)
	if not Sound then
		return
	end

	if Sound.SoundId == "" then
		return
	end

	if Sound.SoundId == "rbxassetid://0" then
		return
	end

	Sound.TimePosition = 0
	Sound:Play()
end

local FXContainer = Instance.new("Frame")

FXContainer.Name = "FXContainer"
FXContainer.AnchorPoint = Vector2.new(0, 0)
FXContainer.Position = UDim2.fromScale(0, 0)
FXContainer.Size = UDim2.fromScale(1, 1)

FXContainer.BackgroundTransparency = 1
FXContainer.BorderSizePixel = 0

FXContainer.ClipsDescendants = false
FXContainer.ZIndex = Button.ZIndex + 20

FXContainer.Parent = Button

local Glow = Instance.new("Frame")

Glow.Name = "Glow"
Glow.AnchorPoint = Vector2.new(0.5, 0.5)
Glow.Position = UDim2.fromScale(0.5, 0.5)

Glow.Size = UDim2.new(
	1,
	8,
	1,
	8
)

Glow.BackgroundTransparency = 1
Glow.BorderSizePixel = 0

Glow.ZIndex = Button.ZIndex - 1
Glow.Parent = Button

local GlowCorner = Instance.new("UICorner")

GlowCorner.CornerRadius = UDim.new(
	0.22,
	0
)

GlowCorner.Parent = Glow

local GlowStroke = Instance.new("UIStroke")

GlowStroke.Thickness = 2
GlowStroke.Transparency = 1
GlowStroke.Color = Color3.fromRGB(255, 255, 255)

GlowStroke.Parent = Glow

local function GetHoverPosition()
	return UDim2.new(
		OriginalPosition.X.Scale,
		OriginalPosition.X.Offset,
		OriginalPosition.Y.Scale,
		OriginalPosition.Y.Offset - 2
	)
end

local function GetLocalClickPosition(ScreenPosition)
	local AbsolutePosition = Button.AbsolutePosition
	local AbsoluteSize = Button.AbsoluteSize

	if AbsoluteSize.X <= 0 or AbsoluteSize.Y <= 0 then
		return Vector2.new(0.5, 0.5)
	end

	local X =
		(ScreenPosition.X - AbsolutePosition.X)
		/ AbsoluteSize.X

	local Y =
		(ScreenPosition.Y - AbsolutePosition.Y)
		/ AbsoluteSize.Y

	return Vector2.new(
		math.clamp(X, 0, 1),
		math.clamp(Y, 0, 1)
	)
end

local function CreateRing(
	Origin,
	StartSize,
	EndSize,
	StartTransparency,
	EndTransparency,
	Time,
	Thickness
)
	if Destroyed then
		return
	end

	local Ring = Instance.new("Frame")

	Ring.Name = "Ripple"

	Ring.AnchorPoint = Vector2.new(0.5, 0.5)

	Ring.Position = UDim2.fromScale(
		Origin.X,
		Origin.Y
	)

	Ring.Size = UDim2.fromOffset(
		StartSize,
		StartSize
	)

	Ring.BackgroundTransparency = 1
	Ring.BorderSizePixel = 0

	Ring.ZIndex = Button.ZIndex + 25

	Ring.Parent = FXContainer

	local Corner = Instance.new("UICorner")

	Corner.CornerRadius = UDim.new(
		1,
		0
	)

	Corner.Parent = Ring

	local Stroke = Instance.new("UIStroke")

	Stroke.Thickness = Thickness or 2
	Stroke.Transparency = StartTransparency
	Stroke.Color = Color3.fromRGB(255, 255, 255)

	Stroke.Parent = Ring

	Tween(
		Ring,
		Time,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Size = UDim2.fromOffset(
				EndSize,
				EndSize
			)
		}
	)

	Tween(
		Stroke,
		Time,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out,
		{
			Transparency = EndTransparency,
			Thickness = 0.4
		}
	)

	task.delay(Time + 0.05, function()
		if Ring then
			Ring:Destroy()
		end
	end)
end

local function CreateParticle(Origin)
	if Destroyed then
		return
	end

	local Particle = Instance.new("Frame")

	Particle.Name = "Particle"
	Particle.AnchorPoint = Vector2.new(0.5, 0.5)

	local Angle = math.rad(
		math.random(0, 359)
	)

	local StartDistance =
		math.random(2, 7)

	local EndDistance =
		math.random(35, 75)

	local StartX =
		math.cos(Angle)
		* StartDistance

	local StartY =
		math.sin(Angle)
		* StartDistance

	local EndX =
		math.cos(Angle)
		* EndDistance

	local EndY =
		math.sin(Angle)
		* EndDistance

	Particle.Position = UDim2.new(
		Origin.X,
		StartX,
		Origin.Y,
		StartY
	)

	local Width =
		math.random(2, 5)

	local Height =
		math.random(5, 11)

	Particle.Size = UDim2.fromOffset(
		Width,
		Height
	)

	Particle.BackgroundColor3 =
		Color3.fromRGB(
			255,
			255,
			255
		)

	Particle.BackgroundTransparency = 1
	Particle.BorderSizePixel = 0

	Particle.Rotation =
		math.deg(Angle)

	Particle.ZIndex =
		Button.ZIndex + 26

	Particle.Parent =
		FXContainer

	local Corner =
		Instance.new("UICorner")

	Corner.CornerRadius =
		UDim.new(1, 0)

	Corner.Parent =
		Particle

	local Duration =
		math.random(35, 55)
		/ 100

	Tween(
		Particle,
		0.1,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out,
		{
			BackgroundTransparency =
				math.random(8, 22)
				/ 100
		}
	)

	Tween(
		Particle,
		Duration,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position =
				UDim2.new(
					Origin.X,
					EndX,
					Origin.Y,
					EndY
				),

			Size =
				UDim2.fromOffset(
					1,
					2
				),

			BackgroundTransparency = 1,

			Rotation =
				Particle.Rotation
				+ math.random(
					-50,
					50
				)
		}
	)

	task.delay(Duration + 0.05, function()
		if Particle then
			Particle:Destroy()
		end
	end)
end

local function ParticlePulse(Origin, Amount)
	for Index = 1, Amount do
		task.delay(
			(Index - 1)
				* math.random(5, 14)
				/ 1000,
			function()
				CreateParticle(Origin)
			end
		)
	end
end

local function ClickEffect(Origin)
	CreateRing(
		Origin,
		8,
		65,
		0.12,
		1,
		0.5,
		2.6
	)

	task.delay(0.045, function()
		CreateRing(
			Origin,
			5,
			90,
			0.35,
			1,
			0.7,
			1.8
		)
	end)

	task.delay(0.12, function()
		CreateRing(
			Origin,
			3,
			115,
			0.6,
			1,
			0.9,
			1
		)
	end)

	ParticlePulse(
		Origin,
		12
	)
end

local function HoverEffect()
	CreateRing(
		Vector2.new(0.5, 0.5),
		15,
		50,
		0.75,
		1,
		0.55,
		1.2
	)
end

local function HoverEnter()
	if Destroyed then
		return
	end

	Hovering = true

	PlaySound(HoverSound)

	HoverEffect()

	Tween(
		GlowStroke,
		0.35,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out,
		{
			Transparency = 0.55,
			Thickness = 3
		}
	)

	if Clicking then
		return
	end

	Tween(
		Scale,
		0.38,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = 1.045
		}
	)

	Tween(
		Button,
		0.38,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position = GetHoverPosition(),
			Rotation = OriginalRotation - 0.35
		}
	)
end

local function HoverLeave()
	if Destroyed then
		return
	end

	Hovering = false

	Tween(
		GlowStroke,
		0.45,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out,
		{
			Transparency = 1,
			Thickness = 2
		}
	)

	if Clicking then
		return
	end

	Tween(
		Scale,
		0.42,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = 1
		}
	)

	Tween(
		Button,
		0.42,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position = OriginalPosition,
			Rotation = OriginalRotation
		}
	)
end

local function ClickAnimation()
	if Clicking then
		return
	end

	Clicking = true

	PlaySound(ClickSound)

	ClickEffect(LastClickPosition)

	Tween(
		GlowStroke,
		0.1,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out,
		{
			Transparency = 0.08,
			Thickness = 4
		}
	)

	Tween(
		Scale,
		0.085,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out,
		{
			Scale = 0.91
		}
	)

	task.delay(0.08, function()
		if Destroyed then
			return
		end

		Tween(
			Scale,
			0.25,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out,
			{
				Scale =
					Hovering
					and 1.075
					or 1.04
			}
		)
	end)

	task.delay(0.26, function()
		if Destroyed then
			return
		end

		Tween(
			GlowStroke,
			0.48,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out,
			{
				Transparency =
					Hovering
					and 0.55
					or 1,

				Thickness =
					Hovering
					and 3
					or 2
			}
		)

		Tween(
			Scale,
			0.4,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out,
			{
				Scale =
					Hovering
					and 1.045
					or 1
			}
		)
	end)

	task.delay(0.65, function()
		Clicking = false
	end)
end

Button.InputBegan:Connect(function(Input)
	if
		Input.UserInputType
		== Enum.UserInputType.MouseButton1
		or
		Input.UserInputType
		== Enum.UserInputType.Touch
	then

		LastClickPosition =
			GetLocalClickPosition(
				Input.Position
			)
	end
end)

Button.MouseButton1Down:Connect(function()
	if not UserInputService.TouchEnabled then

		local MousePosition =
			UserInputService:GetMouseLocation()

		LastClickPosition =
			GetLocalClickPosition(
				MousePosition
			)
	end
end)

Button.MouseEnter:Connect(HoverEnter)
Button.MouseLeave:Connect(HoverLeave)

Button.Activated:Connect(
	ClickAnimation
)

Button.AncestryChanged:Connect(function()
	if not Button:IsDescendantOf(game) then
		Destroyed = true
	end
end)

task.spawn(function()
	while
		Button.Parent
		and not Destroyed
	do

		task.wait(
			math.random(55, 90)
				/ 10
		)

		if
			not Hovering
			and not Clicking
			and not Destroyed
		then

			PlaySound(IdleSound)

			CreateRing(
				Vector2.new(
					0.5,
					0.5
				),
				12,
				48,
				0.9,
				1,
				0.75,
				1
			)

			Tween(
				Scale,
				0.75,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Scale = 1.012
				}
			)

			task.wait(0.76)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then

				Tween(
					Scale,
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					{
						Scale = 1
					}
				)
			end
		end
	end
end)]]></ProtectedString>
