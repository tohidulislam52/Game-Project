local function BubbleRise(Count)
	for Index = 1, Count do

		local SpawnDelay =
			(Index - 1)
			* math.random(22, 55)
			/ 1000

		SpawnDelay +=
			math.random(0, 45)
			/ 1000

		task.delay(SpawnDelay, function()
			CreateBubble()
		end)
	end
end

local function HoverEnter()
	if Destroyed then
		return
	end

	Hovering = true

	PlaySound(HoverSound)

	if Clicking then
