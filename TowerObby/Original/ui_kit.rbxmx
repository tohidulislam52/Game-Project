		else
			TargetScale = 1.045
		end
	end)

	task.delay(0.15, function()
		if Destroyed then
			return
		end

		if Hovering then
			TargetScale = 1.04
		else
			TargetScale = 0.985
		end
	end)

	task.delay(0.24, function()
		if Destroyed then
			return
		end

		if Hovering then
			TargetScale = HOVER_SCALE
		else
			TargetScale = 1
		end
	end)

	task.delay(0.34, function()
		Clicking = false
	end)
end

Button.MouseEnter:Connect(function()
	Hovering = true

	PlaySound(HoverSound)

	if not Clicking then
		TargetScale = HOVER_SCALE
	end
end)

Button.MouseLeave:Connect(function()
	Hovering = false

	TargetX = 0
	TargetY = 0

	if not Clicking then
		TargetScale = 1
	end
end)

