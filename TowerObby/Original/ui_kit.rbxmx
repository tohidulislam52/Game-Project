					<Properties>
						<ProtectedString name="Source"><![CDATA[-- made by lft_productions

local TweenService = game:GetService("TweenService")

local Button = script.Parent

local HOVER_SOUND_ID = "rbxassetid://136108770017536"
local CLICK_SOUND_ID = "rbxassetid://122835655736085"
local IDLE_SOUND_ID = "rbxassetid://136108770017536"

local BUBBLE_IMAGE_ID = "rbxassetid://128616077930951"

local HOVER_SCALE = 1.04
local CLICK_SCALE = 0.93

local BUBBLE_COUNT = 12

local MIN_FADE_IN_TIME = 0.32
local MAX_FADE_IN_TIME = 0.62

local MIN_FADE_DELAY = 0
local MAX_FADE_DELAY = 0.22

local Hovering = false
local Clicking = false
local Destroyed = false

local OriginalPosition = Button.Position
local OriginalRotation = Button.Rotation

Button.ClipsDescendants = false

local Scale = Button:FindFirstChildOfClass("UIScale")

if not Scale then
	Scale = Instance.new("UIScale")
	Scale.Scale = 1
	Scale.Parent = Button
end

local function CreateSound(Name, ID, Volume, Speed)
	local Sound = Instance.new("Sound")

	Sound.Name = Name
	Sound.SoundId = ID
	Sound.Volume = Volume
	Sound.PlaybackSpeed = Speed or 1

	Sound.Parent = Button

	return Sound
end

local HoverSound = CreateSound(
	"HoverSound",
	HOVER_SOUND_ID,
	0.32,
	1.04
)

local ClickSound = CreateSound(
	"ClickSound",
	CLICK_SOUND_ID,
	0.52,
	1
)

local IdleSound = CreateSound(
	"IdleSound",
	IDLE_SOUND_ID,
	0.11,
	1.08
)

local function PlaySound(Sound)
	if not Sound then
		return
	end

	if Sound.SoundId == "" then
		return
	end

	if Sound.SoundId == "rbxassetid://0" then
		return
	end

	Sound.TimePosition = 0
	Sound:Play()
end

local BubbleContainer = Instance.new("Frame")

BubbleContainer.Name = "BubbleContainer"
BubbleContainer.AnchorPoint = Vector2.new(0.5, 0.5)
BubbleContainer.Position = UDim2.fromScale(0.5, 0.5)
BubbleContainer.Size = UDim2.fromScale(1, 1)

BubbleContainer.BackgroundTransparency = 1
BubbleContainer.BorderSizePixel = 0
BubbleContainer.ClipsDescendants = false

BubbleContainer.ZIndex = Button.ZIndex + 20
BubbleContainer.Parent = Button

local function Tween(Object, Duration, Style, Direction, Properties)
	local Animation = TweenService:Create(
		Object,
		TweenInfo.new(
			Duration,
			Style or Enum.EasingStyle.Quart,
			Direction or Enum.EasingDirection.Out
		),
		Properties
	)

	Animation:Play()

	return Animation
end

local function GetHoverPosition()
	return UDim2.new(
		OriginalPosition.X.Scale,
		OriginalPosition.X.Offset,
		OriginalPosition.Y.Scale,
		OriginalPosition.Y.Offset - 2
	)
end

local function CreateBubble()
	if Destroyed then
		return
	end

	local Bubble = Instance.new("ImageLabel")

	Bubble.Name = "Bubble"
	Bubble.AnchorPoint = Vector2.new(0.5, 0.5)

	local Width = math.max(
		Button.AbsoluteSize.X,
		1
	)

	local StartX = math.random(
		math.floor(-Width * 0.38),
		math.floor(Width * 0.38)
	)

	local StartY = math.random(5, 14)

	Bubble.Position = UDim2.new(
		0.5,
		StartX,
		1,
		StartY
	)

	local Size = math.random(8, 22)

	Bubble.Size = UDim2.fromOffset(
		Size,
		Size
	)

	Bubble.BackgroundTransparency = 1
	Bubble.BorderSizePixel = 0

	Bubble.Image = BUBBLE_IMAGE_ID

	Bubble.ImageTransparency = 1

	Bubble.Rotation = math.random(-25, 25)

	Bubble.ZIndex = Button.ZIndex + 25
	Bubble.Parent = BubbleContainer

	local BubbleScale = Instance.new("UIScale")

	BubbleScale.Scale = math.random(30, 50) / 100
	BubbleScale.Parent = Bubble

	local RiseHeight = math.random(70, 125)

	local Drift = math.random(-24, 24)

	local Duration =
		math.random(90, 125) / 100

	local FinalScale =
		math.random(82, 118) / 100

	local FadeDelay =
		math.random(
			math.floor(MIN_FADE_DELAY * 100),
			math.floor(MAX_FADE_DELAY * 100)
		) / 100

	local FadeInDuration =
		math.random(
			math.floor(MIN_FADE_IN_TIME * 100),
			math.floor(MAX_FADE_IN_TIME * 100)
		) / 100

	local TargetTransparency =
		math.random(4, 14) / 100

	task.delay(FadeDelay, function()
		if Destroyed then
			return
		end

		if not Bubble.Parent then
			return
		end

		Tween(
			Bubble,
			FadeInDuration,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out,
			{
				ImageTransparency =
					TargetTransparency
			}
		)

		Tween(
			BubbleScale,
			FadeInDuration * 1.08,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out,
			{
				Scale = FinalScale
			}
		)
	end)

	Tween(
		Bubble,
		Duration,
		Enum.EasingStyle.Sine,
		Enum.EasingDirection.Out,
		{
			Position = UDim2.new(
				0.5,
				StartX + Drift,
				1,
				-RiseHeight
			),

			Rotation =
				Bubble.Rotation
				+ math.random(-35, 35)
		}
	)

	task.delay(Duration * 0.32, function()
		if not Bubble.Parent then
			return
		end

		Tween(
			BubbleScale,
			Duration * 0.38,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.InOut,
			{
				Scale =
					FinalScale
					* math.random(104, 112)
					/ 100
			}
		)
	end)

	local FadeOutStart =
		Duration
		* math.random(62, 72)
		/ 100

	task.delay(FadeOutStart, function()
		if not Bubble.Parent then
			return
		end

		local FadeOutTime =
			math.max(
				Duration - FadeOutStart,
				0.25
			)

		Tween(
			Bubble,
			FadeOutTime,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.In,
			{
				ImageTransparency = 1
			}
		)

		Tween(
			BubbleScale,
			FadeOutTime,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.In,
			{
				Scale =
					FinalScale
					* math.random(35, 55)
					/ 100
			}
		)
	end)

	task.delay(Duration + 0.08, function()
		if Bubble then
			Bubble:Destroy()
		end
	end)
end

local function BubbleRise(Count)
	for Index = 1, Count do

		local SpawnDelay =
			(Index - 1)
			* math.random(22, 55)
			/ 1000

		SpawnDelay +=
			math.random(0, 45)
			/ 1000

		task.delay(SpawnDelay, function()
			CreateBubble()
		end)
	end
end

local function HoverEnter()
	if Destroyed then
		return
	end

	Hovering = true

	PlaySound(HoverSound)

	if Clicking then
		return
	end

	Tween(
		Scale,
		0.36,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = HOVER_SCALE
		}
	)

	Tween(
		Button,
		0.36,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position = GetHoverPosition(),
			Rotation = OriginalRotation - 0.4
		}
	)

	BubbleRise(3)
end

local function HoverLeave()
	if Destroyed then
		return
	end

	Hovering = false

	if Clicking then
		return
	end

	Tween(
		Scale,
		0.4,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Scale = 1
		}
	)

	Tween(
		Button,
		0.4,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.Out,
		{
			Position = OriginalPosition,
			Rotation = OriginalRotation
		}
	)
end

local function ClickAnimation()
	if Clicking then
		return
	end

	Clicking = true

	PlaySound(ClickSound)

	BubbleRise(BUBBLE_COUNT)

	Tween(
		Scale,
		0.11,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out,
		{
			Scale = CLICK_SCALE
		}
	)

	Tween(
		Button,
		0.11,
		Enum.EasingStyle.Quart,
		Enum.EasingDirection.Out,
		{
			Position = UDim2.new(
				OriginalPosition.X.Scale,
				OriginalPosition.X.Offset,
				OriginalPosition.Y.Scale,
				OriginalPosition.Y.Offset + 2
			),

			Rotation = OriginalRotation + 0.5
		}
	)

	task.delay(0.1, function()
		if Destroyed then
			return
		end

		Tween(
			Scale,
			0.28,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out,
			{
				Scale =
					Hovering
					and 1.052
					or 1.016
			}
		)

		Tween(
			Button,
			0.28,
			Enum.EasingStyle.Quint,
			Enum.EasingDirection.Out,
			{
				Position =
					Hovering
					and GetHoverPosition()
					or OriginalPosition,

				Rotation =
					Hovering
					and OriginalRotation - 0.3
					or OriginalRotation
			}
		)
	end)

	task.delay(0.34, function()
		if Destroyed then
			return
		end

		Tween(
			Scale,
			0.32,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out,
			{
				Scale =
					Hovering
					and HOVER_SCALE
					or 1
			}
		)

		Tween(
			Button,
			0.32,
			Enum.EasingStyle.Sine,
			Enum.EasingDirection.Out,
			{
				Position =
					Hovering
					and GetHoverPosition()
					or OriginalPosition,

				Rotation =
					Hovering
					and OriginalRotation - 0.4
					or OriginalRotation
			}
		)
	end)

	task.delay(0.58, function()
		Clicking = false
	end)
end

Button.MouseEnter:Connect(HoverEnter)
Button.MouseLeave:Connect(HoverLeave)
Button.Activated:Connect(ClickAnimation)

Button.AncestryChanged:Connect(function()
	if not Button:IsDescendantOf(game) then
		Destroyed = true
	end
end)

task.spawn(function()
	while Button.Parent and not Destroyed do

		task.wait(
			math.random(65, 100) / 10
		)

		if
			not Hovering
			and not Clicking
			and not Destroyed
		then

			PlaySound(IdleSound)

			Tween(
				Scale,
				0.75,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Scale = 1.01
				}
			)

			Tween(
				Button,
				0.75,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Position = UDim2.new(
						OriginalPosition.X.Scale,
						OriginalPosition.X.Offset,
						OriginalPosition.Y.Scale,
						OriginalPosition.Y.Offset - 1
					)
				}
			)

			task.wait(0.76)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then

				Tween(
					Scale,
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					{
						Scale = 1
					}
				)

				Tween(
					Button,
					0.8,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					{
						Position = OriginalPosition
					}
				)
			end
		end
	end
end)]]></ProtectedString>
