					Scale = 1.012
				}
			)

			Tween(
				Button,
				0.85,
				Enum.EasingStyle.Sine,
				Enum.EasingDirection.InOut,
				{
					Position =
						UDim2.new(
							OriginalPosition.X.Scale,
							OriginalPosition.X.Offset,
							OriginalPosition.Y.Scale,
							OriginalPosition.Y.Offset - 1.5
						),

					Rotation =
						OriginalRotation
					- 0.15
				}
			)

			task.wait(0.88)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then

				Tween(
					Scale,
					0.95,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					{
						Scale = 1
					}
				)

				Tween(
					Button,
					0.95,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut,
					{
						Position =
							OriginalPosition,

						Rotation =
							OriginalRotation
					}
				)

			end

		end

	end

