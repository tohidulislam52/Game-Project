local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Button = script.Parent

local HOVER_SOUND_ID = "rbxassetid://136108770017536"
local CLICK_SOUND_ID = "rbxassetid://122835655736085"
local IDLE_SOUND_ID = "rbxassetid://136108770017536"

local BURST_IMAGE_ID = "rbxassetid://126185390548906"

local HOVER_SCALE = 1.055
local CLICK_SCALE = 0.90

local MAGNET_STRENGTH = 6
local MAGNET_SMOOTHNESS = 10
local SCALE_SMOOTHNESS = 13

local BURST_COUNT = 12
local BURST_MIN_DISTANCE = 45
local BURST_MAX_DISTANCE = 75
local BURST_TIME = 0.5

local Hovering = false
local Clicking = false
local Destroyed = false

local OriginalPosition = Button.Position

Button.ClipsDescendants = false

local Scale = Button:FindFirstChildOfClass("UIScale")

if not Scale then
	Scale = Instance.new("UIScale")
	Scale.Scale = 1
	Scale.Parent = Button
end

local function CreateSound(Name, ID, Volume, PlaybackSpeed)
	local Sound = Instance.new("Sound")
	Sound.Name = Name
	Sound.SoundId = ID
	Sound.Volume = Volume
	Sound.PlaybackSpeed = PlaybackSpeed or 1
	Sound.Parent = Button

	return Sound
end

local HoverSound = CreateSound(
	"HoverSound",
	HOVER_SOUND_ID,
	0.4,
	1
)

local ClickSound = CreateSound(
	"ClickSound",
	CLICK_SOUND_ID,
	0.55,
	1
)

local IdleSound = CreateSound(
	"IdleSound",
	IDLE_SOUND_ID,
	0.2,
	1
)

local BurstContainer = Instance.new("Frame")
BurstContainer.Name = "BurstContainer"
BurstContainer.AnchorPoint = Vector2.new(0.5, 0.5)
BurstContainer.Position = UDim2.fromScale(0.5, 0.5)
BurstContainer.Size = UDim2.fromScale(1, 1)
BurstContainer.BackgroundTransparency = 1
BurstContainer.BorderSizePixel = 0
BurstContainer.ClipsDescendants = false
BurstContainer.ZIndex = Button.ZIndex + 20
BurstContainer.Parent = Button

local TargetX = 0
local TargetY = 0

local CurrentX = 0
local CurrentY = 0

local TargetScale = 1
local CurrentScale = Scale.Scale

local function SmoothAlpha(Speed, DeltaTime)
	return 1 - math.exp(-Speed * DeltaTime)
end

local function PlaySound(Sound)
	if not Sound then
		return
	end

	if Sound.SoundId == "" then
		return
	end

	if Sound.SoundId == "rbxassetid://0" then
		return
	end

	Sound.TimePosition = 0
	Sound:Play()
end

local function CreateParticle(Index)
	if Destroyed then
		return
	end

	local Angle =
		((math.pi * 2) / BURST_COUNT) * Index
		+ math.rad(math.random(-14, 14))

	local Distance = math.random(
		BURST_MIN_DISTANCE,
		BURST_MAX_DISTANCE
	)

	local EndX = math.cos(Angle) * Distance
	local EndY = math.sin(Angle) * Distance

	local StartDistance = math.random(2, 7)

	local StartX = math.cos(Angle) * StartDistance
	local StartY = math.sin(Angle) * StartDistance

	local Particle = Instance.new("ImageLabel")
	Particle.Name = "BurstParticle"
	Particle.AnchorPoint = Vector2.new(0.5, 0.5)

	Particle.Position = UDim2.new(
		0.5,
		StartX,
		0.5,
		StartY
	)

	local ParticleSize = math.random(12, 21)

	Particle.Size = UDim2.fromOffset(
		ParticleSize,
		ParticleSize
	)

	Particle.BackgroundTransparency = 1
	Particle.BorderSizePixel = 0

	Particle.Image = BURST_IMAGE_ID
	Particle.ImageTransparency = 0

	Particle.Rotation = math.random(-180, 180)

	Particle.ZIndex = Button.ZIndex + 25
	Particle.Parent = BurstContainer

	local ParticleScale = Instance.new("UIScale")
	ParticleScale.Scale = 0
	ParticleScale.Parent = Particle

	local RandomScale =
		math.random(80, 125) / 100

	local RotationChange =
		math.random(-150, 150)

	local ScaleTween = TweenService:Create(
		ParticleScale,
		TweenInfo.new(
			0.16,
			Enum.EasingStyle.Back,
			Enum.EasingDirection.Out
		),
		{
			Scale = RandomScale
		}
	)

	local MoveTween = TweenService:Create(
		Particle,
		TweenInfo.new(
			BURST_TIME,
			Enum.EasingStyle.Quart,
			Enum.EasingDirection.Out
		),
		{
			Position = UDim2.new(
				0.5,
				EndX,
				0.5,
				EndY
			),

			Rotation =
				Particle.Rotation
				+ RotationChange
		}
	)

	ScaleTween:Play()
	MoveTween:Play()

	task.delay(BURST_TIME * 0.32, function()
		if not Particle.Parent then
			return
		end

		local FadeTween = TweenService:Create(
			Particle,
			TweenInfo.new(
				BURST_TIME * 0.68,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.In
			),
			{
				ImageTransparency = 1
			}
		)

		local ShrinkTween = TweenService:Create(
			ParticleScale,
			TweenInfo.new(
				BURST_TIME * 0.68,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.In
			),
			{
				Scale = 0.15
			}
		)

		FadeTween:Play()
		ShrinkTween:Play()
	end)

	task.delay(BURST_TIME + 0.1, function()
		if Particle then
			Particle:Destroy()
		end
	end)
end

local function Burst()
	for Index = 1, BURST_COUNT do
		CreateParticle(Index)
	end
end

local function ClickBounce()
	if Clicking then
		return
	end

	Clicking = true

	PlaySound(ClickSound)
	Burst()

	TargetScale = CLICK_SCALE

	task.delay(0.065, function()
		if Destroyed then
			return
		end

		if Hovering then
			TargetScale = 1.09
		else
			TargetScale = 1.045
		end
	end)

	task.delay(0.15, function()
		if Destroyed then
			return
		end

		if Hovering then
			TargetScale = 1.04
		else
			TargetScale = 0.985
		end
	end)

	task.delay(0.24, function()
		if Destroyed then
			return
		end

		if Hovering then
			TargetScale = HOVER_SCALE
		else
			TargetScale = 1
		end
	end)

	task.delay(0.34, function()
		Clicking = false
	end)
end

Button.MouseEnter:Connect(function()
	Hovering = true

	PlaySound(HoverSound)

	if not Clicking then
		TargetScale = HOVER_SCALE
	end
end)

Button.MouseLeave:Connect(function()
	Hovering = false

	TargetX = 0
	TargetY = 0

	if not Clicking then
		TargetScale = 1
	end
end)

Button.Activated:Connect(function()
	ClickBounce()
end)

Button.AncestryChanged:Connect(function()
	if not Button:IsDescendantOf(game) then
		Destroyed = true
	end
end)

RunService.RenderStepped:Connect(function(DeltaTime)
	if Destroyed then
		return
	end

	if not Button.Parent then
		return
	end

	if Hovering then
		local MousePosition = UserInputService:GetMouseLocation()

		local AbsolutePosition = Button.AbsolutePosition
		local AbsoluteSize = Button.AbsoluteSize

		local CenterX =
			AbsolutePosition.X
			+ (AbsoluteSize.X / 2)

		local CenterY =
			AbsolutePosition.Y
			+ (AbsoluteSize.Y / 2)

		local DifferenceX =
			MousePosition.X
		- CenterX

		local DifferenceY =
			MousePosition.Y
		- CenterY

		local NormalX = math.clamp(
			DifferenceX / math.max(
				AbsoluteSize.X / 2,
				1
			),
			-1,
			1
		)

		local NormalY = math.clamp(
			DifferenceY / math.max(
				AbsoluteSize.Y / 2,
				1
			),
			-1,
			1
		)

		TargetX =
			NormalX
			* MAGNET_STRENGTH

		TargetY =
			NormalY
			* MAGNET_STRENGTH
	end

	local PositionAlpha =
		SmoothAlpha(
			MAGNET_SMOOTHNESS,
			DeltaTime
		)

	CurrentX =
		CurrentX
		+ ((TargetX - CurrentX)
			* PositionAlpha)

	CurrentY =
		CurrentY
		+ ((TargetY - CurrentY)
			* PositionAlpha)

	Button.Position = UDim2.new(
		OriginalPosition.X.Scale,

		OriginalPosition.X.Offset
			+ CurrentX,

		OriginalPosition.Y.Scale,

		OriginalPosition.Y.Offset
			+ CurrentY
	)

	local ScaleAlpha =
		SmoothAlpha(
			SCALE_SMOOTHNESS,
			DeltaTime
		)

	CurrentScale =
		CurrentScale
		+ ((TargetScale - CurrentScale)
			* ScaleAlpha)

	Scale.Scale = CurrentScale
end)

task.spawn(function()
	while Button.Parent and not Destroyed do
		task.wait(
			math.random(60, 100) / 10
		)

		if
			not Hovering
			and not Clicking
			and not Destroyed
		then
			PlaySound(IdleSound)

			TargetScale = 1.018

			task.wait(0.13)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then
				TargetScale = 0.995
			end

			task.wait(0.12)

			if
				not Hovering
				and not Clicking
				and not Destroyed
			then
				TargetScale = 1
			end
		end
	end
end)]]></ProtectedString>
