					<Properties>
						<ProtectedString name="Source">-- PillowGameServer: বালিশ খেলা (Pass the Pillow) — server logic only.
-- Everything it needs lives inside this model, so the model can be duplicated freely.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local remote = ReplicatedStorage:WaitForChild("PassThePillowRemote") :: RemoteEvent
local model = script.Parent
local settingsFolder = model:WaitForChild("Settings")

-- Values in the Settings folder can be changed from the Properties panel.
local function setting(name: string, default: any): any
	local value = settingsFolder:FindFirstChild(name)
	if value and value:IsA("ValueBase") then
		return (value :: any).Value
	end
	return default
end

local button = model.Buttons.Button
local clickDetector = button.ClickDetector
local clickSound = button.Sound
local passSound = button.ChoosingSound
local stopSound = button.PickedSound
local errorSound = button.ErrorSound
local winSound = button.WinSound
local buttonParticle = button.ParticleEmitter
local board = button.Board :: BillboardGui
local statusLabel = board.Status :: TextLabel
local infoLabel = board.Info :: TextLabel
local boxArea = model.BoxArea :: BasePart
boxArea.Transparency = 1 -- faintly visible in Studio only, so it is easy to resize
local songsFolder = model.Songs

-- The pillow template is kept out of the world so nobody can pick it up.
local pillowTemplate = model.PillowTool :: Tool
pillowTemplate.Parent = nil

local COLOR_WHITE = Color3.fromRGB(255, 255, 255)
local COLOR_COUNT = Color3.fromRGB(255, 214, 90)
local COLOR_MUSIC = Color3.fromRGB(120, 220, 255)
local COLOR_STOP = Color3.fromRGB(255, 140, 90)
local COLOR_ERROR = Color3.fromRGB(255, 80, 80)
local COLOR_GOOD = Color3.fromRGB(90, 255, 140)
local COLOR_WIN = Color3.fromRGB(255, 205, 60)

local FLY_TIME = 0.25
local MIN_HOLD_BEFORE_TAP = 0.15
local MIN_TAP_GAP = 0.08

local BN_DIGITS = { "০", "১", "২", "৩", "৪", "৫", "৬", "৭", "৮", "৯" }
local function bn(n: number): string
	return (string.gsub(tostring(math.floor(n)), "%d", function(d)
		return BN_DIGITS[tonumber(d) + 1]
	end))
end

local function setBoard(status: string, info: string?, color: Color3?)
	statusLabel.Text = status
	statusLabel.TextColor3 = color or COLOR_WHITE
	infoLabel.Text = info or ""
end

local function showIdle()
	setBoard("চেয়ারে বসো!", "কেউ বসলেই খেলা শুরুর কাউন্টডাউন চালু হবে")
end

type Chair = {
	index: number,
	part: BasePart,
	seat: Seat,
	effect: ParticleEmitter?,
	defaultMaterial: Enum.Material,
	order: number,
}

-- chair1, chair2 ... are numbered clockwise, which is also the passing order.
local chairs: { Chair } = {}
for _, child in model:GetChildren() do
	local order = tonumber(string.match(child.Name, "^chair(%d+)$"))
	local seat = child:FindFirstChildOfClass("Seat")
	if order and seat and child:IsA("BasePart") then
		local attachment = child:FindFirstChild("Attachment")
		table.insert(chairs, {
			index = 0,
			part = child,
			seat = seat,
			effect = attachment and attachment:FindFirstChild("pickedeffect") :: ParticleEmitter?,
			defaultMaterial = child.Material,
			order = order,
		})
	end
end
table.sort(chairs, function(a, b)
	return a.order &lt; b.order
end)
for i, chair in chairs do
	chair.index = i
end

type State = "Idle" | "Countdown" | "Playing" | "WaitNext" | "Ending"
local state: State = "Idle"
local gameId = 0 -- bumped whenever a game ends; stale loops and delays check it
local aliveByChair: { [number]: Player } = {}
local chairOf: { [Player]: number } = {}
local aliveCount = 0
local holder: Player? = nil
local holdToken = 0 -- bumped on every hand-over; stale taps and auto-passes check it
local holdStart = 0
local lastTap = 0
local taps = 0
local musicPlaying = false
local pillow: Tool? = nil
local currentSong: Sound? = nil
local walls: Folder? = nil

local function getSeatedPlayer(chair: Chair): Player?
	local humanoid = chair.seat.Occupant
	if humanoid and humanoid.Health &gt; 0 then
		return Players:GetPlayerFromCharacter(humanoid.Parent)
	end
	return nil
end

local function getSeatedList(): { { chair: Chair, player: Player } }
	local result = {}
	for _, chair in chairs do
		local player = getSeatedPlayer(chair)
		if player then
			table.insert(result, { chair = chair, player = player })
		end
	end
	return result
end

local function resetChairs()
	for _, chair in chairs do
		chair.part.Material = chair.defaultMaterial
		if chair.effect then
			chair.effect.Enabled = false
		end
	end
end

local function flashChair(index: number?)
	local chair = index and chairs[index]
	if not chair then
		return
	end
	chair.part.Material = Enum.Material.Neon
	local effect = chair.effect
	if effect then
		effect.Enabled = true
		task.delay(2, function()
			effect.Enabled = false
		end)
	end
end

local function pressButtonVisuals()
	clickSound:Play()
	buttonParticle.Enabled = true
	button.Transparency = 1
	task.delay(0.2, function()
		button.Transparency = 0
		buttonParticle.Enabled = false
	end)
end

-- Box ---------------------------------------------------------------------------------------

local function isInsideBox(position: Vector3): boolean
	local offset = boxArea.CFrame:PointToObjectSpace(position)
	local half = boxArea.Size / 2
	return math.abs(offset.X) &lt;= half.X and math.abs(offset.Z) &lt;= half.Z and offset.Y &gt;= -half.Y - 2 and offset.Y &lt;= half.Y + 4
end

-- A random spot just outside the box, facing the table.
local function getExitCFrame(): CFrame
	local half = boxArea.Size / 2
	local angle = math.random() * math.pi * 2
	local dx, dz = math.cos(angle), math.sin(angle)
	local edge = math.min(half.X / math.max(math.abs(dx), 0.001), half.Z / math.max(math.abs(dz), 0.001))
	local height = -half.Y + 3.5
	local position = boxArea.CFrame:PointToWorldSpace(Vector3.new(dx * (edge + 5), height, dz * (edge + 5)))
	local center = boxArea.CFrame:PointToWorldSpace(Vector3.new(0, height, 0))
	return CFrame.lookAt(position, center)
end

local function removeWalls()
	if walls then
		walls:Destroy()
		walls = nil
	end
end

-- Invisible walls and roof around the chairs, built from BoxArea's size.
local function buildWalls()
	removeWalls()
	local folder = Instance.new("Folder")
	folder.Name = "ActiveWalls"
	local size = boxArea.Size
	local thickness = 1
	local function wall(name: string, offset: Vector3, wallSize: Vector3)
		local part = Instance.new("Part")
		part.Name = name
		part.Anchored = true
		part.CanCollide = true
		part.CanTouch = false
		part.CanQuery = false -- keeps clicks and the camera passing straight through
		part.CastShadow = false
		part.Transparency = 1
		part.Size = wallSize
		part.CFrame = boxArea.CFrame * CFrame.new(offset)
		part.Parent = folder
	end
	wall("North", Vector3.new(0, 0, -size.Z / 2), Vector3.new(size.X + thickness, size.Y, thickness))
	wall("South", Vector3.new(0, 0, size.Z / 2), Vector3.new(size.X + thickness, size.Y, thickness))
	wall("East", Vector3.new(size.X / 2, 0, 0), Vector3.new(thickness, size.Y, size.Z + thickness))
	wall("West", Vector3.new(-size.X / 2, 0, 0), Vector3.new(thickness, size.Y, size.Z + thickness))
	wall("Roof", Vector3.new(0, size.Y / 2, 0), Vector3.new(size.X + thickness, thickness, size.Z + thickness))
	folder.Parent = model
	walls = folder
end

local function teleportOut(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (character and humanoid and humanoid.Health &gt; 0) then
		return
	end
	humanoid.Sit = false
	for _, chair in chairs do
		if chair.seat.Occupant == humanoid then
			local weld = chair.seat:FindFirstChild("SeatWeld")
			if weld then
				weld:Destroy()
			end
		end
	end
	task.defer(function()
		if character.Parent then
			character:PivotTo(getExitCFrame())
		end
	end)
end

-- After a respawn, put the player back next to the box instead of the far-away spawn.
local function watchRespawn(player: Player)
	player.CharacterAdded:Once(function(character)
		if not character:WaitForChild("HumanoidRootPart", 10) then
			return
		end
		if not character.Parent then
			character.AncestryChanged:Wait()
		end
		task.wait(0.2)
		if character.Parent then
			character:PivotTo(getExitCFrame())
		end
	end)
end

-- Pillow ------------------------------------------------------------------------------------

local function destroyPillow()
	local tool = pillow
	pillow = nil
	if tool then
		tool:Destroy()
	end
end

local function makePillow(): Tool
	local tool = pillowTemplate:Clone()
	tool.CanBeDropped = false
	for _, descendant in tool:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.Anchored = false
			descendant.CanCollide = false
			descendant.Massless = true
		end
	end
	-- Unequipping (or any other move) puts it straight back in the holder's hand.
	tool.AncestryChanged:Connect(function(_, parent)
		if pillow ~= tool or parent == nil then
			return
		end
		local current = holder
		local character = current and current.Character
		if not character or parent == character then
			return
		end
		task.defer(function()
			if pillow ~= tool or holder ~= current or tool.Parent == nil or tool.Parent == character or not character.Parent then
				return
			end
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid and humanoid.Health &gt; 0 then
				humanoid:UnequipTools()
				tool.Parent = character
			end
		end)
	end)
	return tool
end

local function equipPillow(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not (character and humanoid and humanoid.Health &gt; 0) then
		return
	end
	local tool = pillow or makePillow()
	pillow = tool
	humanoid:UnequipTools()
	-- The old pillow is gone if it was inside a character that got removed.
	if not pcall(function()
		tool.Parent = character
	end) then
		tool = makePillow()
		pillow = tool
		tool.Parent = character
	end
end

-- A quick flying copy of the pillow between two players.
local function flyPillow(from: Player, to: Player)
	local handle = pillow and pillow:FindFirstChild("Handle")
	local fromRoot = from.Character and from.Character:FindFirstChild("HumanoidRootPart")
	local toRoot = to.Character and to.Character:FindFirstChild("HumanoidRootPart")
	if not (handle and handle:IsA("BasePart") and fromRoot and toRoot) then
		return
	end
	local ghost = handle:Clone()
	for _, descendant in ghost:GetDescendants() do
		if descendant:IsA("JointInstance") or descendant:IsA("WeldConstraint") or descendant:IsA("TouchTransmitter") then
			descendant:Destroy()
		end
	end
	ghost.Anchored = true
	ghost.CanCollide = false
	ghost.CanTouch = false
	ghost.CanQuery = false
	ghost.CFrame = (fromRoot :: BasePart).CFrame * CFrame.new(0, 1, -1.5)
	ghost.Parent = model
	TweenService:Create(ghost, TweenInfo.new(FLY_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		CFrame = (toRoot :: BasePart).CFrame * CFrame.new(0, 1, -1.5),
	}):Play()
	Debris:AddItem(ghost, FLY_TIME + 0.05)
end

-- Clockwise from the given chair, the next chair with a living player.
local function nextAlive(fromIndex: number): Player?
	local count = #chairs
	for step = 1, count do
		local player = aliveByChair[(fromIndex - 1 + step) % count + 1]
		if player then
			return player
		end
	end
	return nil
end

local passPillow: () -&gt; ()

local function setHolder(player: Player, from: Player?)
	holder = player
	holdToken += 1
	local token = holdToken
	taps = 0
	holdStart = os.clock()

	resetChairs()
	local index = chairOf[player]
	if index then
		chairs[index].part.Material = Enum.Material.Neon
	end
	setBoard("🎵 গান বাজছে...", "🛏️ " .. player.DisplayName .. "-এর হাতে বালিশ!", COLOR_MUSIC)

	local tool = pillow
	if from and tool then
		flyPillow(from, player)
		pcall(function()
			tool.Parent = nil -- hidden while the copy is flying
		end)
		task.delay(FLY_TIME, function()
			if token == holdToken and holder == player then
				equipPillow(player)
			end
		end)
	else
		equipPillow(player)
	end

	local autoPass = setting("AutoPassTime", 8)
	remote:FireClient(player, "Hold", model, token, autoPass)
	-- Nobody can keep the pillow: it moves on by itself.
	task.delay(autoPass, function()
		if token == holdToken and holder == player and musicPlaying then
			passPillow()
		end
	end)
end

passPillow = function()
	local from = holder
	if not from or not musicPlaying then
		return
	end
	local index = chairOf[from]
	local target = index and nextAlive(index)
	if not target or target == from then
		return
	end
	if from.Parent then
		remote:FireClient(from, "Release", model)
	end
	passSound:Play()
	setHolder(target, from)
end

-- Music -------------------------------------------------------------------------------------

local function stopMusic()
	local song = currentSong
	currentSong = nil
	if song then
		song:Stop()
		song:Destroy()
	end
end

-- Plays a random song from the Songs folder, starting somewhere in the middle.
local function startMusic(id: number, duration: number)
	stopMusic()
	local list = {}
	for _, child in songsFolder:GetChildren() do
		if child:IsA("Sound") then
			table.insert(list, child)
		end
	end
	if #list == 0 then
		warn("[PassThePillow] Songs ফোল্ডারে কোনো Sound নেই, গান ছাড়াই খেলা চলবে।")
		return
	end
	local song = (list[math.random(#list)] :: Sound):Clone()
	song.Looped = true
	song.RollOffMinDistance = 15
	song.RollOffMaxDistance = 140
	song.Parent = button
	local waitStart = os.clock()
	while not song.IsLoaded and os.clock() - waitStart &lt; 3 do
		task.wait(0.1)
	end
	if id ~= gameId then
		song:Destroy()
		return
	end
	local skip = setting("SongSkipMin", 30)
	local latestStart = song.TimeLength - duration - 3
	local start = 0
	if latestStart &gt; skip then
		start = skip + math.random() * (latestStart - skip)
	elseif latestStart &gt; 0 then
		start = math.random() * latestStart
	end
	song.TimePosition = start
	song:Play()
	currentSong = song
end

-- Players -----------------------------------------------------------------------------------

local function eliminate(player: Player, killed: boolean)
	local index = chairOf[player]
	if not index or aliveByChair[index] ~= player then
		return
	end
	aliveByChair[index] = nil
	aliveCount -= 1

	if player.Parent then
		remote:FireClient(player, "Release", model)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if killed or not (humanoid and humanoid.Health &gt; 0) then
			watchRespawn(player)
		end
		if killed then
			if humanoid then
				humanoid.Health = 0
			end
		else
			teleportOut(player)
		end
	end

	if holder == player then
		local target = nextAlive(index)
		if musicPlaying and target then
			setHolder(target) -- straight into the next player's hands
		else
			holder = nil
			holdToken += 1
		end
	end
end

local function giveWinEffect(player: Player)
	local folder = ServerStorage:FindFirstChild(setting("EffectFolderName", "PillowWinEffects"))
	local effect = folder and folder:FindFirstChild(setting("EffectAttachmentName", "WinEffect"))
	if not effect then
		warn("[PassThePillow] বিজয়ীর ইফেক্ট পাওয়া যায়নি। ServerStorage-এ ফোল্ডার আর অ্যাটাচমেন্টের নাম Settings-এর সাথে মিলিয়ে দেখো।")
		return
	end
	local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return
	end
	local clone = effect:Clone()
	clone.Parent = rootPart
	Debris:AddItem(clone, setting("EffectDuration", 10))
end

-- Game flow ---------------------------------------------------------------------------------

local startCountdown: () -&gt; ()

local function finishGame(id: number)
	if id ~= gameId or state == "Ending" or state == "Idle" then
		return
	end
	state = "Ending"
	gameId += 1
	local myId = gameId
	musicPlaying = false
	stopMusic()
	if holder and holder.Parent then
		remote:FireClient(holder, "Release", model)
	end
	holder = nil
	holdToken += 1
	destroyPillow()
	resetChairs()

	local winner: Player? = nil
	for _, player in aliveByChair do
		winner = player
	end
	if winner and winner.Parent then
		if winSound.SoundId ~= "" then
			winSound:Play()
		end
		setBoard("🏆 " .. winner.DisplayName .. " বিজয়ী!", "অভিনন্দন! 🎉", COLOR_WIN)
		flashChair(chairOf[winner])
		giveWinEffect(winner)
	else
		errorSound:Play()
		setBoard("খেলা বাতিল", "সবাই খেলা ছেড়ে চলে গেছে", COLOR_ERROR)
	end

	task.wait(6)
	if myId ~= gameId then
		return
	end
	removeWalls()
	table.clear(aliveByChair)
	table.clear(chairOf)
	aliveCount = 0
	resetChairs()
	state = "Idle"
	showIdle()
	if #getSeatedList() &gt; 0 then
		startCountdown()
	end
end

local function checkForWinner()
	if (state == "Playing" or state == "WaitNext") and aliveCount &lt;= 1 then
		task.spawn(finishGame, gameId)
	end
end

local function runRound(id: number)
	if id ~= gameId then
		return
	end
	state = "Playing"
	resetChairs()
	local minTime = setting("MinSongTime", 10)
	local maxTime = math.max(setting("MaxSongTime", 25), minTime)
	local duration = minTime + math.random() * (maxTime - minTime) -- secret: nobody knows when it stops
	setBoard("🎵 গান শুরু হচ্ছে...", bn(aliveCount) .. " জন খেলছে", COLOR_MUSIC)
	startMusic(id, duration)
	if id ~= gameId then
		return
	end

	local starters = {}
	for _, player in aliveByChair do
		table.insert(starters, player)
	end
	if #starters == 0 then
		return
	end
	musicPlaying = true
	setHolder(starters[math.random(#starters)])

	local endTime = os.clock() + duration
	while os.clock() &lt; endTime do
		task.wait(0.1)
		if id ~= gameId then
			return
		end
	end

	-- The music stops suddenly: whoever holds the pillow is out.
	musicPlaying = false
	holdToken += 1
	stopMusic()
	stopSound:Play()
	local loser = holder
	holder = nil
	if loser then
		if loser.Parent then
			remote:FireClient(loser, "Release", model)
		end
		local loserIndex = chairOf[loser]
		resetChairs()
		flashChair(loserIndex)
		setBoard("🛑 গান থেমে গেছে!", "বালিশ " .. loser.DisplayName .. "-এর হাতে!", COLOR_STOP)
		task.wait(2)
		if id ~= gameId then
			return
		end
		destroyPillow()
		if loserIndex and aliveByChair[loserIndex] == loser then
			eliminate(loser, true)
			setBoard("💀 " .. loser.DisplayName .. " আউট!", "বাকি আছে " .. bn(aliveCount) .. " জন", COLOR_ERROR)
		end
	end
	destroyPillow()
	resetChairs()

	task.wait(2)
	if id ~= gameId then
		return
	end
	if aliveCount &lt;= 1 then
		finishGame(id)
		return
	end
	state = "WaitNext"
	setBoard("👆 বাটন চাপো!", "পরের রাউন্ড শুরু করতে যেকোনো খেলোয়াড় বাটন চাপো • বাকি " .. bn(aliveCount) .. " জন", COLOR_COUNT)
end

local function startGame(id: number, seated: { { chair: Chair, player: Player } })
	table.clear(aliveByChair)
	table.clear(chairOf)
	aliveCount = 0
	for _, entry in seated do
		aliveByChair[entry.chair.index] = entry.player
		chairOf[entry.player] = entry.chair.index
		aliveCount += 1
	end
	state = "Playing"
	buildWalls()
	-- Anyone standing inside the box when it closes is moved outside.
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		if not chairOf[player] and rootPart and isInsideBox((rootPart :: BasePart).Position) then
			teleportOut(player)
		end
	end
	setBoard("🎉 খেলা শুরু!", bn(aliveCount) .. " জন খেলোয়াড়", COLOR_GOOD)
	task.wait(2)
	if id ~= gameId then
		return
	end
	if aliveCount &lt;= 1 then
		checkForWinner()
		return
	end
	runRound(id)
end

startCountdown = function()
	if state ~= "Idle" then
		return
	end
	state = "Countdown"
	gameId += 1
	local id = gameId
	task.spawn(function()
		for remaining = setting("CountdownTime", 20), 1, -1 do
			if id ~= gameId then
				return
			end
			local count = #getSeatedList()
			if count == 0 then
				state = "Idle"
				showIdle()
				return
			end
			setBoard("⏳ খেলা শুরু হচ্ছে " .. bn(remaining), bn(count) .. " জন বসেছে • বাকিরা দ্রুত বসো!", COLOR_COUNT)
			task.wait(1)
		end
		if id ~= gameId then
			return
		end
		local seated = getSeatedList()
		if #seated &lt; setting("MinPlayers", 2) then
			errorSound:Play()
			setBoard("কমপক্ষে " .. bn(setting("MinPlayers", 2)) .. " জন লাগবে!", "আরেকজন বসলেই আবার কাউন্টডাউন শুরু হবে", COLOR_ERROR)
			state = "Idle"
			return
		end
		startGame(id, seated)
	end)
end

-- Events ------------------------------------------------------------------------------------

for _, chair in chairs do
	local sitAnim = chair.seat:FindFirstChild("sitanim")
	local track: AnimationTrack? = nil
	chair.seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		-- Sit animation: one track per seat, removed when the player stands up.
		if track then
			track:Stop()
			track:Destroy()
			track = nil
		end
		local humanoid = chair.seat.Occupant
		local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
		if animator and sitAnim and sitAnim:IsA("Animation") then
			track = animator:LoadAnimation(sitAnim)
			track.Priority = Enum.AnimationPriority.Action
			track:Play()
		end

		local seated = getSeatedPlayer(chair)
		if state == "Idle" then
			if seated then
				startCountdown()
			end
			return
		end
		if state ~= "Playing" and state ~= "WaitNext" then
			return
		end
		-- Standing up during a game means you are out.
		local participant = aliveByChair[chair.index]
		if participant and seated ~= participant then
			eliminate(participant, false)
			if not musicPlaying then
				infoLabel.Text = "🚪 " .. participant.DisplayName .. " উঠে গেছে, বাদ!"
			end
			checkForWinner()
		end
		-- Nobody new may join a running game.
		if seated and aliveByChair[chair.index] ~= seated then
			teleportOut(seated)
		end
	end)
end

remote.OnServerEvent:Connect(function(player: Player, action: unknown, targetModel: unknown, token: unknown)
	if targetModel ~= model or action ~= "Tap" then
		return
	end
	if player ~= holder or not musicPlaying or token ~= holdToken then
		return
	end
	local now = os.clock()
	if now - holdStart &lt; MIN_HOLD_BEFORE_TAP or now - lastTap &lt; MIN_TAP_GAP then
		return
	end
	lastTap = now
	taps += 1
	remote:FireClient(player, "Tapped", model, holdToken, taps)
	if taps &gt;= 2 then
		passPillow()
	end
end)

clickDetector.MouseClick:Connect(function(player: Player)
	if state ~= "WaitNext" then
		return
	end
	-- Only players still in the game (and sitting) can start the next round.
	local index = chairOf[player]
	if not index or aliveByChair[index] ~= player or getSeatedPlayer(chairs[index]) ~= player then
		errorSound:Play()
		return
	end
	state = "Playing"
	pressButtonVisuals()
	task.spawn(runRound, gameId)
end)

Players.PlayerRemoving:Connect(function(player)
	if chairOf[player] then
		eliminate(player, false)
		checkForWinner()
	end
end)

board.Enabled = true
showIdle()
