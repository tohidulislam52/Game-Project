				<Item class="LocalScript" referent="RBXF8DFF53430DC48389E754F644E22C6BE">
					<Properties>
						<ProtectedString name="Source">-- PassThePillowClient: shows the jumping "pass" button to whoever holds the pillow. Creates no instances.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local remote = ReplicatedStorage:WaitForChild("PassThePillowRemote") :: RemoteEvent
local gui = script.Parent
local root = gui:WaitForChild("Root") :: Frame
local holderFrame = root:WaitForChild("PassHolder") :: Frame
local popScale = holderFrame:WaitForChild("PopScale") :: UIScale
local passButton = holderFrame:WaitForChild("PassButton") :: TextButton
local stroke = passButton:WaitForChild("UIStroke") :: UIStroke
local label = passButton:WaitForChild("Label") :: TextLabel
local badge = passButton:WaitForChild("Countdown") :: TextLabel
local dots = passButton:WaitForChild("Dots")
local dot1 = dots:WaitForChild("Dot1") :: Frame
local dot2 = dots:WaitForChild("Dot2") :: Frame

-- Where the button may jump to: away from the screen edges, the bottom UI and the exact centre.
local MIN_X, MAX_X = 0.3, 0.7
local MIN_Y, MAX_Y = 0.25, 0.6
local CENTER_GAP = 0.07
local MIN_JUMP = 0.2

local DOT_ON = Color3.fromRGB(255, 226, 92)
local DOT_OFF = Color3.fromRGB(255, 255, 255)

local BN_DIGITS = { "০", "১", "২", "৩", "৪", "৫", "৬", "৭", "৮", "৯" }
local function bn(n: number): string
	return (string.gsub(tostring(math.floor(n)), "%d", function(d)
		return BN_DIGITS[tonumber(d) + 1]
	end))
end

local activeModel: Instance? = nil
local activeToken: number? = nil
local waiting = false
local session = 0
local lastPosition: Vector2? = nil
local pulseTween: Tween? = nil

-- Slightly smaller on phones, slightly bigger on large screens.
local function baseScale(): number
	local camera = Workspace.CurrentCamera
	local height = if camera then camera.ViewportSize.Y else 720
	return math.clamp(height / 720, 0.8, 1.15)
end

local function randomPosition(): UDim2
	local chosen = Vector2.new(0.4, 0.35)
	for _ = 1, 30 do
		local candidate = Vector2.new(MIN_X + math.random() * (MAX_X - MIN_X), MIN_Y + math.random() * (MAX_Y - MIN_Y))
		local nearCenter = math.abs(candidate.X - 0.5) &lt; CENTER_GAP and math.abs(candidate.Y - 0.45) &lt; CENTER_GAP
		local farEnough = lastPosition == nil or (candidate - lastPosition).Magnitude &gt;= MIN_JUMP
		if not nearCenter and farEnough then
			chosen = candidate
			break
		end
	end
	lastPosition = chosen
	return UDim2.fromScale(chosen.X, chosen.Y)
end

local function setDots(count: number)
	dot1.BackgroundColor3 = if count &gt;= 1 then DOT_ON else DOT_OFF
	dot1.BackgroundTransparency = if count &gt;= 1 then 0 else 0.55
	dot2.BackgroundColor3 = if count &gt;= 2 then DOT_ON else DOT_OFF
	dot2.BackgroundTransparency = if count &gt;= 2 then 0 else 0.55
end

local function popIn()
	popScale.Scale = 0
	TweenService:Create(popScale, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = baseScale() }):Play()
end

local function startPulse()
	if pulseTween then
		pulseTween:Cancel()
	end
	stroke.Thickness = 3
	pulseTween = TweenService:Create(stroke, TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Thickness = 6 })
	pulseTween:Play()
end

local function hide()
	session += 1
	local mySession = session
	activeModel = nil
	activeToken = nil
	waiting = false
	passButton.Interactable = false
	if pulseTween then
		pulseTween:Cancel()
		pulseTween = nil
	end
	local tween = TweenService:Create(popScale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0 })
	tween.Completed:Once(function()
		if mySession == session then
			root.Visible = false
		end
	end)
	tween:Play()
end

local function show(model: Instance, token: number, autoTime: number)
	session += 1
	local mySession = session
	activeModel = model
	activeToken = token
	waiting = false
	setDots(0)
	label.Text = "পাস করো!"
	badge.Visible = false
	passButton.Interactable = true
	holderFrame.Position = randomPosition()
	root.Visible = true
	popIn()
	startPulse()

	-- Last seconds: 3, 2, 1 before the pillow moves on by itself.
	task.spawn(function()
		local warnFrom = math.min(3, math.floor(autoTime))
		task.wait(autoTime - warnFrom)
		for n = warnFrom, 1, -1 do
			if mySession ~= session then
				return
			end
			badge.Text = bn(n)
			badge.Visible = true
			task.wait(1)
		end
	end)
end

passButton.Activated:Connect(function()
	if not activeModel or waiting then
		return
	end
	waiting = true
	passButton.Interactable = false
	local mySession = session
	TweenService:Create(popScale, TweenInfo.new(0.07), { Scale = baseScale() * 0.85 }):Play()
	remote:FireServer("Tap", activeModel, activeToken)
	-- No answer from the server: let the player try again.
	task.delay(0.8, function()
		if mySession == session and waiting then
			waiting = false
			passButton.Interactable = true
			popScale.Scale = baseScale()
		end
	end)
end)

remote.OnClientEvent:Connect(function(action: string, model: Instance, token: number?, value: number?)
	if action == "Hold" then
		show(model, token :: number, value or 8)
		return
	end
	if model ~= activeModel then
		return
	end
	if action == "Tapped" and token == activeToken then
		waiting = false
		local count = value or 1
		setDots(count)
		if count &lt; 2 then
			label.Text = "আরেকবার!"
			holderFrame.Position = randomPosition()
			passButton.Interactable = true
			popIn()
		else
			label.Text = "পাস! ✅"
		end
	elseif action == "Release" then
		hide()
	end
end)

root.Visible = false
