		<Item class="Script" referent="RBX6C1B22363BA446248EEFBC7F1165E77D">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Model = script.Parent
local SeatsFolder = Model:WaitForChild("Seats")
local FrontSeat = SeatsFolder:WaitForChild("FrontSeat")
local BackSeats = {}
for i = 1, 6 do BackSeats[i] = SeatsFolder:WaitForChild("BackSeat" .. i) end
local SeatOrder = {FrontSeat}
for _, s in ipairs(BackSeats) do table.insert(SeatOrder, s) end
local MAX_PLAYERS = #SeatOrder
local JoinPart = Model:WaitForChild("JoinPart")
local Prompt = JoinPart:WaitForChild("ProximityPrompt")
local GuiTemplate = Model:WaitForChild("GameUI")

local MAX_DAMAGE, MIN_DAMAGE = 50, 1
local HIT_TIMEOUT, GUESS_TIMEOUT, INTERMISSION = 10, 15, 4
local SLAP_ANIMATION_ID = "rbxassetid://82475490964359"

local SlapAnim = Instance.new("Animation")
SlapAnim.AnimationId = SLAP_ANIMATION_ID

local Remote = ReplicatedStorage:FindFirstChild("SlapGameEvent")
if not Remote then
	Remote = Instance.new("RemoteEvent")
	Remote.Name = "SlapGameEvent"
	Remote.Parent = ReplicatedStorage
end

local occupant, seatOf, busy, conns, uis = {}, {}, {}, {}, {}
local roundActive, roundId = false, 0
local pending = {}

local function getHumanoid(plr)
	local char = plr.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health > 0 then return char, hum end
end

local function playerCount()
	local n = 0
	for _ in pairs(seatOf) do n += 1 end
	return n
end

local function backPlayers()
	local list = {}
	for _, s in ipairs(BackSeats) do
		if occupant[s] then table.insert(list, occupant[s]) end
	end
	return list
end

local function broadcast(action, data)
	for plr in pairs(seatOf) do Remote:FireClient(plr, action, data) end
end

local function updatePrompt()
	local n = playerCount()
	Prompt.ObjectText = ("Players: %d/%d"):format(n, MAX_PLAYERS)
	Prompt.Enabled = n < MAX_PLAYERS
end

local function applyCamera(plr)
	if seatOf[plr] == FrontSeat then
		Remote:FireClient(plr, "LockCamera", FrontSeat.CFrame)
	else
		Remote:FireClient(plr, "UnlockCamera")
	end
end

local function unseat(hum)
	local sp = hum.SeatPart
	if sp then
		local w = sp:FindFirstChild("SeatWeld")
		if w then w:Destroy() end
	end
	hum.Sit = false
end

local function seatPlayer(plr, seat)
	local char, hum = getHumanoid(plr)
	if not hum then return false end
	busy[plr] = true
	unseat(hum)
	for _ = 1, 6 do
		if hum.SeatPart == seat then break end
		char:PivotTo(seat.CFrame * CFrame.new(0, 2.5, 0))
		seat:Sit(hum)
		task.wait(0.15)
	end
	local ok = hum.SeatPart == seat
	task.delay(0.25, function() busy[plr] = nil end)
	return ok
end

local function leaveGame(plr)
	local seat = seatOf[plr]
	if not seat then return end
	seatOf[plr] = nil
	if occupant[seat] == plr then occupant[seat] = nil end
	busy[plr] = nil
	if conns[plr] then
		for _, c in ipairs(conns[plr]) do c:Disconnect() end
		conns[plr] = nil
	end
	if roundActive then roundId += 1 end
	if plr.Parent then Remote:FireClient(plr, "UnlockCamera") end
	local ui = uis[plr]
	uis[plr] = nil
	if ui then task.delay(0.5, function() ui:Destroy() end) end
	local char, hum = getHumanoid(plr)
	if hum then
		unseat(hum)
		task.defer(function()
			if char.Parent then char:PivotTo(JoinPart.CFrame * CFrame.new(0, 1, 7)) end
		end)
	end
	updatePrompt()
	broadcast("Status", ("%s left. Players: %d/%d"):format(plr.DisplayName, playerCount(), MAX_PLAYERS))
	broadcast("Hide")
end

local function moveToSeat(plr, seat)
	local oldSeat = seatOf[plr]
	if oldSeat and occupant[oldSeat] == plr then occupant[oldSeat] = nil end
	occupant[seat] = plr
	seatOf[plr] = seat
	if not seatPlayer(plr, seat) then leaveGame(plr) return false end
	applyCamera(plr)
	return true
end

local function promoteToFront()
	local plr = backPlayers()[1]
	if not plr then return end
	if moveToSeat(plr, FrontSeat) then
		broadcast("Status", plr.DisplayName .. " moved to the FRONT seat!")
	end
end

local function swapPlayers(a, b)
	local seatA, seatB = seatOf[a], seatOf[b]
	local _, humA = getHumanoid(a)
	local _, humB = getHumanoid(b)
	if not (seatA and seatB and humA and humB) then return end
	busy[a], busy[b] = true, true
	unseat(humA)
	unseat(humB)
	seatOf[a], seatOf[b] = seatB, seatA
	occupant[seatA], occupant[seatB] = b, a
	task.wait(0.1)
	local okA = seatPlayer(a, seatB)
	local okB = seatPlayer(b, seatA)
	if okA then applyCamera(a) else leaveGame(a) end
	if okB then applyCamera(b) else leaveGame(b) end
end

local function playSlap(plr)
	local _, hum = getHumanoid(plr)
	if not hum then return end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end
	local ok, track = pcall(function() return animator:LoadAnimation(SlapAnim) end)
	if ok and track then
		track.Priority = Enum.AnimationPriority.Action4
		track:Play(0.05, 1, 1.3)
		task.delay(2, function() track:Stop(0.2) track:Destroy() end)
	end
end

-- Fake death: a slap can never kill the front player
local function applyDamage(plr, dmg)
	local _, hum = getHumanoid(plr)
	if not hum then return false, 0 end
	if hum.Health - dmg <= 0 then
		hum.Health = hum.MaxHealth
		local strikes = (plr:GetAttribute("SlapStrikes") or 0) + 1
		plr:SetAttribute("SlapStrikes", strikes)
		return true, strikes
	end
	hum.Health -= dmg
	return false, 0
end

local function awaitResponse(phase, plr, timeout, myId)
	pending = {phase = phase, player = plr, value = nil, sent = os.clock()}
	local start = os.clock()
	while pending.value == nil and roundId == myId and os.clock() - start < timeout do
		task.wait(0.1)
	end
	local v = pending.value
	pending = {}
	return v
end

local function runRound()
	roundActive = true
	roundId += 1
	local myId = roundId
	local front = occupant[FrontSeat]
	local backs = backPlayers()
	if not front or #backs < 1 then return end

	broadcast("Status", "Round starting... someone is about to SLAP " .. front.DisplayName .. "!")
	task.wait(2)
	if roundId ~= myId then return end

	local attacker = backs[math.random(#backs)]
	for _, p in ipairs(backs) do
		if p ~= attacker then Remote:FireClient(p, "Status", "Stay quiet... someone else is slapping!") end
	end
	Remote:FireClient(front, "Status", "Brace yourself... don't look back!")
	Remote:FireClient(attacker, "Status", "YOU are the slapper! Time your hit!")
	Remote:FireClient(attacker, "ShowHit")

	local damage = awaitResponse("Hit", attacker, HIT_TIMEOUT, myId)
	if roundId ~= myId then return end
	Remote:FireClient(attacker, "Hide")
	if damage == nil then damage = math.random(10, 25) end

	playSlap(attacker)
	task.wait(0.3)
	if roundId ~= myId then return end

	local knockedOut, strikes = applyDamage(front, damage)
	Remote:FireClient(front, "Slapped", damage)
	if knockedOut then
		broadcast("Status", ("KNOCKED OUT! %s takes strike #%d (health restored). Who did it?"):format(front.DisplayName, strikes))
	else
		broadcast("Status", ("SLAP! (%d dmg) %s, who did it?"):format(damage, front.DisplayName))
	end

	local names = {}
	for _, p in ipairs(backs) do table.insert(names, p.Name) end
	Remote:FireClient(front, "ShowGuess", names)

	local guess = awaitResponse("Guess", front, GUESS_TIMEOUT, myId)
	if roundId ~= myId then return end
	Remote:FireClient(front, "Hide")

	if guess == attacker.Name then
		broadcast("Status", ("CORRECT! %s caught %s. Swapping seats!"):format(front.DisplayName, attacker.DisplayName))
		swapPlayers(front, attacker)
	else
		broadcast("Status", ("WRONG! It was %s. %s stays in the front seat!"):format(attacker.DisplayName, front.DisplayName))
	end
	task.wait(INTERMISSION)
end

Remote.OnServerEvent:Connect(function(plr, action, value)
	if pending.player ~= plr or pending.value ~= nil or pending.phase ~= action then return end
	if action == "Hit" then
		if typeof(value) ~= "number" or value ~= value or math.abs(value) == math.huge then return end
		if os.clock() - pending.sent < 0.1 then return end
		pending.value = math.clamp(math.floor(value), MIN_DAMAGE, MAX_DAMAGE)
	elseif action == "Guess" then
		if typeof(value) ~= "string" or #value > 50 then return end
		pending.value = value
	end
end)

Prompt.Triggered:Connect(function(plr)
	if seatOf[plr] then return end
	local _, hum = getHumanoid(plr)
	if not hum then return end
	local seat
	for _, s in ipairs(SeatOrder) do
		if not occupant[s] then seat = s break end
	end
	if not seat then return end

	occupant[seat] = plr
	seatOf[plr] = seat
	local ui = GuiTemplate:Clone()
	ui.Parent = plr:WaitForChild("PlayerGui")
	uis[plr] = ui
	conns[plr] = {
		hum.Died:Connect(function() leaveGame(plr) end),
		hum.Seated:Connect(function(active)
			if not active and not busy[plr] and seatOf[plr] then leaveGame(plr) end
		end),
		plr.CharacterRemoving:Connect(function() leaveGame(plr) end),
	}
	updatePrompt()
	if not seatPlayer(plr, seat) then leaveGame(plr) return end
	task.wait(0.2)
	applyCamera(plr)

	broadcast("Status", ("%s joined! (%d/%d) - need 2 to start"):format(plr.DisplayName, playerCount(), MAX_PLAYERS))
	local role = seat == FrontSeat and "FRONT seat - guess who slaps you!" or "BACK seat - wait to slap!"
	Remote:FireClient(plr, "Status", "You're in the " .. role .. " (Jump to leave)")
end)

Players.PlayerRemoving:Connect(leaveGame)
updatePrompt()

task.spawn(function()
	while true do
		task.wait(1)
		if not roundActive then
			if not occupant[FrontSeat] then promoteToFront() end
			if occupant[FrontSeat] and #backPlayers() >= 1 then
				local ok, err = pcall(runRound)
				if not ok then warn("[SlapGame] " .. tostring(err)) end
				roundActive = false
				pending = {}
			end
		end
	end
end)
]]></ProtectedString>
