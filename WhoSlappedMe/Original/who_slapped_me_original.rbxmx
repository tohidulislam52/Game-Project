			<Item class="LocalScript" referent="RBXFCD280DC8C184867BD6549AB3CC242EF">
				<Properties>
					<ProtectedString name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local Remote = ReplicatedStorage:WaitForChild("SlapGameEvent")
local gui = script.Parent
local HitFrame = gui:WaitForChild("HitFrame")
local PowerBar = HitFrame:WaitForChild("BarBack"):WaitForChild("PowerBar")
local PowerText = HitFrame:WaitForChild("PowerText")
local HitButton = HitFrame:WaitForChild("HitButton")
local GuessFrame = gui:WaitForChild("GuessFrame")
local Holder = GuessFrame:WaitForChild("ButtonHolder")
local Template = GuessFrame:WaitForChild("ButtonTemplate")
local Status = gui:WaitForChild("StatusLabel")
local Flash = gui:WaitForChild("Flash")

local MAX_DAMAGE = 50
local LOCK_NAME = "SlapCamLock" .. tostring(math.random(1, 1e6))
local hitOpen, guessOpen = false, false
local powerTween, stepConn
local locked = false
local shakeOffset = CFrame.identity

local function popIn(frame)
	local s = frame:FindFirstChild("PopScale")
	frame.Visible = true
	s.Scale = 0.5
	TweenService:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
end

local function popOut(frame)
	if not frame.Visible then return end
	local s = frame:FindFirstChild("PopScale")
	local t = TweenService:Create(s, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0})
	t.Completed:Once(function(state)
		if state == Enum.PlaybackState.Completed then frame.Visible = false end
	end)
	t:Play()
end

local function addHover(btn)
	local hs = btn:FindFirstChild("HoverScale")
	local function to(v) TweenService:Create(hs, TweenInfo.new(0.12, Enum.EasingStyle.Quad), {Scale = v}):Play() end
	btn.MouseEnter:Connect(function() to(1.07) end)
	btn.MouseLeave:Connect(function() to(1) end)
	btn.MouseButton1Down:Connect(function() to(0.92) end)
	btn.MouseButton1Up:Connect(function() to(1) end)
end

local function lockCamera(seatCF)
	local camCF = seatCF * CFrame.new(0, 3.2, -1.3)
	locked = true
	RunService:UnbindFromRenderStep(LOCK_NAME)
	RunService:BindToRenderStep(LOCK_NAME, Enum.RenderPriority.Camera.Value + 1, function()
		local cam = workspace.CurrentCamera
		cam.CameraType = Enum.CameraType.Scriptable
		cam.CFrame = camCF * shakeOffset
	end)
end

local function unlockCamera()
	if not locked then return end
	locked = false
	RunService:UnbindFromRenderStep(LOCK_NAME)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	local char = Players.LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then cam.CameraSubject = hum end
end

local function stopPower()
	if powerTween then powerTween:Cancel() powerTween = nil end
	if stepConn then stepConn:Disconnect() stepConn = nil end
end

local function startPower()
	stopPower()
	PowerBar.Size = UDim2.fromScale(0, 1)
	powerTween = TweenService:Create(PowerBar, TweenInfo.new(0.85, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Size = UDim2.fromScale(1, 1)})
	powerTween:Play()
	stepConn = RunService.RenderStepped:Connect(function()
		PowerText.Text = math.floor(PowerBar.Size.X.Scale * 100) .. "%"
	end)
end

local function setStatus(text)
	Status.Text = text
	Status.Visible = text ~= ""
	local s = Status:FindFirstChild("PopScale")
	s.Scale = 0.85
	TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
end

local function slapEffect(power)
	Flash.BackgroundTransparency = 0.3
	TweenService:Create(Flash, TweenInfo.new(0.6, Enum.EasingStyle.Quad), {BackgroundTransparency = 1}):Play()
	local intensity = 1 + (power / MAX_DAMAGE) * 4
	for i = 1, 16 do
		local f = intensity * (1 - i / 16)
		local offset = CFrame.Angles(math.rad((math.random() - 0.5) * 2 * f), math.rad((math.random() - 0.5) * 2 * f), math.rad((math.random() - 0.5) * f))
		if locked then
			shakeOffset = offset
		else
			local cam = workspace.CurrentCamera
			cam.CFrame = cam.CFrame * offset
		end
		task.wait()
	end
	shakeOffset = CFrame.identity
end

local function buildGuess(names)
	for _, c in ipairs(Holder:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	for i, name in ipairs(names) do
		local b = Template:Clone()
		b.Name = name
		b.Text = name
		b.LayoutOrder = i
		b.Visible = true
		b.Parent = Holder
		addHover(b)
		b.Activated:Connect(function()
			if not guessOpen then return end
			guessOpen = false
			Remote:FireServer("Guess", b.Name)
			popOut(GuessFrame)
		end)
	end
end

addHover(HitButton)
HitButton.Activated:Connect(function()
	if not hitOpen then return end
	hitOpen = false
	local scale = math.clamp(PowerBar.Size.X.Scale, 0, 1)
	stopPower()
	local damage = math.floor(scale * MAX_DAMAGE + 0.5)
	PowerText.Text = damage .. " DMG!"
	Remote:FireServer("Hit", damage)
	task.delay(0.6, popOut, HitFrame)
end)

Remote.OnClientEvent:Connect(function(action, data)
	if action == "ShowHit" then
		popOut(GuessFrame)
		hitOpen = true
		popIn(HitFrame)
		startPower()
	elseif action == "ShowGuess" and typeof(data) == "table" then
		buildGuess(data)
		guessOpen = true
		popIn(GuessFrame)
	elseif action == "Slapped" then
		task.spawn(slapEffect, tonumber(data) or 10)
	elseif action == "Status" then
		setStatus(tostring(data))
	elseif action == "LockCamera" and typeof(data) == "CFrame" then
		lockCamera(data)
	elseif action == "UnlockCamera" then
		unlockCamera()
	elseif action == "Hide" then
		hitOpen, guessOpen = false, false
		stopPower()
		popOut(HitFrame)
		popOut(GuessFrame)
	end
end)

gui.Destroying:Connect(unlockCamera)
]]></ProtectedString>
