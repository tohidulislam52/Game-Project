		<Item class="LocalScript" referent="RBX0305E6BF78B943FA8F0520DEE460AD12">
			<Properties>
				<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

-- === CONFIG ===
local SPEED = 80
local ACCEL = 6
local TILT_ANGLE = 25
local DOUBLE_CLICK_TIME = 0.4

local ANIM_IDLE = "rbxassetid://118703314621593"
local ANIM_FLY = "rbxassetid://118703314621593"

local fly = false
local lastClick = 0
local currentVel = Vector3.zero
local bodyVel, bodyGyro, conn, diedConn
local idleTrack, flyTrack

-- Character yang sedang dipakai terbang (selalu diambil ulang, jangan disimpan dari awal)
local flyChar, flyHRP, flyHumanoid

local idleAnim = Instance.new("Animation")
idleAnim.AnimationId = ANIM_IDLE
local flyAnim = Instance.new("Animation")
flyAnim.AnimationId = ANIM_FLY

-- Remote dibuat oleh server. Jangan bikin dari client (client tidak bisa
-- membuat RemoteEvent yang sampai ke server, malah menutupi remote asli).
local remote
local function getRemote()
	if remote and remote.Parent then return remote end
	remote = ReplicatedStorage:FindFirstChild("FlyTrailRemote")
	return remote
end
task.spawn(function()
	remote = ReplicatedStorage:WaitForChild("FlyTrailRemote", 10)
end)

local function fireTrail(char, state)
	local r = getRemote()
	if r and r:IsA("RemoteEvent") then
		r:FireServer(char, state)
	end
end

-- Ambil character, HRP & humanoid yang SEKARANG (bukan yang lama sebelum respawn)
local function getCurrentCharacter()
	local char = tool.Parent
	if not (char and char:IsA("Model") and Players:GetPlayerFromCharacter(char) == player) then
		char = player.Character
	end
	if not char or not char.Parent then return nil end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then return nil end
	return char, hrp, hum
end

local function loadTrack(anim)
	if not flyHumanoid then return nil end
	local animator = flyHumanoid:FindFirstChildOfClass("Animator")
	local ok, track = pcall(function()
		if animator then
			return animator:LoadAnimation(anim)
		end
		return flyHumanoid:LoadAnimation(anim)
	end)
	if ok then return track end
	return nil
end

local function playIdle()
	if flyTrack then flyTrack:Stop() flyTrack = nil end
	if not idleTrack then idleTrack = loadTrack(idleAnim) end
	if idleTrack and not idleTrack.IsPlaying then idleTrack:Play() end
end

local function playFly()
	if idleTrack then idleTrack:Stop() idleTrack = nil end
	if not flyTrack then flyTrack = loadTrack(flyAnim) end
	if flyTrack and not flyTrack.IsPlaying then flyTrack:Play() end
end

local function stopAllAnim()
	if idleTrack then idleTrack:Stop() idleTrack = nil end
	if flyTrack then flyTrack:Stop() flyTrack = nil end
end

-- === STOP FLY (aman dipanggil kapan saja, termasuk saat mati) ===
local function stopFly()
	if conn then conn:Disconnect() conn = nil end
	if diedConn then diedConn:Disconnect() diedConn = nil end
	if bodyVel then bodyVel:Destroy() bodyVel = nil end
	if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
	currentVel = Vector3.zero
	stopAllAnim()

	if fly then
		fly = false
		if flyHumanoid and flyHumanoid.Parent then
			flyHumanoid.PlatformStand = false
		end
		if flyChar then
			fireTrail(flyChar, false) -- matiin trail
		end
	end

	flyChar, flyHRP, flyHumanoid = nil, nil, nil
end

-- === START FLY ===
local function startFly()
	local char, hrp, hum = getCurrentCharacter()
	if not char then return end

	-- bersihin sisa sesi sebelumnya (kalau ada)
	stopFly()

	flyChar, flyHRP, flyHumanoid = char, hrp, hum
	fly = true
	fireTrail(char, true) -- hidupin trail di server

	bodyVel = Instance.new("BodyVelocity")
	bodyVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	bodyVel.Velocity = Vector3.zero
	bodyVel.P = 5e3
	bodyVel.Parent = hrp

	bodyGyro = Instance.new("BodyGyro")
	bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	bodyGyro.P = 5e3
	bodyGyro.CFrame = hrp.CFrame
	bodyGyro.Parent = hrp

	hum.PlatformStand = true
	playIdle()

	-- kalau mati waktu terbang, matiin semua biar bisa dipakai lagi setelah respawn
	diedConn = hum.Died:Connect(stopFly)

	conn = RS.RenderStepped:Connect(function(dt)
		if not fly then return end
		if not (flyHRP and flyHRP.Parent and flyHumanoid and flyHumanoid.Parent) then
			stopFly()
			return
		end

		local cam = workspace.CurrentCamera
		if not cam then return end

		local inputVel = Vector3.zero

		if UIS.TouchEnabled then
			-- arah horizontal ikut MoveDirection
			local moveDir = flyHumanoid.MoveDirection
			inputVel = moveDir * SPEED

			-- naik/turun lebih smooth dengan threshold lebih kecil
			local lookY = cam.CFrame.LookVector.Y
			local threshold = 0.15  -- lebih kecil = gampang trigger naik/turun
			local multiplier = 1.2   -- boost biar lebih responsif

			if moveDir.Magnitude > 0.05 then
				if lookY > threshold then
					-- dongak = terbang naik
					inputVel += Vector3.new(0, SPEED * (lookY - threshold) * multiplier, 0)
				elseif lookY < -threshold then
					-- nunduk = terbang turun
					inputVel += Vector3.new(0, SPEED * (lookY + threshold) * multiplier, 0)
				end
			end
		else
			if UIS:IsKeyDown(Enum.KeyCode.W) then inputVel += cam.CFrame.LookVector * SPEED end
			if UIS:IsKeyDown(Enum.KeyCode.S) then inputVel -= cam.CFrame.LookVector * SPEED end
			if UIS:IsKeyDown(Enum.KeyCode.A) then inputVel -= cam.CFrame.RightVector * SPEED end
			if UIS:IsKeyDown(Enum.KeyCode.D) then inputVel += cam.CFrame.RightVector * SPEED end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then inputVel += Vector3.new(0, SPEED, 0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then inputVel -= Vector3.new(0, SPEED, 0) end
		end

		-- Smooth XZ movement
		local targetVelXZ = Vector3.new(inputVel.X, 0, inputVel.Z)
		local currentVelXZ = Vector3.new(currentVel.X, 0, currentVel.Z):Lerp(targetVelXZ, math.min(ACCEL * dt, 1))

		currentVel = Vector3.new(currentVelXZ.X, inputVel.Y, currentVelXZ.Z)
		bodyVel.Velocity = currentVel

		-- Animasi
		if targetVelXZ.Magnitude > 0 or math.abs(inputVel.Y) > 0.1 then
			playFly()
		else
			playIdle()
		end

		-- Rotasi tubuh mengikuti kamera saat gerak
		if Vector3.new(currentVel.X, 0, currentVel.Z).Magnitude > 1 then
			local camLook = cam.CFrame.LookVector
			local flatLook = Vector3.new(camLook.X, 0, camLook.Z)
			if flatLook.Magnitude > 0.01 then
				local baseCFrame = CFrame.lookAt(flyHRP.Position, flyHRP.Position + flatLook)
				bodyGyro.CFrame = baseCFrame * CFrame.Angles(math.rad(-TILT_ANGLE), 0, 0)
			end
		else
			bodyGyro.CFrame = flyHRP.CFrame
		end
	end)
end

-- === FLY TOGGLE ===
local function toggleFly()
	if fly then
		stopFly()
	else
		startFly()
	end
end

-- === DOUBLE CLICK TOOL ===
tool.Activated:Connect(function()
	local now = os.clock()
	if now - lastClick <= DOUBLE_CLICK_TIME then
		lastClick = 0 -- reset biar klik ke-3 tidak dihitung double click lagi
		toggleFly()
	else
		lastClick = now
	end
end)

tool.Equipped:Connect(function()
	lastClick = 0
end)

tool.Unequipped:Connect(function()
	lastClick = 0
	if fly then stopFly() end
end)

-- Kalau player respawn dan script ini masih hidup, reset semua state
player.CharacterAdded:Connect(function()
	lastClick = 0
	stopFly()
end)

tool.AncestryChanged:Connect(function()
	if not tool:IsDescendantOf(game) then
		stopFly()
	end
end)
]]></ProtectedString>
