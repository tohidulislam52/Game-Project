					<Properties>
						<ProtectedString name="Source"><![CDATA[-- StarterGui > HuntEventGui > HuntUIController (LocalScript)
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local SoundService = game:GetService("SoundService")

local player = Players.LocalPlayer
local gui = script.Parent

-- UI উপাদান
local toggleBtn = gui:WaitForChild("AdminToggleBtn")
local adminPanel = gui:WaitForChild("AdminPanel")
local resultCard = gui:WaitForChild("ResultCard")
local resultText = resultCard:WaitForChild("ResultText")

local totalBoxInput = adminPanel:WaitForChild("TotalBoxInput")
local luckyCountInput = adminPanel:WaitForChild("LuckyCountInput")
local scrollFrame = adminPanel:WaitForChild("ToolScrollFrame")
local selectedVal = adminPanel:WaitForChild("SelectedToolValue")
local startBtn = adminPanel:WaitForChild("StartBtn")
local statusMsg = adminPanel:WaitForChild("StatusMsg")

-- রিমোট রেফারেন্স
local HuntRemotes = ReplicatedStorage:WaitForChild("HuntRemotes")
local StartHuntEvent = HuntRemotes:WaitForChild("StartHuntEvent")
local OpenBoxEvent = HuntRemotes:WaitForChild("OpenBoxEvent")

local BroadcastEvent = HuntRemotes:FindFirstChild("BroadcastEvent")
if not BroadcastEvent then
	BroadcastEvent = Instance.new("RemoteEvent")
	BroadcastEvent.Name = "BroadcastEvent"
	BroadcastEvent.Parent = HuntRemotes
end

----------------------------------------------------------------------
-- 🔊 সাউন্ড প্লেয়ার ফাংশন (HuntRemotes থেকে সরাসরি সাউন্ড বাজাবে)
----------------------------------------------------------------------
local function playSmartSound(soundName)
	task.spawn(function()
		local targetSound = HuntRemotes:FindFirstChild(soundName)
		if targetSound and targetSound:IsA("Sound") then
			local snd = targetSound:Clone()
			snd.Parent = SoundService
			snd:Play()
			snd.Ended:Connect(function()
				snd:Destroy()
			end)
		end
	end)
end

----------------------------------------------------------------------
-- 👑 অ্যাডমিন পারমিশন
----------------------------------------------------------------------
local ADMIN_USERNAMES = {
	["rojin00110"] = true,
	["AdminFriend1"] = true,
}

local function checkAdmin()
	if RunService:IsStudio() then return true end
	if ADMIN_USERNAMES[player.Name] then return true end
	if player.UserId == game.CreatorId or game.CreatorId <= 0 then return true end
	return false
end

if not checkAdmin() then
	toggleBtn.Visible = false
	adminPanel.Visible = false
else
	toggleBtn.Visible = true
end

-- ক্লোজ বাটন
local closeBtn = adminPanel:FindFirstChild("CloseBtn")
if not closeBtn then
	closeBtn = Instance.new("TextButton")
	closeBtn.Name = "CloseBtn"
	closeBtn.Size = UDim2.new(0, 28, 0, 28)
	closeBtn.Position = UDim2.new(1, -36, 0, 10)
	closeBtn.BackgroundColor3 = Color3.fromRGB(40, 42, 55)
	closeBtn.Text = "x"
	closeBtn.TextColor3 = Color3.fromRGB(200, 205, 220)
	closeBtn.Font = Enum.Font.GothamBold
	closeBtn.TextSize = 14
	closeBtn.Parent = adminPanel
	Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(1, 0)
end

local function closePanel()
	adminPanel.Visible = false
end

closeBtn.MouseButton1Click:Connect(closePanel)

-- প্যানেলের বাইরে ক্লিক করলে বন্ধ হবে
UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if adminPanel.Visible then
			local mousePos = input.Position
			local panelPos = adminPanel.AbsolutePosition
			local panelSize = adminPanel.AbsoluteSize

			local insidePanel = mousePos.X >= panelPos.X and mousePos.X <= (panelPos.X + panelSize.X)
				and mousePos.Y >= panelPos.Y and mousePos.Y <= (panelPos.Y + panelSize.Y)

			local btnPos = toggleBtn.AbsolutePosition
			local btnSize = toggleBtn.AbsoluteSize
			local insideBtn = mousePos.X >= btnPos.X and mousePos.X <= (btnPos.X + btnSize.X)
				and mousePos.Y >= btnPos.Y and mousePos.Y <= (btnPos.Y + btnSize.Y)

			if not insidePanel and not insideBtn then
				closePanel()
			end
		end
	end
end)

-- টুলস তালিকা লোড
local toolButtons = {}
local function populateTools(toolsList)
	for _, child in ipairs(scrollFrame:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	table.clear(toolButtons)

	for _, toolName in ipairs(toolsList) do
		local btn = Instance.new("TextButton")
		btn.Name = toolName
		btn.Size = UDim2.new(1, -12, 0, 32)
		btn.BackgroundColor3 = Color3.fromRGB(30, 33, 46)
		btn.Text = "  " .. toolName
		btn.TextColor3 = Color3.fromRGB(220, 225, 245)
		btn.Font = Enum.Font.GothamMedium
		btn.TextSize = 13
		btn.TextXAlignment = Enum.TextXAlignment.Left
		btn.Parent = scrollFrame

		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

		local stroke = Instance.new("UIStroke", btn)
		stroke.Thickness = 1
		stroke.Color = Color3.fromRGB(50, 55, 75)

		btn.MouseButton1Click:Connect(function()
			selectedVal.Value = toolName
			statusMsg.TextColor3 = Color3.fromRGB(255, 215, 0)
			statusMsg.Text = "সিলেক্টেড: " .. toolName

			for _, b in ipairs(toolButtons) do
				b.BackgroundColor3 = Color3.fromRGB(30, 33, 46)
				b.TextColor3 = Color3.fromRGB(220, 225, 245)
				local bStroke = b:FindFirstChildOfClass("UIStroke")
				if bStroke then bStroke.Color = Color3.fromRGB(50, 55, 75) end
			end

			btn.BackgroundColor3 = Color3.fromRGB(255, 175, 20)
			btn.TextColor3 = Color3.fromRGB(15, 15, 20)
			stroke.Color = Color3.fromRGB(255, 255, 255)
		end)

		table.insert(toolButtons, btn)
	end
end

task.spawn(function()
	local response = StartHuntEvent:InvokeServer("GET_TOOLS")
	if response and response.Success and response.Tools then
		populateTools(response.Tools)
	end
end)

toggleBtn.MouseButton1Click:Connect(function()
	adminPanel.Visible = not adminPanel.Visible
	local shrink = TweenService:Create(toggleBtn, TweenInfo.new(0.1), {Size = UDim2.new(0, 46, 0, 46)})
	local expand = TweenService:Create(toggleBtn, TweenInfo.new(0.1), {Size = UDim2.new(0, 52, 0, 52)})
	shrink:Play()
	shrink.Completed:Wait()
	expand:Play()
end)

-- স্টার্ট ইভেন্ট বাটন
local isStarting = false
startBtn.MouseButton1Click:Connect(function()
	if isStarting then return end

	local totalBoxes = tonumber(totalBoxInput.Text)
	local luckyBoxes = tonumber(luckyCountInput.Text)
	local chosenTool = selectedVal.Value

	if not totalBoxes or totalBoxes <= 0 then
		statusMsg.TextColor3 = Color3.fromRGB(255, 90, 90)
		statusMsg.Text = "বক্সের সঠিক সংখ্যা লিখুন!"
		return
	end

	if not luckyBoxes or luckyBoxes <= 0 or luckyBoxes > totalBoxes then
		statusMsg.TextColor3 = Color3.fromRGB(255, 90, 90)
		statusMsg.Text = "লাকি বক্সের সংখ্যা ভুল হয়েছে!"
		return
	end

	if chosenTool == "" then
		statusMsg.TextColor3 = Color3.fromRGB(255, 90, 90)
		statusMsg.Text = "তালিকা থেকে একটি টুল বেছে নিন!"
		return
	end

	isStarting = true
	startBtn.Text = "DROP IN PROGRESS..."
	startBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 85)
	statusMsg.TextColor3 = Color3.fromRGB(220, 220, 100)
	statusMsg.Text = "আপনার আশেপাশে ড্রপ হচ্ছে..."

	local response = StartHuntEvent:InvokeServer(totalBoxes, luckyBoxes, chosenTool)

	if response and response.Success then
		statusMsg.TextColor3 = Color3.fromRGB(80, 255, 140)
		statusMsg.Text = response.Message
	else
		statusMsg.TextColor3 = Color3.fromRGB(255, 90, 90)
		statusMsg.Text = (response and response.Message) or "ইভেন্ট শুরু করতে ব্যর্থ!"
	end

	task.wait(2)
	startBtn.Text = "START EVENT"
	startBtn.BackgroundColor3 = Color3.fromRGB(35, 130, 90)
	isStarting = false
end)

----------------------------------------------------------------------
-- 📢 ১. ব্রডকাস্ট ব্যানার অ্যানিমেশন ও ইভেন্ট স্টার্ট সাউন্ড
----------------------------------------------------------------------
local eventAlertCard = Instance.new("Frame")
eventAlertCard.Name = "EventAlertCard"
eventAlertCard.Size = UDim2.new(0, 500, 0, 75)
eventAlertCard.Position = UDim2.new(0.5, -250, -0.25, 0)
eventAlertCard.BackgroundColor3 = Color3.fromRGB(15, 18, 25)
eventAlertCard.BackgroundTransparency = 0.05
eventAlertCard.Visible = false
eventAlertCard.Parent = gui

Instance.new("UICorner", eventAlertCard).CornerRadius = UDim.new(0, 16)
local alertStroke = Instance.new("UIStroke", eventAlertCard)
alertStroke.Thickness = 2
alertStroke.Color = Color3.fromRGB(255, 215, 0)

local alertLabel = Instance.new("TextLabel")
alertLabel.Size = UDim2.new(1, -20, 1, 0)
alertLabel.Position = UDim2.new(0, 10, 0, 0)
alertLabel.BackgroundTransparency = 1
alertLabel.Text = "🎁 TREASURE HUNT EVENT STARTED! 🎁\nম্যাপে গিফট বক্স ছড়িয়ে দেওয়া হয়েছে! দ্রুত সংগ্রহ করুন!"
alertLabel.TextColor3 = Color3.fromRGB(255, 245, 220)
alertLabel.Font = Enum.Font.GothamBold
alertLabel.TextSize = 14
alertLabel.TextWrapped = true
alertLabel.Parent = eventAlertCard

BroadcastEvent.OnClientEvent:Connect(function(msg)
	if msg then alertLabel.Text = msg end
	eventAlertCard.Visible = true

	-- ইভেন্ট স্টার্ট সাউন্ড বাজবে
	playSmartSound("EventStartSound")

	local slideDown = TweenService:Create(eventAlertCard, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, -250, 0.05, 0)
	})
	slideDown:Play()

	task.wait(6)

	local slideUp = TweenService:Create(eventAlertCard, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Position = UDim2.new(0.5, -250, -0.25, 0)
	})
	slideUp:Play()
	slideUp.Completed:Wait()
	eventAlertCard.Visible = false
end)

----------------------------------------------------------------------
-- ✨ ২. বক্স ওপেন অ্যানিমেশন, রেজাল্ট ও উইন সাউন্ডস
----------------------------------------------------------------------
OpenBoxEvent.OnClientEvent:Connect(function(rewardType, message)
	-- বক্স খোলার সময় প্রথমে আনবক্স সাউন্ড বাজবে
	playSmartSound("UnboxSound")

	task.wait(0.3) -- হালকা বিরতির পর রেজাল্ট সাউন্ড বাজবে

	resultText.Text = message
	resultCard.Visible = true

	local stroke = resultCard:FindFirstChildOfClass("UIStroke")
	if rewardType == "Tool" then
		if stroke then stroke.Color = Color3.fromRGB(255, 215, 0) end
		playSmartSound("ToolWinSound") -- লাকি টুল উইন সাউন্ড
	else
		if stroke then stroke.Color = Color3.fromRGB(0, 255, 160) end
		playSmartSound("CoinSound") -- কয়েন পাওয়ার সাউন্ড
	end

	task.wait(5)
	resultCard.Visible = false
end)]]></ProtectedString>
