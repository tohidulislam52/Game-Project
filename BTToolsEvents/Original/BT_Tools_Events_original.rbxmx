						<Item class="Script" referent="RBXF1EDBA1E66754FF884D04590CD9D885B">
							<Properties>
								<ProtectedString name="Source"><![CDATA[local seat = script.Parent
local sitAnimObject = seat:WaitForChild("sitanim") -- Seat এর ভিতরে থাকা Animation অবজেক্ট

local currentTrack = nil

-- সিটের অবস্থা (কে বসেছে বা উঠেছে) পরিবর্তন হলে এই ফাংশনটি চলবে
local function onOccupantChanged()
	local humanoid = seat.Occupant -- সিটে বসা প্লেয়ারের Humanoid

	if humanoid then
		-- যখন কোনো প্লেয়ার সিটে বসবে
		local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator")

		if animator and sitAnimObject then
			currentTrack = animator:LoadAnimation(sitAnimObject)
			currentTrack:Play()
		end
	else
		-- যখন প্লেয়ার সিট থেকে উঠে যাবে
		if currentTrack then
			currentTrack:Stop()
			currentTrack:Destroy()
			currentTrack = nil
		end
	end
end

-- সিটের Occupant প্রপার্টি চেঞ্জ হলেই ইভেন্ট ট্রিগার হবে
seat:GetPropertyChangedSignal("Occupant"):Connect(onOccupantChanged)]]></ProtectedString>
