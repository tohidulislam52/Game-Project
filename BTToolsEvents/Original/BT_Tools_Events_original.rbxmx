					<ProtectedString name="Source"><![CDATA[-- ServerScriptService > HuntServerManager (Script)
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local HuntRemotes = ReplicatedStorage:WaitForChild("HuntRemotes")
local StartHuntEvent = HuntRemotes:WaitForChild("StartHuntEvent")
local OpenBoxEvent = HuntRemotes:WaitForChild("OpenBoxEvent")

local BroadcastEvent = HuntRemotes:FindFirstChild("BroadcastEvent")
if not BroadcastEvent then
	BroadcastEvent = Instance.new("RemoteEvent")
	BroadcastEvent.Name = "BroadcastEvent"
	BroadcastEvent.Parent = HuntRemotes
end

local ToolsFolder = ServerStorage:WaitForChild("GiftBoxTools")
local MasterBoxTool = ServerStorage:WaitForChild("GiftBoxTool")

local EventStore = DataStoreService:GetDataStore("HangoutHunt_Perm_v3")

local activeSpawns = Workspace:FindFirstChild("ActiveEventSpawns")
if not activeSpawns then
	activeSpawns = Instance.new("Folder")
	activeSpawns.Name = "ActiveEventSpawns"
	activeSpawns.Parent = Workspace
end

----------------------------------------------------------------------
-- ⚙️ গেম কনফিগারেশন
----------------------------------------------------------------------
local CURRENCY_NAME = "Taka"
local SPAWN_RADIUS = 500
local MIN_DISTANCE_BETWEEN_BOXES = 25

local BOX_THEMES = {
	{BoxColor = Color3.fromRGB(130, 15, 25), RibbonColor = Color3.fromRGB(255, 215, 0), Material = Enum.Material.SmoothPlastic},
	{BoxColor = Color3.fromRGB(15, 30, 85), RibbonColor = Color3.fromRGB(240, 240, 255), Material = Enum.Material.SmoothPlastic},
	{BoxColor = Color3.fromRGB(12, 65, 35), RibbonColor = Color3.fromRGB(255, 215, 0), Material = Enum.Material.SmoothPlastic},
	{BoxColor = Color3.fromRGB(60, 15, 85), RibbonColor = Color3.fromRGB(255, 180, 220), Material = Enum.Material.SmoothPlastic},
	{BoxColor = Color3.fromRGB(20, 22, 28), RibbonColor = Color3.fromRGB(255, 215, 0), Material = Enum.Material.SmoothPlastic},
	{BoxColor = Color3.fromRGB(150, 45, 15), RibbonColor = Color3.fromRGB(255, 245, 200), Material = Enum.Material.SmoothPlastic},
}

-- 👑 অ্যাডমিন লিস্ট (স্টুডিও ও টিম টেস্ট ১০০% গ্রান্টেড)
local ADMIN_USERNAMES = {
	["rojin00110"] = true,
	["Tajim_294"] = true,
}

local function checkAdmin(player)
	-- স্টুডিও বা টিম টেস্টে সবসময় পারমিশন থাকবে
	if RunService:IsStudio() then return true end
	if ADMIN_USERNAMES[player.Name] then return true end
	if string.sub(player.Name, 1, 6) == "Player" then return true end -- টেস্ট সার্ভার প্লেয়ার
	if player.UserId == game.CreatorId or game.CreatorId <= 0 then return true end
	return false
end

----------------------------------------------------------------------
-- ১. Raycasting
----------------------------------------------------------------------
local function getGroundPosition(x, z, startY)
	local rayOrigin = Vector3.new(x, startY + 300, z)
	local rayDirection = Vector3.new(0, -800, 0)

	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = {activeSpawns}
	raycastParams.IgnoreWater = false
	pcall(function()
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	end)

	local hit = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
	if hit and hit.Position then
		if hit.Material == Enum.Material.Water or string.find(string.lower(hit.Instance.Name), "water") then
			return nil
		end
		if hit.Normal.Y < 0.45 then
			return nil
		end
		return hit.Position + Vector3.new(0, 2.0, 0)
	end
	return nil
end

----------------------------------------------------------------------
-- ২. হালকা ভাসমান ও ঘূর্ণন
----------------------------------------------------------------------
local function startIdleMotion(groundModel, baseCFrame)
	task.spawn(function()
		local startTime = os.clock()
		local spinSpeed = 35
		local bobAmplitude = 0.4
		local bobFrequency = 2

		while groundModel and groundModel.Parent do
			local elapsed = os.clock() - startTime
			local bobOffset = math.sin(elapsed * bobFrequency) * bobAmplitude
			local currentRotation = math.rad((elapsed * spinSpeed) % 360)

			local targetCFrame = baseCFrame * CFrame.new(0, bobOffset, 0) * CFrame.Angles(0, currentRotation, 0)

			if groundModel:IsA("Model") then
				groundModel:PivotTo(targetCFrame)
			elseif groundModel:IsA("BasePart") then
				groundModel.CFrame = targetCFrame
			end

			task.wait(0.03)
		end
	end)
end

----------------------------------------------------------------------
-- ৩. মৃদু পালস ইফেক্ট
----------------------------------------------------------------------
local function startGlowLoop(itemInstance, highlight, pointLight)
	task.spawn(function()
		while itemInstance and itemInstance.Parent do
			task.wait(5)
			if not itemInstance or not itemInstance.Parent then break end

			local growTween = TweenService:Create(highlight, TweenInfo.new(0.6, Enum.EasingStyle.Sine), {
				OutlineTransparency = 0,
				FillTransparency = 0.7
			})
			local lightGrow = TweenService:Create(pointLight, TweenInfo.new(0.6), {
				Brightness = 5,
				Range = 30
			})

			growTween:Play()
			lightGrow:Play()
			growTween.Completed:Wait()

			local shrinkTween = TweenService:Create(highlight, TweenInfo.new(1.2, Enum.EasingStyle.Sine), {
				OutlineTransparency = 0.7,
				FillTransparency = 1
			})
			local lightShrink = TweenService:Create(pointLight, TweenInfo.new(1.2), {
				Brightness = 1,
				Range = 12
			})

			shrinkTween:Play()
			lightShrink:Play()
		end
	end)
end

----------------------------------------------------------------------
-- ৪. বক্স কালার সেট
----------------------------------------------------------------------
local function applyBoxTheme(targetContainer, theme)
	for _, part in ipairs(targetContainer:GetDescendants()) do
		if part:IsA("BasePart") then
			if part.Name == "Handle" then
				part.Color = theme.BoxColor
				part.Material = theme.Material
			elseif string.find(string.lower(part.Name), "ribbon") or string.find(string.lower(part.Name), "bow") then
				part.Color = theme.RibbonColor
				part.Material = Enum.Material.SmoothPlastic
			end
		end
	end
	if targetContainer:IsA("BasePart") and targetContainer.Name == "Handle" then
		targetContainer.Color = theme.BoxColor
		targetContainer.Material = theme.Material
	end
end

----------------------------------------------------------------------
-- ৫. মাটিতে বক্স স্পন
----------------------------------------------------------------------
local function spawnPickupBox(position, isSpecial, chosenToolName)
	local theme = BOX_THEMES[math.random(1, #BOX_THEMES)]

	local groundModel = Instance.new("Model")
	groundModel.Name = "GroundGiftBox"

	local handlePart = MasterBoxTool:FindFirstChild("Handle")
	local ribbonPart = MasterBoxTool:FindFirstChild("Ribbon")

	local clonedHandle, clonedRibbon

	if handlePart then
		clonedHandle = handlePart:Clone()
		clonedHandle.Parent = groundModel
	else
		clonedHandle = Instance.new("Part")
		clonedHandle.Name = "Handle"
		clonedHandle.Size = Vector3.new(2.5, 2.5, 2.5)
		clonedHandle.Parent = groundModel
	end

	if ribbonPart then
		clonedRibbon = ribbonPart:Clone()
		clonedRibbon.Parent = groundModel

		local weld = clonedHandle:FindFirstChildOfClass("WeldConstraint")
		if not weld then
			weld = Instance.new("WeldConstraint")
			weld.Part0 = clonedHandle
			weld.Part1 = clonedRibbon
			weld.Parent = clonedHandle
		else
			weld.Part0 = clonedHandle
			weld.Part1 = clonedRibbon
		end
	end

	groundModel.PrimaryPart = clonedHandle

	for _, p in ipairs(groundModel:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Anchored = true
			p.CanCollide = false
		end
	end

	applyBoxTheme(groundModel, theme)

	local baseCFrame = CFrame.new(position)
	groundModel:PivotTo(baseCFrame)
	groundModel.Parent = activeSpawns

	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineColor = theme.RibbonColor
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 0.5
	highlight.Parent = groundModel

	local pointLight = Instance.new("PointLight")
	pointLight.Color = theme.RibbonColor
	pointLight.Brightness = 1.2
	pointLight.Range = 14
	pointLight.Parent = clonedHandle

	startGlowLoop(groundModel, highlight, pointLight)
	startIdleMotion(groundModel, baseCFrame)

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "কালেক্ট করুন"
	prompt.ObjectText = "🎁 উপহার বক্স"
	prompt.HoldDuration = 0.2
	prompt.MaxActivationDistance = 10
	prompt.Parent = clonedHandle

	local taken = false

	prompt.Triggered:Connect(function(player)
		if taken then return end

		local hasBoxAlready = player.Backpack:FindFirstChild(MasterBoxTool.Name) 
			or (player.Character and player.Character:FindFirstChild(MasterBoxTool.Name))

		if hasBoxAlready then
			OpenBoxEvent:FireClient(player, "Coin", "⚠️ আপনার কাছে ইতিমধ্যে একটি বক্স আছে! সেটি আগে খুলুন।")
			return
		end

		taken = true
		groundModel:Destroy()

		local boxTool = MasterBoxTool:Clone()
		boxTool:SetAttribute("IsSpecial", isSpecial)
		boxTool:SetAttribute("RewardTool", chosenToolName)
		applyBoxTheme(boxTool, theme)
		boxTool.Parent = player.Backpack
	end)
end

----------------------------------------------------------------------
-- ৬. পার্মানেন্ট সেভ
----------------------------------------------------------------------
local function savePermanentTool(player, toolName)
	local ownedFolder = player:FindFirstChild("OwnedPermanentTools")
	if not ownedFolder then return end

	if not ownedFolder:FindFirstChild(toolName) then
		local tag = Instance.new("BoolValue")
		tag.Name = toolName
		tag.Parent = ownedFolder
	end

	local list = {}
	for _, t in ipairs(ownedFolder:GetChildren()) do
		table.insert(list, t.Name)
	end

	pcall(function()
		EventStore:SetAsync("PermTools_" .. player.UserId, list)
	end)
end

Players.PlayerAdded:Connect(function(player)
	local leaderstats = player:FindFirstChild("leaderstats") or Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	if not leaderstats:FindFirstChild(CURRENCY_NAME) then
		local cur = Instance.new("IntValue")
		cur.Name = CURRENCY_NAME
		cur.Value = 2000
		cur.Parent = leaderstats
	end

	local ownedFolder = Instance.new("Folder")
	ownedFolder.Name = "OwnedPermanentTools"
	ownedFolder.Parent = player

	local success, savedList = pcall(function()
		return EventStore:GetAsync("PermTools_" .. player.UserId)
	end)

	if success and savedList then
		for _, toolName in ipairs(savedList) do
			local val = Instance.new("BoolValue")
			val.Name = toolName
			val.Parent = ownedFolder
		end
	end

	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		for _, val in ipairs(ownedFolder:GetChildren()) do
			local origTool = ToolsFolder:FindFirstChild(val.Name)
			if origTool and not player.Backpack:FindFirstChild(val.Name) then
				origTool:Clone().Parent = player.Backpack
				origTool:Clone().Parent = player.StarterGear
			end
		end
	end)
end)

----------------------------------------------------------------------
-- ৭. ইভেন্ট শুরু ও ব্রডকাস্ট
----------------------------------------------------------------------
StartHuntEvent.OnServerInvoke = function(player, totalBoxes, luckyCount, chosenToolName)
	if totalBoxes == "GET_TOOLS" then
		local tools = {}
		for _, child in ipairs(ToolsFolder:GetChildren()) do
			if child:IsA("Tool") then
				table.insert(tools, child.Name)
			end
		end
		return {Success = true, Tools = tools}
	end

	if not checkAdmin(player) then
		return {Success = false, Message = "অনুমতি নেই! আপনি অ্যাডমিন নন।"}
	end

	if not ToolsFolder:FindFirstChild(chosenToolName) then
		return {Success = false, Message = "এই টুলটি ServerStorage-এ নেই!"}
	end

	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart then
		return {Success = false, Message = "আপনার ক্যারেক্টার পাওয়া যায়নি!"}
	end

	local centerPos = rootPart.Position

	totalBoxes = math.clamp(tonumber(totalBoxes) or 20, 1, 100)
	luckyCount = math.clamp(tonumber(luckyCount) or 1, 1, totalBoxes)

	activeSpawns:ClearAllChildren()

	local luckyIndices = {}
	while #luckyIndices < luckyCount do
		local randIndex = math.random(1, totalBoxes)
		if not table.find(luckyIndices, randIndex) then
			table.insert(luckyIndices, randIndex)
		end
	end

	local spawnedPositions = {}
	local spawnedCount = 0
	local attempts = 0
	local maxAttempts = totalBoxes * 30

	while spawnedCount < totalBoxes and attempts < maxAttempts do
		attempts = attempts + 1

		local angle = math.random() * math.pi * 2
		local distance = math.sqrt(math.random()) * SPAWN_RADIUS
		local targetX = centerPos.X + (math.cos(angle) * distance)
		local targetZ = centerPos.Z + (math.sin(angle) * distance)

		local groundPos = getGroundPosition(targetX, targetZ, centerPos.Y)

		if groundPos then
			local tooClose = false
			for _, existingPos in ipairs(spawnedPositions) do
				if (Vector2.new(groundPos.X, groundPos.Z) - Vector2.new(existingPos.X, existingPos.Z)).Magnitude < MIN_DISTANCE_BETWEEN_BOXES then
					tooClose = true
					break
				end
			end

			if not tooClose then
				spawnedCount = spawnedCount + 1
				table.insert(spawnedPositions, groundPos)

				local isLucky = table.find(luckyIndices, spawnedCount) ~= nil
				spawnPickupBox(groundPos, isLucky, chosenToolName)
			end
		end
	end

	-- 📢 পুরো সার্ভারের সবার স্ক্রিনে অ্যানিমেটেড অ্যালার্ট পাঠানো
	BroadcastEvent:FireAllClients("🎁 [TREASURE HUNT EVENT] 🎁\nম্যাপে " .. spawnedCount .. "টি উপহার বক্স ছড়িয়ে দেওয়া হয়েছে! দ্রুত সংগ্রহ করুন!")

	return {Success = true, Message = spawnedCount .. "টি বক্স সঠিকভাবে ল্যান্ড করেছে!"}
end

----------------------------------------------------------------------
-- ৮. বক্স ওপেন অ্যানিমেশন
----------------------------------------------------------------------
local function playUnboxPopAnimation(character, handlePart)
	if not character or not handlePart then return end

	local effectPart = Instance.new("Part")
	effectPart.Size = Vector3.new(1.8, 1.8, 1.8)
	effectPart.CFrame = handlePart.CFrame
	effectPart.Anchored = true
	effectPart.CanCollide = false
	effectPart.Transparency = 0.2
	effectPart.Material = Enum.Material.Neon
	effectPart.Color = Color3.fromRGB(255, 215, 0)
	effectPart.Parent = Workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Rate = 60
	emitter.Speed = NumberRange.new(8, 16)
	emitter.Lifetime = NumberRange.new(0.5, 0.8)
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 255, 255))
	emitter.Size = NumberSequence.new(0.5, 0)
	emitter.Parent = effectPart

	local popTween = TweenService:Create(effectPart, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		CFrame = effectPart.CFrame + Vector3.new(0, 2.5, 0),
		Size = Vector3.new(3.5, 3.5, 3.5),
		Transparency = 1
	})
	popTween:Play()

	task.delay(0.6, function()
		effectPart:Destroy()
	end)
end

OpenBoxEvent.OnServerEvent:Connect(function(player, boxTool)
	if not boxTool or not boxTool:IsA("Tool") then return end

	local isSpecial = boxTool:GetAttribute("IsSpecial")
	local targetTool = boxTool:GetAttribute("RewardTool")
	local leaderstats = player:FindFirstChild("leaderstats")
	local currency = leaderstats and leaderstats:FindFirstChild(CURRENCY_NAME)
	local ownedFolder = player:FindFirstChild("OwnedPermanentTools")
	local character = player.Character

	local handlePart = boxTool:FindFirstChild("Handle")
	if handlePart and character then
		playUnboxPopAnimation(character, handlePart)
	end

	boxTool:Destroy()

	if isSpecial then
		local alreadyOwned = false
		if (ownedFolder and ownedFolder:FindFirstChild(targetTool)) 
			or player.Backpack:FindFirstChild(targetTool) 
			or (player.Character and player.Character:FindFirstChild(targetTool)) then
			alreadyOwned = true
		end

		if alreadyOwned then
			if currency then
				currency.Value = currency.Value + 10000
			end
			OpenBoxEvent:FireClient(player, "Coin", "💎 আপনি ইতিমধ্যে এই টুলের মালিক! তাই ১০,০০০ " .. CURRENCY_NAME .. " বোনাস পেলেন!")
		else
			local toolMaster = ToolsFolder:FindFirstChild(targetTool)
			if toolMaster then
				toolMaster:Clone().Parent = player.Backpack
				toolMaster:Clone().Parent = player.StarterGear
			end

			savePermanentTool(player, targetTool)
			OpenBoxEvent:FireClient(player, "Tool", "🎉 অভিনন্দন! আপনি স্থায়ী " .. targetTool .. " জিতে নিয়েছেন!")

			pcall(function()
				game:GetService("TextChatService").TextChannels.RBXGeneral:DisplaySystemMessage(
					"🏆 " .. player.DisplayName .. " উপহার বক্স খুলে স্থায়ী " .. targetTool .. " জিতে নিয়েছেন!"
				)
			end)
		end
	else
		local rewardOptions = {1000, 1500, 2000, 2500, 3000}
		local wonAmount = rewardOptions[math.random(1, #rewardOptions)]
		if currency then
			currency.Value = currency.Value + wonAmount
		end
		OpenBoxEvent:FireClient(player, "Coin", "🪙 উপহার বক্স থেকে আপনি " .. wonAmount .. " " .. CURRENCY_NAME .. " পেয়েছেন!")
	end
end)]]></ProtectedString>
