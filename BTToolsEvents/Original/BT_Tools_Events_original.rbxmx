					<Item class="Script" referent="RBX41756918C10845519E885952EF6748D2">
						<Properties>
							<ProtectedString name="Source"><![CDATA[--[[
	FartToolScript (server)
	Self-contained tool script — no external dependencies.

	Activated by clicking with the tool equipped:
	- Plays a fart sound on the holder (placeholder asset id; set SOUND_ID below).
	- Bursts a puff of green smoke from the holder's LowerTorso (falls back to
	  Torso / HumanoidRootPart on other rigs).
	- Catches every OTHER player within STINK_RADIUS studs and gives them a
	  temporary stink cloud (STINK_MIN_DURATION–STINK_MAX_DURATION seconds)
	  plus a floating "🤢 Stinky!" BillboardGui above their head. Re-farting
	  near the same victim restarts their timer; effects never stack.

	All temporary effects are cleaned up by the Debris service, so they expire
	on time even if this tool is destroyed mid-effect (e.g. the farter
	leaving). COOLDOWN seconds between activations per holder (keyed by Player
	for players, by character model for NPCs).

	Everything lives in this script: move the tool anywhere (StarterPack,
	Workspace, another game) and it works immediately with zero setup.
]]

local Players = game:GetService("Players")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")

-- Configuration -------------------------------------------------------------
local COOLDOWN = 3 -- seconds between activations per holder

local SOUND_ID = "rbxassetid://0" -- TODO: replace with your fart sound asset id
local SOUND_VOLUME = 0.9
local SOUND_PITCH_MIN = 0.9
local SOUND_PITCH_MAX = 1.15
local SOUND_MAX_DISTANCE = 60

local BURST_PARTICLE_COUNT = 45

local STINK_RADIUS = 10 -- studs
local STINK_MIN_DURATION = 6 -- seconds
local STINK_MAX_DURATION = 8 -- seconds
local STINK_BILLBOARD_TEXT = "🤢 Stinky!"
local STINK_ATTRIBUTE = "StinkyUntil" -- os.clock() timestamp on the victim's character

local FART_COLOR = Color3.fromRGB(126, 217, 87)
------------------------------------------------------------------------------

local tool = script.Parent
local rng = Random.new()
local placeholderSoundWarned = false

-- holder (Player or NPC character) -> os.clock() of last activation
local lastActivatedAt: { [Instance]: number } = {}

local function pruneCooldowns()
	-- Drop entries for holders that no longer exist (left players, removed NPC
	-- characters) so the table never grows unbounded.
	for holder in lastActivatedAt do
		if not holder.Parent then
			lastActivatedAt[holder] = nil
		end
	end
end

-- One-shot puff at the farter (burst-only: Rate = 0, driven by :Emit()).
local function createFartBurst(parent: Instance): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "FartBurst"
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(FART_COLOR)
	emitter.LightEmission = 0.05
	emitter.Rate = 0
	emitter.EmissionDirection = Enum.NormalId.Bottom
	emitter.Speed = NumberRange.new(5, 9)
	emitter.SpreadAngle = Vector2.new(28, 28)
	emitter.Lifetime = NumberRange.new(0.9, 1.5)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.7),
		NumberSequenceKeypoint.new(0.7, 2.3),
		NumberSequenceKeypoint.new(1, 3.4),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.25),
		NumberSequenceKeypoint.new(0.75, 0.7),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.Acceleration = Vector3.new(0, 2.5, 0)
	emitter.Drag = 2
	emitter.Parent = parent
	return emitter
end

-- Lingering green haze around a stinky victim.
local function createStinkCloud(parent: Instance): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "StinkCloud"
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	emitter.Color = ColorSequence.new(FART_COLOR)
	emitter.LightEmission = 0.05
	emitter.Rate = 14
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Speed = NumberRange.new(0.5, 1.5)
	emitter.SpreadAngle = Vector2.new(35, 35)
	emitter.Lifetime = NumberRange.new(1, 1.8)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.5),
		NumberSequenceKeypoint.new(1, 1.8),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-40, 40)
	emitter.Acceleration = Vector3.new(0, 1.5, 0)
	emitter.Parent = parent
	return emitter
end

local function createStinkBillboard(character: Model, text: string): BillboardGui?
	local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	if not head then
		return nil
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "StinkBillboard"
	billboard.Adornee = head
	billboard.Size = UDim2.fromOffset(0, 0)
	billboard.StudsOffset = Vector3.new(0, 2.4, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 100

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = Color3.fromRGB(150, 235, 100)
	label.TextStrokeColor3 = Color3.fromRGB(25, 45, 15)
	label.TextStrokeTransparency = 0.2
	label.TextScaled = true
	label.Parent = billboard

	billboard.Parent = head
	TweenService:Create(
		billboard,
		TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Size = UDim2.fromOffset(140, 44) }
	):Play()

	return billboard
end

local function applyStink(victimCharacter: Model, duration: number)
	-- Replace any existing stink effects so the timer restarts and nothing stacks.
	local oldCloud = victimCharacter:FindFirstChild("StinkCloud", true)
	if oldCloud then
		oldCloud:Destroy()
	end
	local oldBillboard = victimCharacter:FindFirstChild("StinkBillboard", true)
	if oldBillboard then
		oldBillboard:Destroy()
	end

	victimCharacter:SetAttribute(STINK_ATTRIBUTE, os.clock() + duration)

	local root = victimCharacter:FindFirstChild("HumanoidRootPart") or victimCharacter.PrimaryPart
	if not root then
		return
	end

	-- Debris owns the cleanup: effects vanish exactly on time even if this
	-- tool is destroyed (e.g. the farter leaving the game) before they expire.
	Debris:AddItem(createStinkCloud(root), duration)

	local billboard = createStinkBillboard(victimCharacter, STINK_BILLBOARD_TEXT)
	if billboard then
		Debris:AddItem(billboard, duration)
	end
end

tool.Activated:Connect(function()
	local character = tool.Parent
	if not character or not character:IsA("Model") then
		return
	end

	local holderKey = Players:GetPlayerFromCharacter(character) or character

	pruneCooldowns()
	local lastUsed = lastActivatedAt[holderKey]
	if lastUsed and os.clock() - lastUsed < COOLDOWN then
		return -- still cooling down
	end
	lastActivatedAt[holderKey] = os.clock()

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local sourcePart = character:FindFirstChild("LowerTorso")
		or character:FindFirstChild("Torso") -- R6 fallback
		or rootPart
	if not humanoid or humanoid.Health <= 0 or not sourcePart then
		return
	end

	if SOUND_ID == "" or SOUND_ID:match("^rbxassetid://0+$") then
		if not placeholderSoundWarned then
			placeholderSoundWarned = true
			warn("[FartTool] SOUND_ID is still a placeholder - set it at the top of this script.")
		end
	end

	local sound = Instance.new("Sound")
	sound.Name = "FartSound"
	sound.SoundId = SOUND_ID
	sound.Volume = SOUND_VOLUME
	sound.PlaybackSpeed = rng:NextNumber(SOUND_PITCH_MIN, SOUND_PITCH_MAX)
	sound.RollOffMaxDistance = SOUND_MAX_DISTANCE
	sound.Parent = rootPart or sourcePart
	sound:Play()
	Debris:AddItem(sound, 6)

	local burst = createFartBurst(sourcePart)
	burst:Emit(BURST_PARTICLE_COUNT)
	Debris:AddItem(burst, 3)

	local sourcePosition = sourcePart.Position
	for _, otherPlayer in Players:GetPlayers() do
		if otherPlayer == holderKey then
			continue
		end

		local otherCharacter = otherPlayer.Character
		if not otherCharacter then
			continue
		end

		local otherHumanoid = otherCharacter:FindFirstChildOfClass("Humanoid")
		local otherRoot = otherCharacter:FindFirstChild("HumanoidRootPart")
		if otherHumanoid and otherHumanoid.Health > 0 and otherRoot then
			if (otherRoot.Position - sourcePosition).Magnitude <= STINK_RADIUS then
				applyStink(otherCharacter, rng:NextNumber(STINK_MIN_DURATION, STINK_MAX_DURATION))
			end
		end
	end
end)
]]></ProtectedString>
