					<Item class="Script" referent="RBX45BA4FC8619048D99725F789DB00A664">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local handle = tool:WaitForChild("Handle")

-- টুলের ভিতরের সব পার্টকে Handle এর সাথে ওয়েল্ড করার ফাংশন
local function WeldToolParts()
	for _, item in ipairs(tool:GetDescendants()) do
		if item:IsA("BasePart") and item ~= handle then
			-- WeldConstraint পজিশন অটোমেটিক ধরে রাখে, তাই C0/C1 এর হিসাব করতে হয় না
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = item
			weld.Parent = item

			item.Anchored = false -- পার্টগুলো আন-অ্যাঙ্কর করে দেওয়া হলো
		end
	end
end

-- স্ক্রিপ্ট রান হওয়ার সাথে সাথে একবারই ওয়েল্ড হবে
WeldToolParts()]]></ProtectedString>
