					<Item class="Script" referent="RBXCFFC7DCB30F34CE58C009B90E38123B9">
						<Properties>
							<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local handle = tool:WaitForChild("Handle")

-- টুলের ভিতরের সব পার্টকে Handle এর সাথে যুক্ত করার ফাংশন
local function weldToolParts()
	for _, item in ipairs(tool:GetDescendants()) do
		if item:IsA("BasePart") and item ~= handle then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = item
			weld.Parent = item

			item.Anchored = false
		end
	end
end

-- টুল চালু হওয়ার সাথে সাথে মাত্র একবার ওয়েল্ড হবে
weldToolParts()]]></ProtectedString>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<token name="RunContext">0</token>
