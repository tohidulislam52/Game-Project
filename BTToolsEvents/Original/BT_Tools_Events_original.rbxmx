				<Item class="LocalScript" referent="RBXB1E68287F74446E199110E3827BD8B19">
					<Properties>
						<ProtectedString name="Source"><![CDATA[-- ServerStorage > GiftBoxTool > BoxOpenerScript (LocalScript)
local tool = script.Parent
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local HuntRemotes = ReplicatedStorage:WaitForChild("HuntRemotes")
local OpenBoxEvent = HuntRemotes:WaitForChild("OpenBoxEvent")

local debounce = false

tool.Activated:Connect(function()
	if debounce then return end
	debounce = true

	-- ক্লায়েন্ট থেকে সার্ভারকে সিগন্যাল পাঠানো
	OpenBoxEvent:FireServer(tool)
end)]]></ProtectedString>
