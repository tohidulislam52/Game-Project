					<Item class="Script" referent="RBXEDBDC72E4DCB4DCC8517FD5272DA4FBD">
						<Properties>
							<ProtectedString name="Source">--[[
	SizeChangerScript (server)
	Self-contained tool script — no external dependencies.

	Activated by clicking with the tool equipped:
	- Toggles the holder between normal (NORMAL_SCALE) and giant (GIANT_SCALE)
	  by smoothly tweening the R15 Humanoid scale NumberValues:
	  BodyHeightScale, BodyWidthScale, BodyDepthScale and HeadScale.
	- The toggle state is stored as a "Giant" attribute on the character, so
	  it resets automatically on respawn.
	- COOLDOWN seconds between activations per holder (keyed by Player for
	  players, by character model for NPCs).

	Everything lives in this script: move the tool anywhere (StarterPack,
	Workspace, another game) and it works immediately with zero setup.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

-- Configuration -------------------------------------------------------------
local COOLDOWN = 10 -- seconds between activations per holder
local NORMAL_SCALE = 1
local GIANT_SCALE = 3
local TWEEN_TIME = 0.45
local GIANT_ATTRIBUTE = "Giant"
local SCALE_VALUE_NAMES = {
	"BodyHeightScale",
	"BodyWidthScale",
	"BodyDepthScale",
	"HeadScale",
}
------------------------------------------------------------------------------

local tool = script.Parent

-- holder (Player or NPC character) -&gt; os.clock() of last activation
local lastActivatedAt: { [Instance]: number } = {}

tool.Activated:Connect(function()
	local character = tool.Parent
	if not character or not character:IsA("Model") then
		return
	end

	local holderKey = Players:GetPlayerFromCharacter(character) or character

	-- Prune cooldown entries for holders that no longer exist (left players,
	-- removed NPC characters) so the table never grows unbounded.
	for holder in lastActivatedAt do
		if not holder.Parent then
			lastActivatedAt[holder] = nil
		end
	end

	local lastUsed = lastActivatedAt[holderKey]
	if lastUsed and os.clock() - lastUsed &lt; COOLDOWN then
		return -- still cooling down
	end
	lastActivatedAt[holderKey] = os.clock()

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health &lt;= 0 then
		return
	end

	if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		warn(`[SizeChanger] {character.Name}'s rig is not R15; Humanoid scale values are unavailable.`)
		return
	end

	local isGiant = character:GetAttribute(GIANT_ATTRIBUTE) == true
	local targetScale = isGiant and NORMAL_SCALE or GIANT_SCALE
	character:SetAttribute(GIANT_ATTRIBUTE, not isGiant)

	local tweenInfo = TweenInfo.new(TWEEN_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	for _, valueName in SCALE_VALUE_NAMES do
		local scaleValue = humanoid:FindFirstChild(valueName)
		if scaleValue and scaleValue:IsA("NumberValue") then
			TweenService:Create(scaleValue, tweenInfo, { Value = targetScale }):Play()
		end
	end
end)
</ProtectedString>
