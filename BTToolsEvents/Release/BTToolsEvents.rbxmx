					<Item class="LocalScript" referent="RBX40B78C381C5B4A7199680B15B1F75A7B">
						<Properties>
							<ProtectedString name="Source">local player = game.Players.LocalPlayer
local mouse = player:GetMouse()
local tool = script.Parent
local remoteEvent = tool:WaitForChild("RemoteEvent")

local isCuffing = false

tool.Activated:Connect(function()
	if not isCuffing then
		local targetPart = mouse.Target
		if targetPart then
			remoteEvent:FireServer("Cuff", targetPart)
		end
	else
		remoteEvent:FireServer("UnCuff")
	end
end)

remoteEvent.OnClientEvent:Connect(function(state)
	if state == "Use" then
		isCuffing = true
	elseif state == "UnUse" then
		isCuffing = false
	end
end)

-- টুল হাত থেকে পকেটে নিলে কাফ খুলে যাবে
tool.Unequipped:Connect(function()
	if isCuffing then
		isCuffing = false
		remoteEvent:FireServer("UnCuff")
	end
end)</ProtectedString>
