					<Item class="Script" referent="RBX91361D9C17934894A9502B0E91818B7E">
						<Properties>
							<ProtectedString name="Source">local object = script.Parent

local function getPrimaryPart(target)
	if target:IsA("Tool") then
		return target:FindFirstChild("Handle")
	elseif target:IsA("Model") then
		return target.PrimaryPart or target:FindFirstChild("Handle") or target:FindFirstChildOfClass("BasePart")
	end
	return target:IsA("BasePart") and target or nil
end

local function weldModel()
	local mainPart = getPrimaryPart(object)
	if not mainPart then
		warn("Weld Script: No primary part or Handle found in " .. object.Name)
		return
	end

	for _, item in ipairs(object:GetDescendants()) do
		if item:IsA("BasePart") and item ~= mainPart then
			-- পুরনো কোনো ওয়েল্ড থাকলে মুছে ফেলা
			for _, child in ipairs(item:GetChildren()) do
				if child:IsA("Weld") or child:IsA("WeldConstraint") then
					child:Destroy()
				end
			end

			-- নতুন WeldConstraint যুক্ত করা
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = mainPart
			weld.Part1 = item
			weld.Parent = item

			item.Anchored = false
		end
	end
	mainPart.Anchored = false
end

weldModel()</ProtectedString>
