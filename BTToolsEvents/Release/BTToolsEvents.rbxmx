<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Meta name="ExplicitAutoJoints">true</Meta><External>null</External><External>nil</External><Item class="Folder" referent="RBXBT21A19A139409497C8E160877374610B8"><Properties><string name="Name">BTToolsEvents</string></Properties><Item class="ModuleScript" referent="RBXBT0FCBA7EA85064BD786451D42E6690794"><Properties><string name="Name">README</string><ProtectedString name="Source">--[[
	🎁 BT Tools Event: কোথায় কী রাখবেন

	এই ফোল্ডারের ভেতরের প্রতিটা ফোল্ডারের নাম হল Roblox এর যে সার্ভিসে রাখতে হবে।
	ভেতরের জিনিসগুলো টেনে সেই সার্ভিসে রাখুন:

	1. ReplicatedStorage/BTToolsEvents      -&gt;  ReplicatedStorage
	2. ServerScriptService/BTToolsEvents    -&gt;  ServerScriptService
	3. ServerStorage/BTToolsEvents          -&gt;  ServerStorage
	   ServerStorage/Tools                  -&gt;  ServerStorage  (পুরস্কারের টুল, নিজের টুলও এখানে রাখুন)
	4. StarterPlayerScripts/BTToolsEvents   -&gt;  StarterPlayer &gt; StarterPlayerScripts
	5. Workspace/HuntSpawnZones             -&gt;  Workspace  (ভেতরের পার্টগুলো ম্যাপে যেখানে বক্স চান সেখানে বসান)
	   Workspace/WinnerShowcase             -&gt;  Workspace  (বিজয়ীর অবতার যেখানে নাচবে, সামনের দিক = মুখের দিক)

	তারপর এই খালি ফোল্ডারটা মুছে দিন।

	সব সেটিং (অ্যাডমিন ID, সাউন্ড ID, নাচের ID, টাকা) পাবেন:
	ReplicatedStorage &gt; BTToolsEvents &gt; Config

	Studio তে টেস্ট করতে: Game Settings &gt; Security &gt; "Enable Studio Access to API Services" চালু করুন,
	না হলে টুল সেভ হবে না।
]]
return nil
</ProtectedString></Properties></Item><Item class="Folder" referent="RBXBTDEA0AFF038354BB2BD14C9AF8307DA3F"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBXBT6D25AAC458E94865B77FCBB1E4C34CFA"><Properties><string name="Name">BTToolsEvents</string></Properties><Item class="ModuleScript" referent="RBXBT8F8E11D92D724CF381E929BFAE08B2FE"><Properties><string name="Name">Config</string><ProtectedString name="Source">--[[
	BT Tools Event: Config (ModuleScript)
	জায়গা: ReplicatedStorage &gt; BTToolsEvents &gt; Config

	পুরো সিস্টেমের সব সেটিং এই একটা ফাইলে। এখানে মান বদলালেই কাজ হবে,
	অন্য কোনো স্ক্রিপ্টে হাত দেওয়ার দরকার নেই।
	সার্ভার আর ক্লায়েন্ট দুজনেই এই ফাইল পড়ে, তাই এখানে কোনো গোপন জিনিস রাখবেন না।
]]

local RunService = game:GetService("RunService")

local Config = {}

----------------------------------------------------------------------
-- 👑 অ্যাডমিন
----------------------------------------------------------------------
-- নতুন অ্যাডমিন যোগ করতে এই লিস্টে তার UserId লিখুন, কমা দিয়ে আলাদা করে।
Config.ADMIN_USER_IDS = {
	7864126209,
}

-- Studio তে টেস্ট করার সময় সবাই অ্যাডমিন হবে (লাইভ গেমে এর কোনো প্রভাব নেই)।
Config.ALLOW_ADMIN_IN_STUDIO = true

-- চ্যাটে এই কমান্ড লিখলে অ্যাডমিনের 🎁 বাটন দেখা যাবে, আবার লিখলে লুকিয়ে যাবে।
Config.ADMIN_COMMAND = "/bttools"

----------------------------------------------------------------------
-- 💰 খালি বক্সের টাকা
----------------------------------------------------------------------
-- leaderstats এর ভেতরে যে ভ্যালুতে টাকা যোগ হবে তার নাম।
Config.CURRENCY_NAME = "Taka"
-- খালি বক্স থেকে কত টাকা পাবে (দুটো সমান রাখলে সবসময় একই টাকা)।
Config.COIN_REWARD_MIN = 1000
Config.COIN_REWARD_MAX = 3000

----------------------------------------------------------------------
-- 🧰 টুল আর ডেটা
----------------------------------------------------------------------
-- ServerStorage এ পুরস্কারের টুলের ফোল্ডারের নাম।
Config.TOOLS_FOLDER_NAME = "Tools"
-- গেমে ঢোকার কত সেকেন্ড পরে সেভ করা টুলগুলো দেওয়া হবে।
Config.JOIN_GRANT_DELAY = 5
-- ডেটাস্টোরের নাম। এটা বদলালে আগের সব সেভ করা টুল হারিয়ে যাবে, তাই বদলাবেন না।
Config.DATASTORE_NAME = "BTToolsEvents_OwnedTools_v1"
Config.HISTORY_DATASTORE_NAME = "BTToolsEvents_WinHistory_v1"
-- ইতিহাসে সর্বোচ্চ কতজন প্লেয়ার থাকবে (বেশি হলে সবচেয়ে পুরনো জন বাদ যাবে)।
Config.HISTORY_MAX_USERS = 300
-- প্রতি প্লেয়ারের শেষ কয়টা রেকর্ড থাকবে (জেতা / গিফট / সরানো)।
Config.HISTORY_MAX_RECORDS_PER_USER = 20

----------------------------------------------------------------------
-- 🎁 ইভেন্ট (অ্যাডমিন প্যানেলে এগুলোই ডিফল্ট হিসেবে দেখাবে)
----------------------------------------------------------------------
Config.DEFAULT_TOTAL_BOXES = 20
Config.MAX_TOTAL_BOXES = 100
Config.DEFAULT_EVENT_MINUTES = 5
Config.MAX_EVENT_MINUTES = 60

-- টুল শুরুতেই যেন না পাওয়া যায় (R14)।
-- প্রথম কত % বক্সে কখনো টুল আসবে না।
Config.DEFAULT_TOOL_SAFE_PERCENT = 40
-- একটা টুল পাওয়ার পর পরের কয়টা বক্সে টুল আসবে না।
Config.DEFAULT_TOOL_GAP = 2

----------------------------------------------------------------------
-- 📍 বক্স স্পনের জায়গা
----------------------------------------------------------------------
-- Workspace এ এই নামের ফোল্ডারে রাখা পার্টগুলোর এলাকায় বক্স পড়বে।
Config.SPAWN_ZONES_FOLDER_NAME = "HuntSpawnZones"
-- কোনো জোন না থাকলে অ্যাডমিনের চারপাশে কত stud পর্যন্ত বক্স পড়বে।
Config.DEFAULT_SPAWN_RADIUS = 200
Config.MAX_SPAWN_RADIUS = 1500
-- দুইটা বক্সের মাঝে কমপক্ষে কত stud দূরত্ব থাকবে।
Config.MIN_DISTANCE_BETWEEN_BOXES = 20
-- এর চেয়ে খাড়া ঢালে বক্স পড়বে না (1 = একদম সমান, 0 = খাড়া দেয়াল)।
Config.MIN_GROUND_FLATNESS = 0.6
-- মাটি থেকে বক্স কত উপরে ভাসবে।
Config.BOX_HOVER_HEIGHT = 2

----------------------------------------------------------------------
-- 📦 বক্স তোলা আর খোলা
----------------------------------------------------------------------
Config.BOX_PROMPT_DISTANCE = 10
Config.BOX_PROMPT_HOLD_DURATION = 0.3
-- বক্স হাতে আসার পর কমপক্ষে কত সেকেন্ড না গেলে সার্ভার বক্স খুলবে না (চিট বন্ধ করতে)।
Config.MIN_OPEN_TIME = 1.5

----------------------------------------------------------------------
-- 🎯 বক্স খোলার মিনি-গেম (টাইমিং বার)
----------------------------------------------------------------------
Config.Minigame = {
	HITS_REQUIRED = 3, -- কয়বার সঠিক ক্লিক করতে হবে
	ZONE_SIZE_START = 0.24, -- প্রথম রাউন্ডে সোনালি জোন বারের কত অংশ (0.24 = 24%)
	ZONE_SHRINK = 0.04, -- প্রতি রাউন্ডে জোন কতটা ছোট হবে
	ZONE_SIZE_MIN = 0.1, -- জোন এর চেয়ে ছোট হবে না
	NEEDLE_SPEED_START = 0.9, -- কাঁটার গতি (প্রতি সেকেন্ডে বারের কত অংশ পার হয়)
	NEEDLE_SPEED_UP = 0.3, -- প্রতি রাউন্ডে গতি কত বাড়বে
	MISS_STUN = 0.6, -- ভুল ক্লিকের পর কত সেকেন্ড অপেক্ষা
}

----------------------------------------------------------------------
-- 🏆 বিজয়ীর শোকেস
----------------------------------------------------------------------
-- Workspace এ এই নামের পার্টের জায়গায় বিজয়ীর বড় অবতার নাচবে।
Config.SHOWCASE_PART_NAME = "WinnerShowcase"
Config.SHOWCASE_SCALE = 3
Config.SHOWCASE_DURATION = 25
-- পাশাপাশি দুইটা অবতারের মাঝের দূরত্ব (stud)।
Config.SLOT_SPACING = 12
Config.MAX_SHOWCASE_SLOTS = 3
-- নাচের অ্যানিমেশন ID। এখানে নিজের ID বসান।
Config.DANCE_ANIMATION_ID = "rbxassetid://0"
-- আসল বিজয়ীর মাথার ওপরে ইভেন্ট শেষ না হওয়া পর্যন্ত "👑 WINNER" ট্যাগ থাকবে কিনা।
Config.WINNER_TAG_ON_PLAYER = true

----------------------------------------------------------------------
-- 🔊 সাউন্ড ID (rbxassetid://0 থাকলে সেই সাউন্ড বাজবে না)
----------------------------------------------------------------------
Config.SOUND_IDS = {
	EventStart = "rbxassetid://96924810403789", -- ইভেন্ট শুরুর ব্যানার
	Pickup = "rbxassetid://0", -- বক্স তোলা
	Hit = "rbxassetid://0", -- মিনি-গেমে সঠিক ক্লিক
	Miss = "rbxassetid://0", -- মিনি-গেমে ভুল ক্লিক
	Unbox = "rbxassetid://128852575896829", -- বক্স ফাটা
	Coin = "rbxassetid://99023919906775", -- খালি বক্স থেকে টাকা
	ToolWin = "rbxassetid://99856221174802", -- টুল জেতা
	EventEnd = "rbxassetid://0", -- ইভেন্ট শেষ
}
Config.SOUND_VOLUME = 0.6

----------------------------------------------------------------------
-- 🎨 থিম
----------------------------------------------------------------------
-- সবার জন্য কোন থিম চলবে: "Midnight", "Frost" অথবা "Ember"।
-- অ্যাডমিন প্যানেলের "থিম" ট্যাব থেকে নিজের স্ক্রিনে আগে দেখে নিতে পারবেন।
Config.THEME = "Midnight"

-- রং বদলাতে চাইলে এখানে বদলান, অথবা একই রকম করে নতুন থিম যোগ করুন।
--   Background  প্যানেলের পেছনের রং       Surface / SurfaceHover  ভেতরের সারি আর বাটন
--   Text / SubText  লেখা                    Accent / AccentDeep  প্রধান রং (gradient এর দুই মাথা)
--   OnAccent  Accent এর ওপরের লেখা          Glass  প্যানেল কতটা স্বচ্ছ (0 = একদম ভরাট, 1 = অদৃশ্য)
Config.THEMES = {
	-- গাঢ় নীল কাচ, সোনালি accent
	Midnight = {
		Background = Color3.fromRGB(13, 16, 25),
		Surface = Color3.fromRGB(27, 31, 46),
		SurfaceHover = Color3.fromRGB(38, 43, 62),
		Stroke = Color3.fromRGB(255, 255, 255),
		StrokeTransparency = 0.88,
		Text = Color3.fromRGB(240, 242, 248),
		SubText = Color3.fromRGB(146, 154, 178),
		Accent = Color3.fromRGB(246, 192, 72),
		AccentDeep = Color3.fromRGB(214, 140, 32),
		OnAccent = Color3.fromRGB(30, 21, 6),
		Success = Color3.fromRGB(64, 196, 128),
		Danger = Color3.fromRGB(236, 88, 88),
		Info = Color3.fromRGB(92, 150, 255),
		Glass = 0.16,
	},
	-- হালকা সাদা কাচ, নীল accent
	Frost = {
		Background = Color3.fromRGB(246, 248, 252),
		Surface = Color3.fromRGB(232, 237, 245),
		SurfaceHover = Color3.fromRGB(220, 227, 238),
		Stroke = Color3.fromRGB(15, 23, 42),
		StrokeTransparency = 0.88,
		Text = Color3.fromRGB(20, 26, 38),
		SubText = Color3.fromRGB(96, 106, 126),
		Accent = Color3.fromRGB(64, 132, 246),
		AccentDeep = Color3.fromRGB(40, 96, 230),
		OnAccent = Color3.fromRGB(255, 255, 255),
		Success = Color3.fromRGB(22, 160, 84),
		Danger = Color3.fromRGB(220, 50, 50),
		Info = Color3.fromRGB(14, 150, 220),
		Glass = 0.08,
	},
	-- কয়লা-কালো কাচ, কমলা accent
	Ember = {
		Background = Color3.fromRGB(19, 17, 17),
		Surface = Color3.fromRGB(34, 30, 29),
		SurfaceHover = Color3.fromRGB(48, 41, 39),
		Stroke = Color3.fromRGB(255, 255, 255),
		StrokeTransparency = 0.9,
		Text = Color3.fromRGB(246, 240, 236),
		SubText = Color3.fromRGB(170, 156, 148),
		Accent = Color3.fromRGB(255, 128, 72),
		AccentDeep = Color3.fromRGB(226, 76, 42),
		OnAccent = Color3.fromRGB(32, 12, 6),
		Success = Color3.fromRGB(80, 200, 140),
		Danger = Color3.fromRGB(240, 84, 84),
		Info = Color3.fromRGB(120, 160, 255),
		Glass = 0.16,
	},
}

----------------------------------------------------------------------
-- এর নিচে কিছু বদলানোর দরকার নেই
----------------------------------------------------------------------
local adminSet: { [number]: boolean } = {}
for _, userId in Config.ADMIN_USER_IDS do
	adminSet[userId] = true
end

function Config.IsAdmin(player: Player): boolean
	if Config.ALLOW_ADMIN_IN_STUDIO and RunService:IsStudio() then
		return true
	end
	return adminSet[player.UserId] == true
end

-- নাম না মিললে Midnight।
function Config.GetTheme(name: string?): { [string]: any }
	return Config.THEMES[name or Config.THEME] or Config.THEMES[Config.THEME] or Config.THEMES.Midnight
end

function Config.IsSoundSet(id: string?): boolean
	return type(id) == "string" and id ~= "" and not string.match(id, "^rbxassetid://0*$")
end

return Config
</ProtectedString></Properties></Item><Item class="Folder" referent="RBXBT9A52FE799BDE4B52A6FDDD156DBDB724"><Properties><string name="Name">Remotes</string></Properties><Item class="RemoteFunction" referent="RBXBT2FA54A96DCE449ADB7FA6F8BF5CBBBA4"><Properties><string name="Name">AdminRequest</string></Properties></Item><Item class="RemoteEvent" referent="RBXBTFD8EB8C9775B44BAAFEA05045FBC265D"><Properties><string name="Name">OpenBox</string></Properties></Item><Item class="RemoteEvent" referent="RBXBT5C5C8915056640ADA5C5C9B1A516D315"><Properties><string name="Name">Notify</string></Properties></Item><Item class="RemoteEvent" referent="RBXBT7D6F609677A147F8B5A2B2B8E43F208E"><Properties><string name="Name">Announce</string></Properties></Item></Item></Item></Item><Item class="Folder" referent="RBXBTC2083285BB75420CACA4FD2A099C94B4"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBXBT8858E3CFE8054166AFE612711207F015"><Properties><string name="Name">BTToolsEvents</string></Properties><Item class="Script" referent="RBXBT783A7D25365C4531A5212DBD32E43521"><Properties><string name="Name">Main</string><ProtectedString name="Source">--[[
	BT Tools Event: Main (Script, সার্ভার)
	জায়গা: ServerScriptService &gt; BTToolsEvents &gt; Main

	শুধু মডিউলগুলো চালু করে। আসল কাজ Modules ফোল্ডারের ফাইলগুলোতে।
]]

-- ফাইলটা ইনসার্ট করার পর ঠিক জায়গায় সরানোর আগে Play চাপলে যেন ভুল জায়গা থেকে না চলে।
if not script:IsDescendantOf(game:GetService("ServerScriptService")) then
	warn("[BTToolsEvents] Main স্ক্রিপ্টটা ServerScriptService এ রাখুন, তারপর চালু হবে।")
	return
end

local Modules = script.Parent:WaitForChild("Modules")

local ToolData = require(Modules:WaitForChild("ToolData"))
local BoxSpawner = require(Modules:WaitForChild("BoxSpawner"))
local Showcase = require(Modules:WaitForChild("Showcase"))
local EventManager = require(Modules:WaitForChild("EventManager"))
local AdminService = require(Modules:WaitForChild("AdminService"))

ToolData.Init()
BoxSpawner.Init()
Showcase.Init()
EventManager.Init()
AdminService.Init()
</ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="Folder" referent="RBXBT0EC519A5A12145A2B7A18FA80BC79F74"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBXBTCCDA7A1071E34E22856C9A5D4E04F4D4"><Properties><string name="Name">AdminService</string><ProtectedString name="Source">--[[
	BT Tools Event: AdminService (ModuleScript, সার্ভার)

	অ্যাডমিন প্যানেলের সব অনুরোধ এখানে আসে (RemoteFunction: AdminRequest)।
	প্রতিটা অনুরোধে সার্ভার নিজে UserId দিয়ে অ্যাডমিন কিনা চেক করে,
	আর ক্লায়েন্টের পাঠানো প্রতিটা মান যাচাই করে। ক্লায়েন্টের কথা বিশ্বাস করা হয় না।
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("BTToolsEvents")
local Config = require(Shared:WaitForChild("Config"))
local AdminRemote = Shared:WaitForChild("Remotes"):WaitForChild("AdminRequest") :: RemoteFunction

local Modules = script.Parent
local Util = require(Modules:WaitForChild("Util"))
local ToolData = require(Modules:WaitForChild("ToolData"))
local BoxSpawner = require(Modules:WaitForChild("BoxSpawner"))
local Showcase = require(Modules:WaitForChild("Showcase"))
local EventManager = require(Modules:WaitForChild("EventManager"))

local AdminService = {}

local limiter = Util.RateLimiter(0.4)

type Response = { ok: boolean, message: string?, data: any? }

local function fail(message: string): Response
	return { ok = false, message = message }
end

local function getInfo(): Response
	return {
		ok = true,
		data = {
			tools = ToolData.ListToolNames(),
			active = EventManager.IsActive(),
			zoneCount = BoxSpawner.CountZones(),
			hasShowcase = Showcase.HasShowcasePart(),
			defaults = {
				totalBoxes = Config.DEFAULT_TOTAL_BOXES,
				minutes = Config.DEFAULT_EVENT_MINUTES,
				radius = Config.DEFAULT_SPAWN_RADIUS,
				safePercent = Config.DEFAULT_TOOL_SAFE_PERCENT,
				gap = Config.DEFAULT_TOOL_GAP,
			},
			limits = {
				maxBoxes = Config.MAX_TOTAL_BOXES,
				maxMinutes = Config.MAX_EVENT_MINUTES,
				maxRadius = Config.MAX_SPAWN_RADIUS,
			},
		},
	}
end

local function start(player: Player, payload: any): Response
	if type(payload) ~= "table" then
		return fail("ভুল তথ্য।")
	end
	local totalBoxes, minutes, radius = payload.totalBoxes, payload.minutes, payload.radius
	local safePercent, gap, tools = payload.safePercent, payload.gap, payload.tools
	if not Util.IsInteger(totalBoxes, 1, Config.MAX_TOTAL_BOXES) then
		return fail(`মোট বক্স 1 থেকে {Config.MAX_TOTAL_BOXES} এর মধ্যে দিন।`)
	end
	if not Util.IsInteger(minutes, 1, Config.MAX_EVENT_MINUTES) then
		return fail(`সময় 1 থেকে {Config.MAX_EVENT_MINUTES} মিনিটের মধ্যে দিন।`)
	end
	if not Util.IsInteger(radius, 10, Config.MAX_SPAWN_RADIUS) then
		return fail(`Radius 10 থেকে {Config.MAX_SPAWN_RADIUS} এর মধ্যে দিন।`)
	end
	if not Util.IsInteger(safePercent, 0, 90) then
		return fail("শুরুর নিরাপদ % 0 থেকে 90 এর মধ্যে দিন।")
	end
	if not Util.IsInteger(gap, 0, 20) then
		return fail("টুলের মাঝের ফাঁক 0 থেকে 20 এর মধ্যে দিন।")
	end
	if type(tools) ~= "table" then
		return fail("টুল বেছে নিন।")
	end
	local cleanTools: { [string]: number } = {}
	local kinds = 0
	for name, count in tools do
		if type(name) ~= "string" or #name &gt; 100 or not Util.IsInteger(count, 0, Config.MAX_TOTAL_BOXES) then
			return fail("টুলের তথ্য ভুল।")
		end
		if count &gt; 0 then
			kinds += 1
			if kinds &gt; 50 then
				return fail("টুলের তথ্য ভুল।")
			end
			cleanTools[name] = count
		end
	end

	local ok, message = EventManager.Start(player, {
		totalBoxes = totalBoxes,
		minutes = minutes,
		radius = radius,
		safePercent = safePercent,
		gap = gap,
		tools = cleanTools,
	})
	return { ok = ok, message = message }
end

local function readUserAndTool(payload: any, needTool: boolean): (number?, string?, string?)
	if type(payload) ~= "table" then
		return nil, nil, "ভুল তথ্য।"
	end
	local userId = payload.userId
	if not Util.IsInteger(userId, 1, 2 ^ 53) then
		return nil, nil, "সঠিক UserId দিন।"
	end
	if not needTool then
		return userId, nil, nil
	end
	local toolName = payload.tool
	if type(toolName) ~= "string" or not ToolData.FindTool(toolName) then
		return nil, nil, "লিস্ট থেকে একটা টুল বেছে নিন।"
	end
	return userId, toolName, nil
end

-- অফলাইন প্লেয়ারের নামও ইতিহাসে রাখার জন্য।
local function lookupName(userId: number): string?
	local online = Players:GetPlayerByUserId(userId)
	if online then
		return online.Name
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	return if ok then name else nil
end

local function handle(player: Player, action: any, payload: any): Response
	if not Config.IsAdmin(player) then
		return fail("অনুমতি নেই, আপনি অ্যাডমিন নন।")
	end
	if not limiter(player) then
		return fail("একটু ধীরে...")
	end

	if action == "GetInfo" then
		return getInfo()
	elseif action == "Start" then
		return start(player, payload)
	elseif action == "Stop" then
		if EventManager.Stop("admin") then
			return { ok = true, message = "⏹ ইভেন্ট বন্ধ হয়েছে।" }
		end
		return fail("কোনো ইভেন্ট চলছে না।")
	elseif action == "GiveTool" or action == "RemoveTool" then
		local userId, toolName, err = readUserAndTool(payload, true)
		if not userId or not toolName then
			return fail(err or "ভুল তথ্য।")
		end
		local owned = action == "GiveTool"
		local saved, message = ToolData.AdminSetOwned(userId, toolName, owned)
		ToolData.AppendHistory(userId, lookupName(userId), toolName, if owned then "gift" else "remove", player.Name)
		local verb = if owned then "দেওয়া" else "সরানো"
		return { ok = saved, message = `{toolName} {verb} হয়েছে: {message}` }
	elseif action == "GetPlayerTools" then
		local userId, _, err = readUserAndTool(payload, false)
		if not userId then
			return fail(err or "ভুল তথ্য।")
		end
		local tools = ToolData.GetSavedTools(userId)
		if not tools then
			return fail("ডেটাস্টোর থেকে পড়া যায়নি।")
		end
		return { ok = true, data = tools }
	elseif action == "GetHistory" then
		local onlyUserId: number? = nil
		if type(payload) == "table" and payload.userId ~= nil then
			if not Util.IsInteger(payload.userId, 1, 2 ^ 53) then
				return fail("সঠিক UserId দিন।")
			end
			onlyUserId = payload.userId
		end
		local history = ToolData.GetHistory(30, onlyUserId)
		if not history then
			return fail("ইতিহাস পড়া যায়নি।")
		end
		return { ok = true, data = history }
	end
	return fail("অজানা কাজ।")
end

function AdminService.Init()
	AdminRemote.OnServerInvoke = function(player: Player, action: any, payload: any)
		local ok, result = pcall(handle, player, action, payload)
		if ok then
			return result
		end
		warn(`[BTToolsEvents] অ্যাডমিন অনুরোধে সমস্যা: {result}`)
		return fail("সার্ভারে সমস্যা হয়েছে।")
	end
end

return AdminService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBTEED00C5011D74F4996610D85E10B9CB3"><Properties><string name="Name">BoxSpawner</string><ProtectedString name="Source">--[[
	BT Tools Event: BoxSpawner (ModuleScript, সার্ভার)

	বক্স কোথায় পড়বে সেটা খুঁজে বের করে।
	1. Workspace &gt; HuntSpawnZones ফোল্ডারে পার্ট থাকলে বক্স শুধু ওই পার্টগুলোর এলাকায় পড়বে।
	   জোনের ওপর থেকে নিচে ray ছুড়ে মাটি (Terrain বা পার্ট) খোঁজা হয়। মাটিটা জোনের
	   উচ্চতার ভেতরে না পড়লে বাতিল, তাই পাতলা জোন রাখলে বক্স ছাদ বা গাছে উঠবে না।
	2. জোন না থাকলে অ্যাডমিনের চারপাশে radius এর মধ্যে পড়বে।
	পানি, খাড়া ঢাল আর CanCollide = false পার্ট (ঘাস, পাতা ইত্যাদি) বাদ যায়।
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("BTToolsEvents")
local Config = require(Shared:WaitForChild("Config"))

local BoxSpawner = {}

local rng = Random.new()

local function getZones(): { BasePart }
	local zones = {}
	local folder = Workspace:FindFirstChild(Config.SPAWN_ZONES_FOLDER_NAME)
	if folder then
		for _, d in folder:GetDescendants() do
			if d:IsA("BasePart") then
				table.insert(zones, d)
			end
		end
	end
	return zones
end

-- জোন পার্টগুলোকে গেমের ভেতরে অদৃশ্য আর স্পর্শহীন করে দেয়।
local function hideZone(part: BasePart)
	part.Anchored = true
	part.Transparency = 1
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
end

function BoxSpawner.Init()
	local folder = Workspace:FindFirstChild(Config.SPAWN_ZONES_FOLDER_NAME)
	if folder then
		for _, zone in getZones() do
			hideZone(zone)
		end
		folder.DescendantAdded:Connect(function(d)
			if d:IsA("BasePart") then
				hideZone(d)
			end
		end)
	end
end

function BoxSpawner.CountZones(): number
	return #getZones()
end

local function makeRaycastParams(exclude: { Instance }): RaycastParams
	local list = table.clone(exclude)
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = list
	params.IgnoreWater = false
	params.RespectCanCollide = true
	return params
end

local function isGoodGround(hit: RaycastResult?): boolean
	if not hit then
		return false
	end
	if hit.Material == Enum.Material.Water then
		return false
	end
	if string.find(string.lower(hit.Instance.Name), "water", 1, true) then
		return false
	end
	return hit.Normal.Y &gt;= Config.MIN_GROUND_FLATNESS
end

local function farEnough(position: Vector3, taken: { Vector3 }): boolean
	local minDistance = Config.MIN_DISTANCE_BETWEEN_BOXES
	for _, other in taken do
		local dx, dz = position.X - other.X, position.Z - other.Z
		if dx * dx + dz * dz &lt; minDistance * minDistance then
			return false
		end
	end
	return true
end

local function pickWeightedZone(zones: { BasePart }, totalArea: number): BasePart
	local roll = rng:NextNumber() * totalArea
	for _, zone in zones do
		roll -= zone.Size.X * zone.Size.Z
		if roll &lt;= 0 then
			return zone
		end
	end
	return zones[#zones]
end

local function sampleZone(zone: BasePart, params: RaycastParams): Vector3?
	local size = zone.Size
	local top = zone.CFrame:PointToWorldSpace(
		Vector3.new((rng:NextNumber() - 0.5) * size.X, size.Y / 2, (rng:NextNumber() - 0.5) * size.Z)
	)
	local hit = Workspace:Raycast(top, -zone.CFrame.UpVector * size.Y, params)
	if hit and isGoodGround(hit) then
		return hit.Position
	end
	return nil
end

local function sampleRadius(center: Vector3, radius: number, params: RaycastParams): Vector3?
	local angle = rng:NextNumber() * math.pi * 2
	local distance = math.sqrt(rng:NextNumber()) * radius
	local origin = center + Vector3.new(math.cos(angle) * distance, 150, math.sin(angle) * distance)
	local hit = Workspace:Raycast(origin, Vector3.new(0, -400, 0), params)
	if hit and isGoodGround(hit) then
		return hit.Position
	end
	return nil
end

-- count টা বক্সের জায়গা খোঁজে। যতগুলো পাওয়া গেল সেগুলো ফেরত দেয় (count এর চেয়ে কম হতে পারে)।
-- exclude: যেগুলোতে ray লাগবে না (বক্স ফোল্ডার, শোকেস ইত্যাদি)।
function BoxSpawner.FindPositions(
	count: number,
	center: Vector3?,
	radius: number,
	exclude: { Instance }
): ({ Vector3 }, string)
	local params = makeRaycastParams(exclude)
	local zones = getZones()
	local positions: { Vector3 } = {}
	local attempts = count * 40

	if #zones &gt; 0 then
		local totalArea = 0
		for _, zone in zones do
			totalArea += zone.Size.X * zone.Size.Z
		end
		while #positions &lt; count and attempts &gt; 0 do
			attempts -= 1
			local ground = sampleZone(pickWeightedZone(zones, totalArea), params)
			if ground and farEnough(ground, positions) then
				table.insert(positions, ground + Vector3.new(0, Config.BOX_HOVER_HEIGHT, 0))
			end
		end
		return positions, "zones"
	end

	if not center then
		return positions, "none"
	end
	while #positions &lt; count and attempts &gt; 0 do
		attempts -= 1
		local ground = sampleRadius(center, radius, params)
		if ground and farEnough(ground, positions) then
			table.insert(positions, ground + Vector3.new(0, Config.BOX_HOVER_HEIGHT, 0))
		end
	end
	return positions, "radius"
end

return BoxSpawner
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBT06FB8DEBEA814E108C44C8E835905356"><Properties><string name="Name">EventManager</string><ProtectedString name="Source">--[[
	BT Tools Event: EventManager (ModuleScript, সার্ভার)

	ইভেন্টের পুরো কাজ: বক্স স্পন, তোলা, খোলা, টাইমার আর শেষ।

	কোন বক্সে টুল আসবে (R14):
	- টুল আগে থেকে কোনো বক্সে রাখা থাকে না। বক্স খোলার মুহূর্তে সার্ভার ঠিক করে।
	- প্রথম TOOL_SAFE_PERCENT % খোলায় কখনো টুল আসে না।
	- তারপর প্রতিটা খোলায় সুযোগ = বাকি টুল ÷ বাকি বক্স।
	- একটা টুল পাওয়ার পর পরের TOOL_GAP টা খোলায় টুল আসে না।
	- বাকি বক্স = বাকি টুল হলে অবশ্যই টুল আসে (গ্যারান্টি)।
	- যে খুলছে তার কাছে টুলটা আগে থেকেই থাকলে তাকে টাকা দেওয়া হয়, টুলটা পরের বক্সের জন্য থাকে।
	  গ্যারান্টির ক্ষেত্রে (শেষ বক্স) তাকেই দেওয়া হয়, কিন্তু ডাবল কপি যায় না (R5.3)।
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("BTToolsEvents")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = Shared:WaitForChild("Remotes")
local OpenBoxRemote = Remotes:WaitForChild("OpenBox") :: RemoteEvent
local NotifyRemote = Remotes:WaitForChild("Notify") :: RemoteEvent
local AnnounceRemote = Remotes:WaitForChild("Announce") :: RemoteEvent

local Modules = script.Parent
local Util = require(Modules:WaitForChild("Util"))
local ToolData = require(Modules:WaitForChild("ToolData"))
local BoxSpawner = require(Modules:WaitForChild("BoxSpawner"))
local Showcase = require(Modules:WaitForChild("Showcase"))

local BOX_ATTRIBUTE = "BTBoxId"

type BoxRecord = {
	id: number,
	state: "ground" | "held" | "opened",
	position: Vector3,
	model: Model?,
	holder: Player?,
	tool: Tool?,
	heldSince: number,
	connections: { RBXScriptConnection },
}

type EventState = {
	total: number,
	opened: number,
	safeCount: number,
	gap: number,
	gapLeft: number,
	tools: { [string]: number },
	boxes: { [number]: BoxRecord },
	endsAt: number,
	winners: { { userId: number, name: string, tool: string } },
}

export type StartParams = {
	totalBoxes: number,
	minutes: number,
	radius: number,
	safePercent: number,
	gap: number,
	tools: { [string]: number },
}

local EventManager = {}

local rng = Random.new()
local boxesFolder: Folder
local current: EventState? = nil
local nextBoxId = 0

local pickupLimiter = Util.RateLimiter(0.3)
local openLimiter = Util.RateLimiter(0.5)

----------------------------------------------------------------------
-- সবার জন্য ইভেন্টের অবস্থা (HUD এটা পড়ে)
----------------------------------------------------------------------
local function publishState()
	local ev = current
	Shared:SetAttribute("Active", ev ~= nil)
	Shared:SetAttribute("Total", if ev then ev.total else 0)
	Shared:SetAttribute("Opened", if ev then ev.opened else 0)
	Shared:SetAttribute("EndsAt", if ev then ev.endsAt else 0)
end

local function notify(player: Player, kind: string, data: { [string]: any })
	NotifyRemote:FireClient(player, kind, data)
end

----------------------------------------------------------------------
-- বক্সের মডেল
----------------------------------------------------------------------
local function getBoxTemplate(): Tool?
	local folder = ServerStorage:FindFirstChild("BTToolsEvents")
	local template = folder and folder:FindFirstChild("GiftBoxTool")
	if template and template:IsA("Tool") then
		return template
	end
	return nil
end

local function stripScripts(root: Instance)
	for _, d in root:GetDescendants() do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		end
	end
end

-- টেমপ্লেট না থাকলে সাধারণ একটা লাল-সোনালি বক্স।
local function makeFallbackVisual(): Model
	local visual = Instance.new("Model")
	local box = Instance.new("Part")
	box.Name = "Handle"
	box.Size = Vector3.new(2.4, 2.4, 2.4)
	box.Color = Color3.fromRGB(170, 25, 35)
	box.Material = Enum.Material.SmoothPlastic
	box.Parent = visual
	for _, size in { Vector3.new(2.5, 2.5, 0.5), Vector3.new(0.5, 2.5, 2.5) } do
		local ribbon = Instance.new("Part")
		ribbon.Name = "Ribbon"
		ribbon.Size = size
		ribbon.Color = Color3.fromRGB(255, 205, 60)
		ribbon.Material = Enum.Material.SmoothPlastic
		ribbon.CFrame = box.CFrame
		ribbon.Parent = visual
	end
	visual.PrimaryPart = box
	return visual
end

local function buildGroundModel(record: BoxRecord): Model
	local model = Instance.new("Model")
	model.Name = "GiftBox_" .. record.id
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

	-- স্থির, অদৃশ্য Root। Prompt এর Attachment এর সাথেই থাকে, তাই কখনো গায়েব হয় না (R8)।
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(3, 3, 3)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.CFrame = CFrame.new(record.position)
	root.Parent = model
	model.PrimaryPart = root

	local attachment = Instance.new("Attachment")
	attachment.Name = "PromptAttachment"
	attachment.Parent = root

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "তুলুন"
	prompt.ObjectText = "🎁 উপহার বক্স"
	prompt.HoldDuration = Config.BOX_PROMPT_HOLD_DURATION
	prompt.MaxActivationDistance = Config.BOX_PROMPT_DISTANCE
	prompt.RequiresLineOfSight = false
	prompt.Parent = attachment

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 215, 120)
	light.Brightness = 1.5
	light.Range = 12
	light.Parent = root

	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparkle.Color = ColorSequence.new(Color3.fromRGB(255, 235, 150))
	sparkle.Size = NumberSequence.new(0.35, 0)
	sparkle.Lifetime = NumberRange.new(0.8, 1.4)
	sparkle.Rate = 4
	sparkle.Speed = NumberRange.new(0.5, 1.5)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.LightEmission = 1
	sparkle.Parent = attachment

	-- দেখার অংশ। ক্লায়েন্ট এটাকে ঘোরায় আর ভাসায় (BoxVisuals)।
	local visual: Model
	local template = getBoxTemplate()
	if template then
		local clone = template:Clone()
		stripScripts(clone)
		visual = Instance.new("Model")
		for _, child in clone:GetChildren() do
			if child:IsA("BasePart") then
				child.Parent = visual
			end
		end
		clone:Destroy()
		local handle = visual:FindFirstChild("Handle")
		visual.PrimaryPart = if handle and handle:IsA("BasePart") then handle else visual:FindFirstChildWhichIsA("BasePart")
	else
		visual = makeFallbackVisual()
	end
	visual.Name = "Visual"
	for _, d in visual:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
		elseif d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			d:Destroy()
		end
	end
	visual:PivotTo(CFrame.new(record.position))
	visual.Parent = model

	prompt.Triggered:Connect(function(player)
		EventManager._OnPickup(record, player)
	end)

	model.Parent = boxesFolder
	return model
end

local function makeBoxTool(record: BoxRecord): Tool
	local tool: Tool
	local template = getBoxTemplate()
	if template then
		tool = template:Clone()
		stripScripts(tool)
	else
		tool = Instance.new("Tool")
		local visual = makeFallbackVisual()
		for _, part in visual:GetChildren() do
			part.Parent = tool
			if part.Name ~= "Handle" then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = tool:FindFirstChild("Handle") :: BasePart
				weld.Part1 = part :: BasePart
				weld.Parent = part
			end
		end
		visual:Destroy()
	end
	tool.Name = "🎁 Gift Box"
	tool.ToolTip = "খুলতে ক্লিক করুন"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute(BOX_ATTRIBUTE, record.id)
	for _, d in tool:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.Massless = true
		end
	end
	return tool
end

local function popEffect(position: Vector3)
	local part = Instance.new("Part")
	part.Name = "BTUnboxPop"
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(1.5, 1.5, 1.5)
	part.CFrame = CFrame.new(position)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(255, 215, 0)
	part.Transparency = 0.2
	part.Parent = boxesFolder

	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 255, 255))
	emitter.Size = NumberSequence.new(0.6, 0)
	emitter.Lifetime = NumberRange.new(0.5, 0.9)
	emitter.Speed = NumberRange.new(10, 18)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.Parent = part
	emitter:Emit(45)

	TweenService:Create(part, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(5, 5, 5),
		Transparency = 1,
	}):Play()
	Debris:AddItem(part, 1.2)
end

----------------------------------------------------------------------
-- বক্সের অবস্থা
----------------------------------------------------------------------
local function disconnectAll(record: BoxRecord)
	for _, conn in record.connections do
		conn:Disconnect()
	end
	table.clear(record.connections)
end

local function findHeldBox(ev: EventState, player: Player): BoxRecord?
	for _, record in ev.boxes do
		if record.state == "held" and record.holder == player then
			return record
		end
	end
	return nil
end

-- হাতে থাকা বক্স মাটিতে আগের জায়গায় ফেরত (মারা গেলে বা চলে গেলে, I4)।
local function returnToMap(record: BoxRecord)
	if record.state ~= "held" then
		return
	end
	record.state = "ground"
	disconnectAll(record)
	local tool = record.tool
	record.tool = nil
	record.holder = nil
	if tool and tool.Parent then
		tool:Destroy()
	end
	if current and current.boxes[record.id] == record then
		record.model = buildGroundModel(record)
	end
end

function EventManager._OnPickup(record: BoxRecord, player: Player)
	local ev = current
	if not ev or ev.boxes[record.id] ~= record or record.state ~= "ground" then
		return
	end
	if not pickupLimiter(player) then
		return
	end
	local character, humanoid, root = Util.GetLiveCharacter(player)
	if not character or not humanoid or not root then
		return
	end
	if (root.Position - record.position).Magnitude &gt; Config.BOX_PROMPT_DISTANCE + 8 then
		return
	end
	if findHeldBox(ev, player) then
		notify(player, "Warn", { text = "⚠️ আগের বক্সটা আগে খুলুন!" })
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end

	record.state = "held"
	record.holder = player
	record.heldSince = os.clock()
	if record.model then
		record.model:Destroy()
		record.model = nil
	end

	local tool = makeBoxTool(record)
	record.tool = tool
	tool.Parent = backpack
	-- R9: তোলার সাথে সাথে হাতে।
	humanoid:EquipTool(tool)

	table.insert(
		record.connections,
		tool.AncestryChanged:Connect(function()
			-- state অন্য কোথাও বদলাতে পারে, তাই টাইপ narrowing এড়াতে string হিসেবে পড়া।
			local state: string = record.state
			if state ~= "held" or record.tool ~= tool then
				return
			end
			local parent = tool.Parent
			local liveBackpack = player:FindFirstChildOfClass("Backpack")
			if not tool:IsDescendantOf(game) or (parent ~= liveBackpack and parent ~= player.Character) then
				returnToMap(record)
			end
		end)
	)
	table.insert(
		record.connections,
		humanoid.Died:Connect(function()
			returnToMap(record)
		end)
	)

	notify(player, "Pickup", { boxId = record.id, minOpenTime = Config.MIN_OPEN_TIME })
end

----------------------------------------------------------------------
-- টুল আসবে কিনা (R14)
----------------------------------------------------------------------
local function weightedPick(names: { string }, counts: { [string]: number }): string
	local total = 0
	for _, name in names do
		total += counts[name]
	end
	local roll = rng:NextNumber() * total
	for _, name in names do
		roll -= counts[name]
		if roll &lt;= 0 then
			return name
		end
	end
	return names[#names]
end

local function decideTool(ev: EventState, player: Player, openedBefore: number): string?
	local toolsLeft = 0
	local candidates = {}
	for name, count in ev.tools do
		if count &gt; 0 then
			toolsLeft += count
			table.insert(candidates, name)
		end
	end
	if toolsLeft == 0 then
		return nil
	end
	table.sort(candidates)

	local boxesLeft = ev.total - openedBefore -- এই বক্সসহ
	local forced = toolsLeft &gt;= boxesLeft
	if not forced then
		if openedBefore &lt; ev.safeCount then
			return nil
		end
		if ev.gapLeft &gt; 0 then
			ev.gapLeft -= 1
			return nil
		end
		if rng:NextNumber() &gt;= toolsLeft / boxesLeft then
			return nil
		end
	end

	local notOwned = {}
	for _, name in candidates do
		if not ToolData.PlayerOwns(player, name) then
			table.insert(notOwned, name)
		end
	end
	if #notOwned &gt; 0 then
		return weightedPick(notOwned, ev.tools)
	end
	if forced then
		return weightedPick(candidates, ev.tools)
	end
	-- তার কাছে সব টুল আগেই আছে: টুলটা পরের বক্সের জন্য থাকবে।
	return nil
end

local function giveCoins(player: Player): number
	local low = math.min(Config.COIN_REWARD_MIN, Config.COIN_REWARD_MAX)
	local high = math.max(Config.COIN_REWARD_MIN, Config.COIN_REWARD_MAX)
	local amount = rng:NextInteger(low, high)
	local stats = player:FindFirstChild("leaderstats")
	local currency = stats and stats:FindFirstChild(Config.CURRENCY_NAME)
	if currency and (currency:IsA("IntValue") or currency:IsA("NumberValue")) then
		currency.Value += amount
	else
		warn(`[BTToolsEvents] {player.Name} এর leaderstats এ '{Config.CURRENCY_NAME}' ভ্যালু নেই, টাকা যোগ হয়নি।`)
	end
	return amount
end

----------------------------------------------------------------------
-- বক্স খোলা
----------------------------------------------------------------------
local function onOpenRequest(player: Player, boxId: any)
	if type(boxId) ~= "number" or not openLimiter(player) then
		return
	end
	local ev = current
	if not ev then
		notify(player, "OpenFailed", { text = "ইভেন্ট শেষ হয়ে গেছে।" })
		return
	end
	local record = ev.boxes[boxId]
	if not record or record.state ~= "held" or record.holder ~= player then
		return
	end
	local tool = record.tool
	if not tool or tool.Parent ~= player.Character then
		notify(player, "OpenFailed", { text = "বক্সটা হাতে নিন।" })
		return
	end
	if os.clock() - record.heldSince &lt; Config.MIN_OPEN_TIME then
		notify(player, "OpenFailed", { text = "একটু অপেক্ষা করুন..." })
		return
	end

	record.state = "opened"
	disconnectAll(record)
	local handle = tool:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") then
		popEffect(handle.Position)
	end
	record.tool = nil
	record.holder = nil
	tool:Destroy()

	local openedBefore = ev.opened
	ev.opened += 1
	publishState()

	local toolName = decideTool(ev, player, openedBefore)
	if toolName then
		ev.tools[toolName] -= 1
		ev.gapLeft = ev.gap
		ToolData.Award(player, toolName)
		ToolData.AppendHistory(player.UserId, player.Name, toolName, "win")
		table.insert(ev.winners, { userId = player.UserId, name = player.DisplayName, tool = toolName })
		notify(player, "Result", { reward = "Tool", tool = toolName })
		AnnounceRemote:FireAllClients("Winner", {
			userId = player.UserId,
			name = player.DisplayName,
			tool = toolName,
		})
		Showcase.Show(player, toolName)
		Showcase.TagPlayer(player, toolName)
	else
		local amount = giveCoins(player)
		notify(player, "Result", { reward = "Coin", amount = amount, currency = Config.CURRENCY_NAME })
	end

	if ev.opened &gt;= ev.total then
		EventManager.Stop("all")
	end
end

----------------------------------------------------------------------
-- ইভেন্ট শুরু আর শেষ
----------------------------------------------------------------------
function EventManager.IsActive(): boolean
	return current ~= nil
end

function EventManager.Start(admin: Player, params: StartParams): (boolean, string)
	if current then
		return false, "একটা ইভেন্ট এখন চলছে। আগে STOP চাপুন।"
	end

	local toolTotal = 0
	for name, count in params.tools do
		if not ToolData.FindTool(name) then
			return false, `'{name}' টুলটা ServerStorage &gt; {Config.TOOLS_FOLDER_NAME} এ নেই।`
		end
		toolTotal += count
	end
	if toolTotal &lt; 1 then
		return false, "অন্তত একটা টুল বেছে নিন।"
	end
	if toolTotal &gt; params.totalBoxes then
		return false, "টুল বক্সের সংখ্যা মোট বক্সের চেয়ে বেশি।"
	end

	local _, _, root = Util.GetLiveCharacter(admin)
	local center = if root then root.Position else nil
	local positions, mode = BoxSpawner.FindPositions(
		params.totalBoxes,
		center,
		params.radius,
		{ boxesFolder, Showcase.GetFolder() }
	)
	if mode == "none" then
		return false, "কোনো স্পন জোন নেই, আর আপনার ক্যারেক্টারও পাওয়া যায়নি।"
	end
	if #positions == 0 then
		return false, "বক্স রাখার মতো কোনো জায়গা পাওয়া যায়নি।"
	end
	if #positions &lt; toolTotal then
		return false, `জায়গা কম: মাত্র {#positions} টা বক্স রাখা গেছে, কিন্তু টুল বক্স {toolTotal} টা। জোন বড় করুন।`
	end

	local total = #positions
	local ev: EventState = {
		total = total,
		opened = 0,
		safeCount = math.floor(total * params.safePercent / 100),
		gap = params.gap,
		gapLeft = 0,
		tools = table.clone(params.tools),
		boxes = {},
		endsAt = Workspace:GetServerTimeNow() + params.minutes * 60,
		winners = {},
	}
	current = ev

	for _, position in positions do
		nextBoxId += 1
		local record: BoxRecord = {
			id = nextBoxId,
			state = "ground",
			position = position,
			model = nil,
			holder = nil,
			tool = nil,
			heldSince = 0,
			connections = {},
		}
		ev.boxes[record.id] = record
		record.model = buildGroundModel(record)
	end

	publishState()
	AnnounceRemote:FireAllClients("Start", { total = total, endsAt = ev.endsAt })

	task.delay(params.minutes * 60, function()
		if current == ev then
			EventManager.Stop("time")
		end
	end)

	local where = if mode == "zones" then "স্পন জোনে" else "আপনার চারপাশে"
	local message = `✅ {where} {total} টা বক্স স্পন হয়েছে!`
	if total &lt; params.totalBoxes then
		message ..= ` ({params.totalBoxes} টা চেয়েছিলেন, জায়গা কম ছিল)`
	end
	return true, message
end

-- reason: "time" | "all" | "admin"
function EventManager.Stop(reason: string): boolean
	local ev = current
	if not ev then
		return false
	end
	current = nil
	for _, record in ev.boxes do
		disconnectAll(record)
		if record.model then
			record.model:Destroy()
			record.model = nil
		end
		if record.tool then
			record.tool:Destroy()
			record.tool = nil
		end
		record.state = "opened"
	end
	publishState()
	Showcase.ClearPlayerTags()
	AnnounceRemote:FireAllClients("End", { reason = reason, winners = ev.winners })
	return true
end

function EventManager.Init()
	local existing = Workspace:FindFirstChild("BTToolsEvents_Boxes")
	if existing then
		existing:Destroy()
	end
	boxesFolder = Instance.new("Folder")
	boxesFolder.Name = "BTToolsEvents_Boxes"
	boxesFolder.Parent = Workspace

	if not getBoxTemplate() then
		warn("[BTToolsEvents] ServerStorage &gt; BTToolsEvents &gt; GiftBoxTool নেই, সাধারণ বক্স ব্যবহার হবে।")
	end

	publishState()
	OpenBoxRemote.OnServerEvent:Connect(onOpenRequest)

	Players.PlayerRemoving:Connect(function(player)
		local ev = current
		local record = ev and findHeldBox(ev, player)
		if record then
			returnToMap(record)
		end
	end)
end

return EventManager
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBTF010493DC59741D4AA8B73120CFF1421"><Properties><string name="Name">Showcase</string><ProtectedString name="Source">--[[
	BT Tools Event: Showcase (ModuleScript, সার্ভার)

	বিজয়ীর বড় অবতার যেটা নাচে আর হাতে জেতা টুল ধরে থাকে (R13)।
	- জায়গা: Workspace &gt; WinnerShowcase পার্ট। পার্টের সামনের দিকে মুখ করে দাঁড়ায়।
	- পাশাপাশি সর্বোচ্চ ৩টা জায়গা: মাঝে, ডানে, বামে।
	- SHOWCASE_DURATION সেকেন্ড পরে ছোট হয়ে মিলিয়ে যায়।
	- মাথার ওপরে "👑 WINNER" ট্যাগ থাকে, countdown বারসহ। রং Config.THEME অনুযায়ী।
	  বারটা ক্লায়েন্টে চলে (WinnerTags মডিউল), তাই সার্ভারের ওপর কোনো চাপ নেই।
	আসল বিজয়ীর মাথার ওপরের ছোট ট্যাগও এখানে তৈরি হয়।
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("BTToolsEvents")
local Config = require(Shared:WaitForChild("Config"))
local ToolData = require(script.Parent:WaitForChild("ToolData"))

local TAG_NAME = "BTWinnerTag"
local SLOT_ORDER = { 0, 1, -1, 2, -2, 3, -3 }


type Slot = {
	userId: number,
	index: number,
	model: Model?,
	tag: BillboardGui?,
	tools: { string },
	displayName: string,
	token: number,
	removed: boolean,
	createdAt: number,
}

local Showcase = {}

local folder: Folder
local slots: { [number]: Slot } = {}
local byUser: { [number]: Slot } = {}
local playerTags: { [Player]: { conn: RBXScriptConnection, tools: { string } } } = {}
local nextToken = 0

----------------------------------------------------------------------
-- ট্যাগের ডিজাইন
----------------------------------------------------------------------
local function new(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	for key, value in props do
		(inst :: any)[key] = value
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	return inst
end

-- থিমের accent দিয়ে gradient (Config.THEME অনুযায়ী)।
local function accentGradient(rotation: number): UIGradient
	local theme = Config.GetTheme()
	return new("UIGradient", {
		Rotation = rotation,
		Color = ColorSequence.new(theme.Accent, theme.AccentDeep),
	})
end

local function textLabel(name: string, text: string, posY: number, height: number, color: Color3, font: Enum.Font): TextLabel
	return new("TextLabel", {
		Name = name,
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, posY),
		Size = UDim2.fromScale(0.86, height),
		Font = font,
		Text = text,
		TextColor3 = color,
		TextScaled = true,
		TextTruncate = Enum.TextTruncate.AtEnd,
	})
end

local function toolsText(tools: { string }): string
	return "জিতেছে · " .. table.concat(tools, ", ")
end

-- big = শোকেসের ডামি (countdown সহ), না হলে প্লেয়ারের মাথার ছোট ট্যাগ।
-- রং আসে Config.THEME থেকে, তাই UI এর সাথে মিলে যায়।
local function buildTag(displayName: string, tools: { string }, big: boolean): BillboardGui
	local theme = Config.GetTheme()
	local width, height = if big then 13 else 6, if big then 5.6 else 2.4

	local title = textLabel("Title", "👑  WINNER", 0.1, if big then 0.17 else 0.26, Color3.new(1, 1, 1), Enum.Font.BuilderSansExtraBold)
	accentGradient(0).Parent = title

	local card = new("Frame", {
		Name = "Card",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.Background,
		BackgroundTransparency = math.min(0.4, theme.Glass + 0.06),
		BorderSizePixel = 0,
	}, {
		new("UICorner", { CornerRadius = UDim.new(0.16, 0) }),
		new("UIStroke", { Color = theme.Accent, Thickness = 2, Transparency = 0.25 }),
		title,
		textLabel(
			"PlayerName",
			displayName,
			if big then 0.3 else 0.4,
			if big then 0.24 else 0.32,
			theme.Text,
			Enum.Font.BuilderSansBold
		),
		textLabel(
			"ToolText",
			toolsText(tools),
			if big then 0.56 else 0.74,
			if big then 0.13 else 0.18,
			theme.SubText,
			Enum.Font.BuilderSansMedium
		),
	})

	if big then
		local barBack = new("Frame", {
			Name = "BarBack",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0.07, 0.83),
			Size = UDim2.fromScale(0.7, 0.06),
			BackgroundColor3 = theme.Surface,
			BorderSizePixel = 0,
		}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		local fill = new("Frame", {
			Name = "BarFill",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
		}, { new("UICorner", { CornerRadius = UDim.new(1, 0) }) })
		accentGradient(0).Parent = fill
		fill.Parent = barBack
		barBack.Parent = card
		local timeText = textLabel("TimeText", `{Config.SHOWCASE_DURATION}s`, 0, 0.14, theme.SubText, Enum.Font.BuilderSansBold)
		timeText.AnchorPoint = Vector2.new(0, 0.5)
		timeText.Position = UDim2.fromScale(0.8, 0.83)
		timeText.Size = UDim2.fromScale(0.13, 0.14)
		timeText.TextXAlignment = Enum.TextXAlignment.Right
		timeText.Parent = card
	end

	local billboard = new("BillboardGui", {
		Name = "BTWinnerTag",
		Size = UDim2.fromScale(width, height),
		-- ট্যাগের নিচের কিনারা মাথার একটু ওপরে থাকবে।
		StudsOffset = Vector3.new(0, height / 2 + (if big then 2 else 1), 0),
		AlwaysOnTop = true,
		LightInfluence = 0,
		MaxDistance = if big then 400 else 150,
		ResetOnSpawn = false,
	}, { card })
	CollectionService:AddTag(billboard, TAG_NAME)
	return billboard
end

local function updateTagText(tag: BillboardGui?, tools: { string })
	local card = tag and tag:FindFirstChild("Card")
	local label = card and card:FindFirstChild("ToolText")
	if label and label:IsA("TextLabel") then
		label.Text = toolsText(tools)
	end
end

----------------------------------------------------------------------
-- আসল প্লেয়ারের মাথার ট্যাগ (S6)
----------------------------------------------------------------------
local function attachPlayerTag(player: Player, tools: { string })
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("BTWinnerTag")
	if old then
		old:Destroy()
	end
	local tag = buildTag(player.DisplayName, tools, false)
	tag.Adornee = head
	tag.Parent = head
end

function Showcase.TagPlayer(player: Player, toolName: string)
	if not Config.WINNER_TAG_ON_PLAYER then
		return
	end
	local info = playerTags[player]
	if info then
		table.insert(info.tools, toolName)
	else
		local tools = { toolName }
		local conn = player.CharacterAdded:Connect(function(character)
			character:WaitForChild("Head", 10)
			attachPlayerTag(player, tools)
		end)
		info = { conn = conn, tools = tools }
		playerTags[player] = info
	end
	attachPlayerTag(player, info.tools)
end

function Showcase.ClearPlayerTags()
	for player, info in playerTags do
		info.conn:Disconnect()
		local head = player.Character and player.Character:FindFirstChild("Head")
		local tag = head and head:FindFirstChild("BTWinnerTag")
		if tag then
			tag:Destroy()
		end
	end
	table.clear(playerTags)
end

----------------------------------------------------------------------
-- শোকেসের ডামি
----------------------------------------------------------------------
local function getShowcasePart(): BasePart?
	local part = Workspace:FindFirstChild(Config.SHOWCASE_PART_NAME, true)
	if part and part:IsA("BasePart") then
		return part
	end
	return nil
end

local function slotCFrame(part: BasePart, index: number): CFrame
	local offset = SLOT_ORDER[index] * Config.SLOT_SPACING
	local top = part.CFrame * CFrame.new(offset, part.Size.Y / 2, 0)
	local look = part.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude &lt; 0.01 then
		flatLook = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(top.Position, top.Position + flatLook.Unit)
end

local function getDescription(player: Player?, userId: number): HumanoidDescription
	local ok, description = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(userId)
	end)
	if ok and description then
		return description
	end
	local humanoid = player and player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local ok2, applied = pcall(function()
			return humanoid:GetAppliedDescription()
		end)
		if ok2 and applied then
			return applied
		end
	end
	return Instance.new("HumanoidDescription")
end

-- টুলের একটা শুধু-দেখার কপি ডামির ডান হাতে লাগায় (S1)। স্ক্রিপ্ট আর রিমোট মুছে ফেলা হয়।
local function attachDisplayTool(dummy: Model, toolName: string, scale: number)
	local source = ToolData.FindTool(toolName)
	local hand = dummy:FindFirstChild("RightHand")
	if not source or not hand or not hand:IsA("BasePart") then
		return
	end
	local clone = source:Clone()
	local handle = clone:FindFirstChild("Handle")
	if not handle or not handle:IsA("BasePart") then
		clone:Destroy()
		return
	end
	local grip = clone.Grip

	local holder = Instance.new("Model")
	holder.Name = "HeldTool"
	for _, child in clone:GetChildren() do
		child.Parent = holder
	end
	clone:Destroy()

	for _, d in holder:GetDescendants() do
		if
			d:IsA("LuaSourceContainer")
			or d:IsA("RemoteEvent")
			or d:IsA("RemoteFunction")
			or d:IsA("BindableEvent")
			or d:IsA("BindableFunction")
			or d:IsA("ProximityPrompt")
			or d:IsA("ClickDetector")
			or d:IsA("JointInstance")
			or d:IsA("WeldConstraint")
		then
			d:Destroy()
		end
	end
	for _, d in holder:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Massless = true
			if d:IsA("Seat") then
				d.Disabled = true
			end
		end
	end

	holder.PrimaryPart = handle
	holder:ScaleTo(scale)
	local gripAttachment = hand:FindFirstChild("RightGripAttachment")
	local gripOffset = if gripAttachment and gripAttachment:IsA("Attachment")
		then gripAttachment.CFrame
		else CFrame.new(0, -hand.Size.Y / 2, 0)
	local scaledGrip = CFrame.new(grip.Position * scale) * grip.Rotation
	holder:PivotTo(hand.CFrame * gripOffset * scaledGrip:Inverse())

	for _, d in holder:GetDescendants() do
		if d:IsA("BasePart") and d ~= handle then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = d
			weld.Parent = d
		end
	end
	local handWeld = Instance.new("WeldConstraint")
	handWeld.Part0 = hand
	handWeld.Part1 = handle
	handWeld.Parent = handle
	holder.Parent = dummy
end

local function poof(position: Vector3)
	local part = Instance.new("Part")
	part.Name = "BTPoof"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.CFrame = CFrame.new(position)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
	local theme = Config.GetTheme()
	emitter.Color = ColorSequence.new(theme.Accent, theme.AccentDeep)
	emitter.Size = NumberSequence.new(3, 6)
	emitter.Transparency = NumberSequence.new(0.2, 1)
	emitter.Lifetime = NumberRange.new(0.6, 1)
	emitter.Speed = NumberRange.new(6, 12)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Rate = 0
	emitter.Parent = part
	part.Parent = folder
	emitter:Emit(40)
	task.delay(1.5, function()
		part:Destroy()
	end)
end

-- t সেকেন্ড ধরে প্রতি ফ্রেমে f(alpha) চালায়।
local function animate(duration: number, style: Enum.EasingStyle, direction: Enum.EasingDirection, f: (number) -&gt; ())
	local start = os.clock()
	while true do
		local alpha = math.clamp((os.clock() - start) / duration, 0, 1)
		f(TweenService:GetValue(alpha, style, direction))
		if alpha &gt;= 1 then
			break
		end
		RunService.Heartbeat:Wait()
	end
end

local function removeSlot(slot: Slot, quick: boolean)
	if slot.removed then
		return
	end
	slot.removed = true
	if slots[slot.index] == slot then
		slots[slot.index] = nil
	end
	if byUser[slot.userId] == slot then
		byUser[slot.userId] = nil
	end
	local model = slot.model
	if not model or not model.Parent then
		return
	end
	poof(model:GetPivot().Position)
	if quick then
		model:Destroy()
		return
	end
	task.spawn(function()
		local scale = model:GetScale()
		animate(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In, function(a)
			if model.Parent then
				model:ScaleTo(math.max(scale * (1 - a), 0.05))
			end
		end)
		model:Destroy()
	end)
end

local function scheduleExpiry(slot: Slot)
	nextToken += 1
	local token = nextToken
	slot.token = token
	local expiresAt = Workspace:GetServerTimeNow() + Config.SHOWCASE_DURATION
	if slot.tag then
		slot.tag:SetAttribute("ExpiresAt", expiresAt)
		slot.tag:SetAttribute("Duration", Config.SHOWCASE_DURATION)
	end
	task.delay(Config.SHOWCASE_DURATION, function()
		if slot.token == token then
			removeSlot(slot, false)
		end
	end)
end

local function buildDummy(slot: Slot, player: Player?, part: BasePart)
	local description = getDescription(player, slot.userId)
	local ok, dummy = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not dummy then
		warn(`[BTToolsEvents] শোকেসের অবতার বানানো যায়নি: {dummy}`)
		removeSlot(slot, true)
		return
	end
	if slot.removed then
		dummy:Destroy()
		return
	end

	dummy.Name = "Winner_" .. slot.displayName
	dummy.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	local humanoid = dummy:FindFirstChildOfClass("Humanoid")
	local root = dummy:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		dummy:Destroy()
		removeSlot(slot, true)
		return
	end
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	for _, d in dummy:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Anchored = d == root
		end
	end

	local scale = Config.SHOWCASE_SCALE
	dummy:ScaleTo(scale)

	-- পা যেন ঠিক পার্টের ওপরে থাকে।
	local target = slotCFrame(part, slot.index)
	dummy:PivotTo(target)
	local boxCFrame, boxSize = dummy:GetBoundingBox()
	local lift = target.Position.Y - (boxCFrame.Position.Y - boxSize.Y / 2)
	local finalCFrame = target + Vector3.new(0, lift, 0)
	local startCFrame = finalCFrame - Vector3.new(0, boxSize.Y, 0)
	dummy:PivotTo(startCFrame)

	attachDisplayTool(dummy, slot.tools[1], scale)

	local head = dummy:FindFirstChild("Head")
	local tag = buildTag(slot.displayName, slot.tools, true)
	tag.Adornee = if head and head:IsA("BasePart") then head else root
	tag.Parent = dummy
	slot.tag = tag
	slot.model = dummy
	dummy.Parent = folder
	scheduleExpiry(slot)

	-- মাটির নিচ থেকে উঠে আসা।
	animate(0.9, Enum.EasingStyle.Back, Enum.EasingDirection.Out, function(a)
		if dummy.Parent then
			dummy:PivotTo(startCFrame:Lerp(finalCFrame, a))
		end
	end)

	if not dummy.Parent then
		return
	end
	if Config.IsSoundSet(Config.DANCE_ANIMATION_ID) then
		local animator = humanoid:FindFirstChildOfClass("Animator")
		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end
		local animation = Instance.new("Animation")
		animation.AnimationId = Config.DANCE_ANIMATION_ID
		local okTrack, track = pcall(function()
			return (animator :: Animator):LoadAnimation(animation)
		end)
		if okTrack and track then
			track.Priority = Enum.AnimationPriority.Action
			track.Looped = true
			track:Play()
		else
			warn(`[BTToolsEvents] নাচের অ্যানিমেশন লোড হয়নি: {track}`)
		end
	else
		warn("[BTToolsEvents] Config.DANCE_ANIMATION_ID দেওয়া হয়নি, অবতার নাচবে না।")
	end
end

function Showcase.Show(player: Player, toolName: string)
	local part = getShowcasePart()
	if not part then
		warn(`[BTToolsEvents] Workspace এ '{Config.SHOWCASE_PART_NAME}' পার্ট নেই, শোকেস দেখানো হবে না।`)
		return
	end

	-- একই প্লেয়ার আবার জিতলে নতুন অবতার না, আগেরটাই রিফ্রেশ।
	local existing = byUser[player.UserId]
	if existing and not existing.removed then
		table.insert(existing.tools, toolName)
		updateTagText(existing.tag, existing.tools)
		if existing.model then
			scheduleExpiry(existing)
		end
		return
	end

	local maxSlots = math.clamp(Config.MAX_SHOWCASE_SLOTS, 1, #SLOT_ORDER)
	local index: number? = nil
	for i = 1, maxSlots do
		if not slots[i] then
			index = i
			break
		end
	end
	if not index then
		-- সব জায়গা ভরা: সবচেয়ে পুরনোটা আগেই বিদায় নেবে।
		local oldest: Slot? = nil
		for _, slot in slots do
			if not oldest or slot.createdAt &lt; oldest.createdAt then
				oldest = slot
			end
		end
		if oldest then
			index = oldest.index
			removeSlot(oldest, true)
		end
	end
	if not index then
		return
	end

	local slot: Slot = {
		userId = player.UserId,
		index = index,
		model = nil,
		tag = nil,
		tools = { toolName },
		displayName = player.DisplayName,
		token = 0,
		removed = false,
		createdAt = os.clock(),
	}
	slots[index] = slot
	byUser[player.UserId] = slot
	task.spawn(buildDummy, slot, player, part)
end

function Showcase.GetFolder(): Folder
	return folder
end

function Showcase.HasShowcasePart(): boolean
	return getShowcasePart() ~= nil
end

function Showcase.Init()
	local existing = Workspace:FindFirstChild("BTToolsEvents_Showcase")
	if existing then
		existing:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "BTToolsEvents_Showcase"
	folder.Parent = Workspace

	local part = getShowcasePart()
	if part then
		part.Anchored = true
		part.Transparency = 1
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
	end

	Players.PlayerRemoving:Connect(function(player)
		local info = playerTags[player]
		if info then
			info.conn:Disconnect()
			playerTags[player] = nil
		end
	end)
end

return Showcase
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBTF6C60EF418DD4D399409A5191A59D23D"><Properties><string name="Name">ToolData</string><ProtectedString name="Source">--[[
	BT Tools Event: ToolData (ModuleScript, সার্ভার)

	কে কোন টুল পার্মানেন্ট পেয়েছে সেটা ডেটাস্টোরে রাখে, আর প্লেয়ারকে টুল দেয়।

	ডেটা সেভের নিয়ম:
	- প্রতি প্লেয়ারের একটা key: "u_&lt;UserId&gt;"।
	  মান: { Version, UserId, Name, Tools = { "Handcuffs", ... }, UpdatedAt }
	- প্রতিটা পরিবর্তন (টুল যোগ বা সরানো) UpdateAsync দিয়ে হয়। স্টোরে যা আছে তার সাথে
	  মিলিয়ে লেখা হয়, পুরো লিস্ট কখনো ওভাররাইট হয় না। তাই লোড ফেল করলেও পুরনো টুল মুছবে না।
	- লেখা ফেল করলে পরিবর্তনটা queue তে থাকে, পরে আবার চেষ্টা হয়, সার্ভার বন্ধের সময়ও (BindToClose)।

	টুল দেওয়ার নিয়ম (ডাবল টুল কখনো না):
	- GiveCopy একমাত্র ফাংশন যেটা টুল দেয়। দেওয়ার আগে Backpack / Character / StarterGear চেক করে,
	  টুলটা থাকলে আর দেয় না।
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("BTToolsEvents")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(script.Parent:WaitForChild("Util"))

local SCHEMA_VERSION = 1
local HISTORY_KEY = "Log"
local SAVE_ATTEMPTS = 5

type Change = { op: "add" | "remove", tool: string, name: string? }
type Entry = { loaded: boolean, tools: { [string]: boolean } }

local ToolData = {}

local store: DataStore? = nil
local historyStore: DataStore? = nil
local dataStoreDisabled = false

local cache: { [Player]: Entry } = {}
-- ফেল হওয়া পরিবর্তন: userId -&gt; পরিবর্তনের লিস্ট (ক্রম অনুযায়ী)
local pending: { [number]: { Change } } = {}

----------------------------------------------------------------------
-- ডেটাস্টোর
----------------------------------------------------------------------
local function isFatalStoreError(message: string): boolean
	-- Studio তে API Services বন্ধ থাকলে আবার চেষ্টা করে লাভ নেই।
	if string.find(message, "StudioAccessToApisNotAllowed", 1, true) or string.find(message, "403", 1, true) then
		if not dataStoreDisabled then
			dataStoreDisabled = true
			warn(
				"[BTToolsEvents] ডেটাস্টোর কাজ করছে না। Studio তে টেস্ট করলে Game Settings &gt; Security &gt; "
					.. "'Enable Studio Access to API Services' চালু করুন। এখন টুল শুধু এই সেশনের জন্য থাকবে।"
			)
		end
		return true
	end
	return false
end

local function keyFor(userId: number): string
	return "u_" .. tostring(userId)
end

local function toolSetFromData(data: any): { [string]: boolean }
	local set = {}
	if type(data) == "table" and type(data.Tools) == "table" then
		for _, name in data.Tools do
			if type(name) == "string" then
				set[name] = true
			end
		end
	end
	return set
end

local function sortedList(set: { [string]: boolean }): { string }
	local list = {}
	for name in set do
		table.insert(list, name)
	end
	table.sort(list)
	return list
end

-- স্টোরে থাকা পুরনো মানের সাথে একটা পরিবর্তন মিলিয়ে নতুন মান বানায় (yield করে না)।
local function applyChanges(old: any, userId: number, changes: { Change }): any
	local set = toolSetFromData(old)
	local name = if type(old) == "table" and type(old.Name) == "string" then old.Name else nil
	for _, change in changes do
		if change.op == "add" then
			set[change.tool] = true
		else
			set[change.tool] = nil
		end
		name = change.name or name
	end
	return {
		Version = SCHEMA_VERSION,
		UserId = userId,
		Name = name,
		Tools = sortedList(set),
		UpdatedAt = os.time(),
	}
end

local function writeChanges(userId: number, changes: { Change }): boolean
	if dataStoreDisabled or not store then
		return false
	end
	local activeStore = store
	local ok = Util.Retry("টুল সেভ", SAVE_ATTEMPTS, function()
		activeStore:UpdateAsync(keyFor(userId), function(old)
			return applyChanges(old, userId, changes)
		end)
	end, isFatalStoreError)
	return ok
end

-- লেখার চেষ্টা করে, ফেল করলে queue তে রাখে।
local function commitChange(userId: number, change: Change)
	local queue = pending[userId]
	if queue then
		-- আগের পরিবর্তন এখনো বাকি, ক্রম ঠিক রাখতে এটাও পেছনে যোগ হবে।
		table.insert(queue, change)
		return
	end
	if not writeChanges(userId, { change }) then
		pending[userId] = { change }
	end
end

local function flushPending()
	for userId, queue in pending do
		pending[userId] = nil
		if not writeChanges(userId, queue) then
			-- এর মধ্যে নতুন পরিবর্তন এসে থাকলে সেগুলো পেছনে থাকবে।
			local newer = pending[userId]
			if newer then
				for _, change in newer do
					table.insert(queue, change)
				end
			end
			pending[userId] = queue
		end
	end
end

local function loadTools(userId: number): { [string]: boolean }?
	if dataStoreDisabled or not store then
		return nil
	end
	local activeStore = store
	local ok, data = Util.Retry("টুল লোড", SAVE_ATTEMPTS, function()
		return activeStore:GetAsync(keyFor(userId))
	end, isFatalStoreError)
	if not ok then
		return nil
	end
	local set = toolSetFromData(data)
	-- এই সার্ভারে এখনো লেখা বাকি এমন পরিবর্তনগুলোও হিসাবে ধরা।
	local queue = pending[userId]
	if queue then
		for _, change in queue do
			set[change.tool] = if change.op == "add" then true else nil
		end
	end
	return set
end

----------------------------------------------------------------------
-- টুল আর ইনভেন্টরি
----------------------------------------------------------------------
function ToolData.GetToolsFolder(): Folder?
	local folder = ServerStorage:FindFirstChild(Config.TOOLS_FOLDER_NAME)
	if folder and folder:IsA("Folder") then
		return folder
	end
	return nil
end

function ToolData.FindTool(toolName: string): Tool?
	local folder = ToolData.GetToolsFolder()
	local tool = folder and folder:FindFirstChild(toolName)
	if tool and tool:IsA("Tool") then
		return tool
	end
	return nil
end

function ToolData.ListToolNames(): { string }
	local names = {}
	local folder = ToolData.GetToolsFolder()
	if folder then
		for _, child in folder:GetChildren() do
			if child:IsA("Tool") then
				table.insert(names, child.Name)
			end
		end
	end
	table.sort(names)
	return names
end

local function containersOf(player: Player): { Instance }
	local list = {}
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		table.insert(list, backpack)
	end
	if player.Character then
		table.insert(list, player.Character)
	end
	local starterGear = player:FindFirstChild("StarterGear")
	if starterGear then
		table.insert(list, starterGear)
	end
	return list
end

-- টুলটা প্লেয়ারের Backpack / হাতে / StarterGear এ আছে কিনা।
function ToolData.HasInInventory(player: Player, toolName: string): boolean
	for _, container in containersOf(player) do
		local found = container:FindFirstChild(toolName)
		if found and found:IsA("Tool") then
			return true
		end
	end
	return false
end

-- টুলটা প্লেয়ারের কাছে আছে কিনা (ইনভেন্টরিতে, অথবা সেভ করা লিস্টে)।
function ToolData.PlayerOwns(player: Player, toolName: string): boolean
	if ToolData.HasInInventory(player, toolName) then
		return true
	end
	local entry = cache[player]
	return entry ~= nil and entry.tools[toolName] == true
end

-- একমাত্র ফাংশন যেটা টুল দেয়। আগে থেকে থাকলে দেয় না। দিলে true ফেরত দেয়।
function ToolData.GiveCopy(player: Player, toolName: string): boolean
	if ToolData.HasInInventory(player, toolName) then
		return false
	end
	local source = ToolData.FindTool(toolName)
	if not source then
		warn(`[BTToolsEvents] '{toolName}' টুলটা ServerStorage &gt; {Config.TOOLS_FOLDER_NAME} এ পাওয়া যায়নি।`)
		return false
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return false
	end
	source:Clone().Parent = backpack
	-- StarterGear এ রাখলে respawn এর পরে Roblox নিজেই টুলটা আবার দেবে।
	local starterGear = player:FindFirstChild("StarterGear")
	if starterGear then
		source:Clone().Parent = starterGear
	end
	return true
end

function ToolData.RemoveCopies(player: Player, toolName: string)
	for _, container in containersOf(player) do
		for _, child in container:GetChildren() do
			if child:IsA("Tool") and child.Name == toolName then
				child:Destroy()
			end
		end
	end
end

----------------------------------------------------------------------
-- জেতা আর অ্যাডমিনের কাজ
----------------------------------------------------------------------
-- ইভেন্টে জিতলে: সেভ করে আর (না থাকলে) টুল দেয়।
function ToolData.Award(player: Player, toolName: string)
	local entry = cache[player]
	if entry then
		entry.tools[toolName] = true
	end
	ToolData.GiveCopy(player, toolName)
	local userId, name = player.UserId, player.Name
	task.spawn(commitChange, userId, { op = "add", tool = toolName, name = name } :: Change)
end

-- অ্যাডমিন UserId দিয়ে টুল দেয় বা সরায় (প্লেয়ার অফলাইন হলেও)। ডেটাস্টোরে লেখা হলে true দেয়।
function ToolData.AdminSetOwned(userId: number, toolName: string, owned: boolean): (boolean, string)
	local player = Players:GetPlayerByUserId(userId)
	local change: Change = { op = if owned then "add" else "remove", tool = toolName, name = player and player.Name }

	if player then
		local entry = cache[player]
		if entry then
			entry.tools[toolName] = if owned then true else nil
		end
		if owned then
			ToolData.GiveCopy(player, toolName)
		else
			ToolData.RemoveCopies(player, toolName)
		end
	end

	if pending[userId] then
		table.insert(pending[userId], change)
		return false, "ডেটাস্টোর এখন ব্যস্ত, পরিবর্তনটা পরে সেভ হবে।"
	end
	if writeChanges(userId, { change }) then
		return true, "সেভ হয়েছে।"
	end
	if dataStoreDisabled then
		return false, "ডেটাস্টোর বন্ধ (Studio API Access চালু করুন)।"
	end
	pending[userId] = { change }
	return false, "এখন সেভ করা যায়নি, পরে আবার চেষ্টা হবে।"
end

-- একজন প্লেয়ারের সেভ করা টুলের লিস্ট (অ্যাডমিন প্যানেলের জন্য)।
function ToolData.GetSavedTools(userId: number): { string }?
	local player = Players:GetPlayerByUserId(userId)
	local entry = player and cache[player]
	if entry and entry.loaded then
		return sortedList(entry.tools)
	end
	local set = loadTools(userId)
	return set and sortedList(set)
end

----------------------------------------------------------------------
-- ইতিহাস (R16): একটা key, ভেতরে UserId অনুযায়ী ভাগ করা, তাই একজনের সব তথ্য এক জায়গায়।
-- { Version = 2, Users = { ["&lt;UserId&gt;"] = { n = নাম, last = সময়, r = { { t, k, at, by } } } } }
-- k: "win" (ইভেন্টে জেতা) | "gift" (অ্যাডমিন দিয়েছেন) | "remove" (অ্যাডমিন সরিয়েছেন)
----------------------------------------------------------------------
export type HistoryKind = "win" | "gift" | "remove"

local HISTORY_VERSION = 2

-- পুরনো লাইন-লাইন ফরম্যাট ({ {u, n, t, at}, ... }) থাকলে নতুন ফরম্যাটে নিয়ে নেয়, কিছু হারায় না।
local function normalizeHistory(old: any): { Version: number, Users: { [string]: any } }
	if type(old) == "table" and old.Version == HISTORY_VERSION and type(old.Users) == "table" then
		return old
	end
	local users: { [string]: any } = {}
	if type(old) == "table" then
		for _, entry in ipairs(old) do
			if type(entry) == "table" and type(entry.u) == "number" then
				local key = tostring(entry.u)
				local user = users[key] or { n = entry.n, last = 0, r = {} }
				users[key] = user
				table.insert(user.r, { t = entry.t, k = "win", at = entry.at })
				user.last = math.max(user.last, tonumber(entry.at) or 0)
				user.n = entry.n or user.n
			end
		end
	end
	return { Version = HISTORY_VERSION, Users = users }
end

local function addHistoryRecord(old: any, userId: number, playerName: string?, toolName: string, kind: HistoryKind, by: string?): any
	local data = normalizeHistory(old)
	local key = tostring(userId)
	local now = os.time()
	local user = data.Users[key] or { n = playerName, last = now, r = {} }
	data.Users[key] = user
	user.n = playerName or user.n
	user.last = now
	table.insert(user.r, { t = toolName, k = kind, at = now, by = by })
	while #user.r &gt; Config.HISTORY_MAX_RECORDS_PER_USER do
		table.remove(user.r, 1)
	end

	-- সীমার বেশি প্লেয়ার হলে যার শেষ রেকর্ড সবচেয়ে পুরনো সে বাদ।
	local count = 0
	for _ in data.Users do
		count += 1
	end
	while count &gt; Config.HISTORY_MAX_USERS do
		local oldestKey, oldestTime = nil, math.huge
		for userKey, info in data.Users do
			local last = tonumber(info.last) or 0
			if last &lt; oldestTime then
				oldestKey, oldestTime = userKey, last
			end
		end
		if not oldestKey then
			break
		end
		data.Users[oldestKey] = nil
		count -= 1
	end
	return data
end

function ToolData.AppendHistory(userId: number, playerName: string?, toolName: string, kind: HistoryKind, by: string?)
	if dataStoreDisabled or not historyStore then
		return
	end
	local activeStore = historyStore
	task.spawn(function()
		Util.Retry("ইতিহাস সেভ", 3, function()
			activeStore:UpdateAsync(HISTORY_KEY, function(old)
				return addHistoryRecord(old, userId, playerName, toolName, kind, by)
			end)
		end, isFatalStoreError)
	end)
end

-- সবচেয়ে সাম্প্রতিক limit জন প্লেয়ার। onlyUserId দিলে শুধু সেই প্লেয়ার।
-- ফেরত: { { u = UserId, n = নাম, last = সময়, r = রেকর্ড (নতুনটা আগে) } }
function ToolData.GetHistory(limit: number, onlyUserId: number?): { any }?
	if dataStoreDisabled or not historyStore then
		return nil
	end
	local activeStore = historyStore
	local ok, raw = Util.Retry("ইতিহাস লোড", 3, function()
		return activeStore:GetAsync(HISTORY_KEY)
	end, isFatalStoreError)
	if not ok then
		return nil
	end
	local data = normalizeHistory(raw)
	local result = {}
	for key, info in data.Users do
		local userId = tonumber(key)
		if userId and (not onlyUserId or onlyUserId == userId) and type(info) == "table" then
			local records = {}
			if type(info.r) == "table" then
				for i = #info.r, 1, -1 do
					table.insert(records, info.r[i])
				end
			end
			table.insert(result, { u = userId, n = info.n, last = tonumber(info.last) or 0, r = records })
		end
	end
	table.sort(result, function(a, b)
		return a.last &gt; b.last
	end)
	while #result &gt; limit do
		table.remove(result)
	end
	return result
end

----------------------------------------------------------------------
-- গেমে ঢোকা আর বের হওয়া
----------------------------------------------------------------------
local function grantSavedTools(player: Player, entry: Entry)
	-- ক্যারেক্টার আর Backpack তৈরি হওয়া পর্যন্ত অপেক্ষা (সর্বোচ্চ ৩০ সেকেন্ড)।
	local deadline = os.clock() + 30
	while player.Parent and not (player.Character and player:FindFirstChildOfClass("Backpack")) do
		if os.clock() &gt; deadline then
			return
		end
		task.wait(0.5)
	end
	if not player.Parent then
		return
	end
	for toolName in entry.tools do
		ToolData.GiveCopy(player, toolName)
	end
end

local function onPlayerAdded(player: Player)
	local joinedAt = os.clock()
	local entry: Entry = { loaded = false, tools = {} }
	cache[player] = entry

	local loaded = loadTools(player.UserId)
	-- লোড ফেল করলে ব্যাকগ্রাউন্ডে আবার চেষ্টা (প্লেয়ার গেমে থাকা পর্যন্ত)।
	while not loaded and player.Parent and not dataStoreDisabled do
		task.wait(15)
		loaded = loadTools(player.UserId)
	end
	if not player.Parent or cache[player] ~= entry then
		return
	end
	if loaded then
		-- লোডের সময় যদি এই সেশনে নতুন টুল জিতে থাকে, সেগুলোও থাকবে।
		for toolName in loaded do
			entry.tools[toolName] = true
		end
	end
	entry.loaded = true

	-- R6: গেমে ঢোকার কিছুক্ষণ পরে দেওয়া, যাতে গেমের অন্য সিস্টেম আগে নিজের টুল দিতে পারে।
	local remaining = Config.JOIN_GRANT_DELAY - (os.clock() - joinedAt)
	if remaining &gt; 0 then
		task.wait(remaining)
	end
	grantSavedTools(player, entry)
end

function ToolData.Init()
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(Config.DATASTORE_NAME)
		historyStore = DataStoreService:GetDataStore(Config.HISTORY_DATASTORE_NAME)
	end)
	if not ok then
		isFatalStoreError(tostring(err))
		if not dataStoreDisabled then
			warn(`[BTToolsEvents] ডেটাস্টোর চালু করা যায়নি: {err}`)
			dataStoreDisabled = true
		end
	end

	if not ToolData.GetToolsFolder() then
		warn(`[BTToolsEvents] ServerStorage এ '{Config.TOOLS_FOLDER_NAME}' ফোল্ডার নেই। পুরস্কারের টুলগুলো সেখানে রাখুন।`)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		cache[player] = nil
	end)

	-- বাকি থাকা সেভগুলো প্রতি ৩০ সেকেন্ডে আবার চেষ্টা।
	task.spawn(function()
		while true do
			task.wait(30)
			if next(pending) then
				flushPending()
			end
		end
	end)

	game:BindToClose(function()
		if not next(pending) or RunService:IsStudio() then
			return
		end
		local running = 0
		for userId, queue in pending do
			pending[userId] = nil
			running += 1
			task.spawn(function()
				writeChanges(userId, queue)
				running -= 1
			end)
		end
		local deadline = os.clock() + 25
		while running &gt; 0 and os.clock() &lt; deadline do
			task.wait(0.2)
		end
	end)
end

return ToolData
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBT987DA021496E4E00B9CDA6FE2BA93949"><Properties><string name="Name">Util</string><ProtectedString name="Source">--[[
	BT Tools Event: Util (ModuleScript, সার্ভার)
	ছোট ছোট সাহায্যকারী ফাংশন: retry, rate limit, ক্যারেক্টার খোঁজা।
]]

local Players = game:GetService("Players")

local Util = {}

-- fn কে pcall দিয়ে চালায়, ফেল করলে exponential backoff দিয়ে আবার চেষ্টা করে।
-- shouldStop(err) true দিলে আর চেষ্টা করে না (যেমন Studio তে API বন্ধ থাকলে)।
function Util.Retry(label: string, attempts: number, fn: () -&gt; any, shouldStop: ((string) -&gt; boolean)?): (boolean, any)
	local delaySeconds = 1
	local lastError: any = nil
	for attempt = 1, attempts do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		lastError = result
		if shouldStop and shouldStop(tostring(result)) then
			break
		end
		warn(`[BTToolsEvents] {label} ব্যর্থ ({attempt}/{attempts}): {result}`)
		if attempt &lt; attempts then
			task.wait(delaySeconds)
			delaySeconds = math.min(delaySeconds * 2, 16)
		end
	end
	return false, lastError
end

-- প্রতি প্লেয়ার interval সেকেন্ডে একবার অনুমতি দেয়।
function Util.RateLimiter(interval: number): (Player) -&gt; boolean
	local lastCall: { [Player]: number } = {}
	Players.PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
	end)
	return function(player: Player): boolean
		local now = os.clock()
		local last = lastCall[player]
		if last and now - last &lt; interval then
			return false
		end
		lastCall[player] = now
		return true
	end
end

-- জীবিত ক্যারেক্টার থাকলে (character, humanoid, root) দেয়।
function Util.GetLiveCharacter(player: Player): (Model?, Humanoid?, BasePart?)
	local character = player.Character
	if not character then
		return nil, nil, nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health &lt;= 0 or not root or not root:IsA("BasePart") then
		return nil, nil, nil
	end
	return character, humanoid, root
end

function Util.IsInteger(value: any, minValue: number, maxValue: number): boolean
	return type(value) == "number" and value == value and value % 1 == 0 and value &gt;= minValue and value &lt;= maxValue
end

return Util
</ProtectedString></Properties></Item></Item></Item></Item><Item class="Folder" referent="RBXBT003BF1CC1F7E45258F68E5F74AC7D4A1"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBXBT2CDE8A9B04BC44A5ADAA1710F3592554"><Properties><string name="Name">BTToolsEvents</string></Properties><Item class="LocalScript" referent="RBXBT472BAB4E52AD431495E23F716B6AC59E"><Properties><string name="Name">ClientMain</string><ProtectedString name="Source">--[[
	BT Tools Event: ClientMain (LocalScript, ক্লায়েন্ট)
	জায়গা: StarterPlayer &gt; StarterPlayerScripts &gt; BTToolsEvents &gt; ClientMain

	শুধু ক্লায়েন্টের মডিউলগুলো চালু করে।
]]

local Modules = script.Parent:WaitForChild("Modules")

local Sounds = require(Modules:WaitForChild("Sounds"))
local HUD = require(Modules:WaitForChild("HUD"))
local Minigame = require(Modules:WaitForChild("Minigame"))
local BoxVisuals = require(Modules:WaitForChild("BoxVisuals"))
local WinnerTags = require(Modules:WaitForChild("WinnerTags"))
local AdminPanel = require(Modules:WaitForChild("AdminPanel"))

Sounds.Init()
HUD.Init()
Minigame.Init()
BoxVisuals.Init()
WinnerTags.Init()
AdminPanel.Init()
</ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="Folder" referent="RBXBTE50E68000CC94D79A51264A167703AB8"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBXBTF78A52359DE445D888B3BCB8D5C986D6"><Properties><string name="Name">AdminPanel</string><ProtectedString name="Source">--[[
	BT Tools Event: AdminPanel (ModuleScript, ক্লায়েন্ট)

	- গেম শুরুতে অ্যাডমিন বাটন লুকানো থাকে। চ্যাটে Config.ADMIN_COMMAND (/bttools) লিখলে
	  বাঁ পাশে 🎁 বাটন আসে, আবার লিখলে চলে যায় (R15)।
	- প্যানেলে চারটা ট্যাব:
	  ইভেন্ট   মোট বক্স, সময়, কোন টুল কয়টা বক্সে, শুরুর নিরাপদ %, ফাঁক → START / STOP
	  প্লেয়ার  UserId দিয়ে টুল দেওয়া, সরানো, সেভ করা টুল দেখা (অফলাইন প্লেয়ারও)
	  ইতিহাস  প্লেয়ার অনুযায়ী জেতা / গিফট / সরানো, UserId দিয়ে খোঁজা (R16)
	  থিম     তিনটা থিম নিজের স্ক্রিনে আগে দেখে নেওয়া
	বাটন লুকানো থাকলেও আসল নিরাপত্তা সার্ভারে। অ্যাডমিন না হলে সার্ভার কিছুই করবে না।
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("BTToolsEvents")
local Config = require(Shared:WaitForChild("Config"))
local AdminRemote = Shared:WaitForChild("Remotes"):WaitForChild("AdminRequest") :: RemoteFunction

local Modules = script.Parent
local UI = require(Modules:WaitForChild("UI"))
local HUD = require(Modules:WaitForChild("HUD"))

local R = UI.Role
local player = Players.LocalPlayer

local THEME_DESCRIPTIONS = {
	Midnight = "গাঢ় নীল কাচ, সোনালি রং",
	Frost = "হালকা সাদা কাচ, নীল রং",
	Ember = "কয়লা-কালো কাচ, কমলা রং",
}

local KIND_INFO = {
	win = { text = "জিতেছে", role = "Accent" },
	gift = { text = "গিফট", role = "Info" },
	remove = { text = "সরানো", role = "Danger" },
}

local AdminPanel = {}

local panel: Frame? = nil
local pages: { [string]: ScrollingFrame } = {}
local tabButtons: { [string]: TextButton } = {}
local info: any = nil
local refreshEventStatus: (() -&gt; ())? = nil

local function call(action: string, payload: any?): { ok: boolean, message: string?, data: any? }
	local ok, result = pcall(function()
		return AdminRemote:InvokeServer(action, payload)
	end)
	if ok and type(result) == "table" then
		return result
	end
	return { ok = false, message = "সার্ভারের সাথে যোগাযোগ হয়নি।" }
end

----------------------------------------------------------------------
-- ছোট UI অংশ
----------------------------------------------------------------------
local order = 0
local function nextOrder(): number
	order += 1
	return order
end

local function page(parent: Frame, name: string): ScrollingFrame
	local scroll = UI.New("ScrollingFrame", {
		Name = name,
		Position = UDim2.new(0, 0, 0, 104),
		Size = UDim2.new(1, 0, 1, -104),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = R("SubText"),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
		Parent = parent,
	}, {
		UI.List(Enum.FillDirection.Vertical, 8),
		UI.New("UIPadding", {
			PaddingLeft = UDim.new(0, 18),
			PaddingRight = UDim.new(0, 18),
			PaddingTop = UDim.new(0, 4),
			PaddingBottom = UDim.new(0, 18),
		}),
	})
	pages[name] = scroll
	return scroll
end

local function caption(parent: Instance, text: string)
	UI.Caption({
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 26),
		TextYAlignment = Enum.TextYAlignment.Bottom,
		Text = text,
		Parent = parent,
	})
end

local function note(parent: Instance, text: string, role: string?): TextLabel
	return UI.Label({
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 13,
		TextColor3 = R(role or "SubText"),
		Text = text,
		Parent = parent,
	})
end

local function row(parent: Instance, height: number?): Frame
	return UI.New("Frame", {
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, height or 42),
		BackgroundColor3 = R("Surface"),
		BorderSizePixel = 0,
		Parent = parent,
	}, { UI.Corner(10) })
end

local function textBox(props: { [string]: any }): TextBox
	local defaults: { [string]: any } = {
		BackgroundColor3 = R("Background"),
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextColor3 = R("Text"),
		PlaceholderColor3 = R("SubText"),
	}
	for key, value in props do
		defaults[key] = value
	end
	return UI.New("TextBox", defaults, { UI.Corner(8), UI.Stroke() })
end

local function input(parent: Instance, labelText: string, default: string, placeholder: string?): TextBox
	local r = row(parent)
	UI.Label({
		Position = UDim2.new(0, 14, 0, 0),
		Size = UDim2.new(0.62, -14, 1, 0),
		TextSize = 14,
		Text = labelText,
		Parent = r,
	})
	return textBox({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -7, 0.5, 0),
		Size = UDim2.new(0.38, -7, 0, 30),
		Text = default,
		PlaceholderText = placeholder or "",
		Parent = r,
	})
end

local function readInt(box: TextBox): number?
	local value = tonumber(box.Text)
	if value and value % 1 == 0 then
		return value
	end
	return nil
end

-- রঙিন বিন্দুসহ অবস্থা-লাইন।
local function statusLine(parent: Instance): (string, string?) -&gt; ()
	local holder = UI.New("Frame", {
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local dot = UI.New("Frame", {
		Position = UDim2.new(0, 2, 0, 5),
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = R("SubText"),
		BorderSizePixel = 0,
		Parent = holder,
	}, { UI.New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	local label = UI.Label({
		Position = UDim2.new(0, 18, 0, 0),
		Size = UDim2.new(1, -18, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 14,
		Parent = holder,
	})
	return function(text: string, role: string?)
		label.Text = text
		UI.Apply(dot, { BackgroundColor3 = R(role or "SubText") })
		UI.Apply(label, { TextColor3 = R(if role then role else "SubText") })
	end
end

local function buttonRow(parent: Instance, height: number): Frame
	return UI.New("Frame", {
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		Parent = parent,
	}, { UI.List(Enum.FillDirection.Horizontal, 8) })
end

----------------------------------------------------------------------
-- ইভেন্ট ট্যাব
----------------------------------------------------------------------
local toolCounts: { [string]: number } = {}

local function buildEventPage(root: Frame)
	local p = page(root, "Event")
	local defaults = info.defaults

	local infoRow = row(p, 0)
	infoRow.AutomaticSize = Enum.AutomaticSize.Y
	UI.Padding(14, 10).Parent = infoRow
	UI.List(Enum.FillDirection.Vertical, 4).Parent = infoRow
	local setZone = statusLine(infoRow)
	local setShowcase = statusLine(infoRow)
	if info.zoneCount &gt; 0 then
		setZone(`স্পন জোন: {info.zoneCount} টা পার্ট পাওয়া গেছে`, "Success")
	else
		setZone("কোনো স্পন জোন নেই, আপনার চারপাশে radius এর মধ্যে বক্স পড়বে", "Accent")
	end
	if info.hasShowcase then
		setShowcase("শোকেস পার্ট পাওয়া গেছে", "Success")
	else
		setShowcase("WinnerShowcase পার্ট নেই, শোকেস দেখাবে না", "Danger")
	end

	caption(p, "ইভেন্টের সেটিং")
	local totalBox = input(p, "মোট বক্স", tostring(defaults.totalBoxes))
	local minutesBox = input(p, "সময় (মিনিট)", tostring(defaults.minutes))
	local safeBox = input(p, "শুরুতে টুল নেই (%)", tostring(defaults.safePercent))
	local gapBox = input(p, "দুই টুলের মাঝে ফাঁক", tostring(defaults.gap))
	local radiusBox = input(p, "Radius (জোন না থাকলে)", tostring(defaults.radius))

	caption(p, "কোন টুল কয়টা বক্সে")
	if #info.tools == 0 then
		note(p, "ServerStorage &gt; Tools ফোল্ডারে কোনো টুল নেই।", "Danger")
	end
	for _, toolName in info.tools do
		toolCounts[toolName] = toolCounts[toolName] or 0
		local r = row(p)
		UI.Label({
			Position = UDim2.new(0, 14, 0, 0),
			Size = UDim2.new(1, -140, 1, 0),
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
			Text = toolName,
			Parent = r,
		})
		local countLabel = UI.Label({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -44, 0.5, 0),
			Size = UDim2.fromOffset(40, 28),
			Font = UI.Fonts.Display,
			TextSize = 17,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = r,
		})
		local function refresh()
			local count = toolCounts[toolName]
			countLabel.Text = tostring(count)
			UI.Apply(countLabel, { TextColor3 = R(if count &gt; 0 then "Accent" else "SubText") })
		end
		local minus = UI.Button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -86, 0.5, 0),
			Size = UDim2.fromOffset(30, 28),
			BackgroundColor3 = R("Background"),
			Text = "−",
			TextSize = 18,
			Parent = r,
		})
		local plus = UI.Button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
			Size = UDim2.fromOffset(30, 28),
			BackgroundColor3 = R("Background"),
			Text = "+",
			TextSize = 18,
			Parent = r,
		})
		minus.Activated:Connect(function()
			toolCounts[toolName] = math.max(0, toolCounts[toolName] - 1)
			refresh()
		end)
		plus.Activated:Connect(function()
			toolCounts[toolName] = math.min(info.limits.maxBoxes, toolCounts[toolName] + 1)
			refresh()
		end)
		refresh()
	end

	caption(p, "")
	local setStatus = statusLine(p)
	refreshEventStatus = function()
		task.spawn(function()
			local response = call("GetInfo")
			if response.ok and type(response.data) == "table" then
				if response.data.active then
					setStatus("এখন একটা ইভেন্ট চলছে", "Success")
				else
					setStatus("টুল বেছে নিয়ে START চাপুন", nil)
				end
			end
		end)
	end
	setStatus(if info.active then "এখন একটা ইভেন্ট চলছে" else "টুল বেছে নিয়ে START চাপুন", if info.active then "Success" else nil)

	local buttons = buttonRow(p, 44)
	local startButton = UI.Button({
		LayoutOrder = 1,
		Size = UDim2.new(0.65, -4, 1, 0),
		TextSize = 16,
		Text = "START EVENT",
		Parent = buttons,
	}, "primary")
	local stopButton = UI.Button({
		LayoutOrder = 2,
		Size = UDim2.new(0.35, -4, 1, 0),
		TextSize = 16,
		Text = "STOP",
		Parent = buttons,
	}, "danger")

	local busy = false
	startButton.Activated:Connect(function()
		if busy then
			return
		end
		local payload = {
			totalBoxes = readInt(totalBox),
			minutes = readInt(minutesBox),
			radius = readInt(radiusBox),
			safePercent = readInt(safeBox),
			gap = readInt(gapBox),
			tools = toolCounts,
		}
		if not (payload.totalBoxes and payload.minutes and payload.radius and payload.safePercent and payload.gap) then
			setStatus("সব ঘরে পূর্ণ সংখ্যা লিখুন", "Danger")
			return
		end
		busy = true
		startButton.Text = "বক্স স্পন হচ্ছে…"
		local response = call("Start", payload)
		setStatus(response.message or (if response.ok then "শুরু হয়েছে" else "ব্যর্থ"), if response.ok then "Success" else "Danger")
		startButton.Text = "START EVENT"
		busy = false
	end)
	stopButton.Activated:Connect(function()
		if busy then
			return
		end
		busy = true
		local response = call("Stop")
		setStatus(response.message or "", if response.ok then "Success" else "Danger")
		busy = false
	end)
end

----------------------------------------------------------------------
-- প্লেয়ার ট্যাব
----------------------------------------------------------------------
local function buildPlayersPage(root: Frame)
	local p = page(root, "Players")

	caption(p, "অনলাইন প্লেয়ার · চাপলে UserId বসবে")
	local onlineList = UI.New("Frame", {
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = p,
	}, {
		UI.New("UIGridLayout", {
			CellSize = UDim2.new(0.5, -4, 0, 34),
			CellPadding = UDim2.fromOffset(8, 8),
			SortOrder = Enum.SortOrder.Name,
		}),
	})

	caption(p, "প্লেয়ার")
	local userIdBox = input(p, "UserId", "", "যেমন 7864126209")

	local function refreshOnline()
		for _, child in onlineList:GetChildren() do
			if child:IsA("TextButton") then
				child:Destroy()
			end
		end
		for _, other in Players:GetPlayers() do
			local button = UI.Button({
				Name = other.Name,
				Font = UI.Fonts.Medium,
				TextSize = 13,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = other.DisplayName,
				Parent = onlineList,
			})
			button.Activated:Connect(function()
				userIdBox.Text = tostring(other.UserId)
			end)
		end
	end
	refreshOnline()
	Players.PlayerAdded:Connect(refreshOnline)
	Players.PlayerRemoving:Connect(function()
		task.defer(refreshOnline)
	end)

	caption(p, "টুল")
	local selectedTool: string? = nil
	local toolButtons: { TextButton } = {}
	for _, toolName in info.tools do
		local button = UI.Button({
			LayoutOrder = nextOrder(),
			Size = UDim2.new(1, 0, 0, 36),
			Font = UI.Fonts.Medium,
			TextSize = 14,
			Text = toolName,
			Parent = p,
		})
		button.Activated:Connect(function()
			selectedTool = toolName
			for _, other in toolButtons do
				UI.SetButtonStyle(other, "ghost")
			end
			UI.SetButtonStyle(button, "primary")
		end)
		table.insert(toolButtons, button)
	end

	caption(p, "")
	local setStatus = statusLine(p)
	setStatus("UserId আর টুল বেছে নিন", nil)
	local actions = buttonRow(p, 42)
	local function actionButton(order: number, text: string, style: string): TextButton
		return UI.Button({
			LayoutOrder = order,
			Size = UDim2.new(1 / 3, -6, 1, 0),
			TextSize = 14,
			Text = text,
			Parent = actions,
		}, style)
	end
	local giveButton = actionButton(1, "টুল দিন", "success")
	local removeButton = actionButton(2, "সরান", "danger")
	local viewButton = actionButton(3, "দেখুন", "info")

	local function readUserId(): number?
		local userId = readInt(userIdBox)
		if not userId or userId &lt; 1 then
			setStatus("সঠিক UserId লিখুন", "Danger")
			return nil
		end
		return userId
	end

	local busy = false
	local function run(fn: () -&gt; ())
		if busy then
			return
		end
		busy = true
		fn()
		busy = false
	end

	local function changeTool(action: string)
		run(function()
			local userId = readUserId()
			if not userId then
				return
			end
			if not selectedTool then
				setStatus("একটা টুল বেছে নিন", "Danger")
				return
			end
			local response = call(action, { userId = userId, tool = selectedTool })
			setStatus(response.message or "", if response.ok then "Success" else "Danger")
		end)
	end
	giveButton.Activated:Connect(function()
		changeTool("GiveTool")
	end)
	removeButton.Activated:Connect(function()
		changeTool("RemoveTool")
	end)
	viewButton.Activated:Connect(function()
		run(function()
			local userId = readUserId()
			if not userId then
				return
			end
			local response = call("GetPlayerTools", { userId = userId })
			if response.ok and type(response.data) == "table" then
				local list = if #response.data &gt; 0 then table.concat(response.data, ", ") else "কোনো টুল নেই"
				setStatus(`{userId} এর সেভ করা টুল: {list}`, "Info")
			else
				setStatus(response.message or "পড়া যায়নি", "Danger")
			end
		end)
	end)
end

----------------------------------------------------------------------
-- ইতিহাস ট্যাব
----------------------------------------------------------------------
local function historyCard(parent: Instance, index: number, entry: any)
	local card = UI.New("Frame", {
		LayoutOrder = index,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = R("Surface"),
		BorderSizePixel = 0,
		Parent = parent,
	}, {
		UI.Corner(12),
		UI.Padding(14, 12),
		UI.List(Enum.FillDirection.Vertical, 6),
	})
	local header = UI.New("Frame", {
		LayoutOrder = 0,
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		Parent = card,
	})
	UI.Label({
		Size = UDim2.new(0.6, 0, 1, 0),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Text = tostring(entry.n or "?"),
		Parent = header,
	})
	UI.Label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.4, 0, 1, 0),
		TextSize = 12,
		TextColor3 = R("SubText"),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		Text = `UserId {entry.u}`,
		Parent = header,
	})
	for i, record in entry.r or {} do
		local kind = KIND_INFO[record.k] or KIND_INFO.win
		local line = UI.New("Frame", {
			LayoutOrder = i,
			Size = UDim2.new(1, 0, 0, 22),
			BackgroundTransparency = 1,
			Parent = card,
		})
		local badge = UI.Label({
			Size = UDim2.fromOffset(62, 20),
			BackgroundColor3 = R(kind.role),
			BackgroundTransparency = 0.82,
			Font = UI.Fonts.Bold,
			TextSize = 12,
			TextColor3 = R(kind.role),
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = kind.text,
			Parent = line,
		})
		UI.Corner(6).Parent = badge
		local when = if type(record.at) == "number" then os.date("%d/%m %H:%M", record.at) else "?"
		local by = if type(record.by) == "string" then ` · {record.by}` else ""
		UI.Label({
			Position = UDim2.new(0, 72, 0, 0),
			Size = UDim2.new(1, -72, 1, 0),
			TextSize = 14,
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
			RichText = true,
			Text = `{record.t}  &lt;font transparency="0.45"&gt;{when}{by}&lt;/font&gt;`,
			Parent = line,
		})
	end
end

local function buildHistoryPage(root: Frame)
	local p = page(root, "History")

	caption(p, "খুঁজুন")
	local search = row(p, 44)
	local searchBox = textBox({
		Position = UDim2.new(0, 6, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.new(1, -150, 0, 32),
		PlaceholderText = "UserId (খালি = সবাই)",
		Text = "",
		Parent = search,
	})
	local findButton = UI.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -6, 0.5, 0),
		Size = UDim2.fromOffset(132, 32),
		TextSize = 14,
		Text = "লোড করুন",
		Parent = search,
	}, "primary")

	local setStatus = statusLine(p)
	setStatus("সবচেয়ে সাম্প্রতিক প্লেয়ার আগে দেখাবে", nil)

	local list = UI.New("Frame", {
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = p,
	}, { UI.List(Enum.FillDirection.Vertical, 8) })

	local busy = false
	findButton.Activated:Connect(function()
		if busy then
			return
		end
		local payload = nil
		if searchBox.Text ~= "" then
			local userId = readInt(searchBox)
			if not userId or userId &lt; 1 then
				setStatus("সঠিক UserId লিখুন", "Danger")
				return
			end
			payload = { userId = userId }
		end
		busy = true
		findButton.Text = "লোড হচ্ছে…"
		for _, child in list:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local response = call("GetHistory", payload)
		if response.ok and type(response.data) == "table" then
			if #response.data == 0 then
				setStatus(if payload then "এই UserId এর কোনো ইতিহাস নেই" else "এখনো কোনো ইতিহাস নেই", nil)
			else
				setStatus(`{#response.data} জন প্লেয়ার`, "Info")
			end
			for i, entry in response.data do
				historyCard(list, i, entry)
			end
		else
			setStatus(response.message or "ইতিহাস পড়া যায়নি", "Danger")
		end
		findButton.Text = "লোড করুন"
		busy = false
	end)
end

----------------------------------------------------------------------
-- থিম ট্যাব
----------------------------------------------------------------------
local function buildThemePage(root: Frame)
	local p = page(root, "Theme")
	note(
		p,
		"এখানে থিম বদলালে শুধু আপনার স্ক্রিনে দেখাবে। সবার জন্য রাখতে ReplicatedStorage &gt; BTToolsEvents &gt; Config এ THEME = \"নাম\" লিখুন।"
	)
	caption(p, "থিম")

	local names = {}
	for name in Config.THEMES do
		table.insert(names, name)
	end
	table.sort(names)

	local refreshers: { () -&gt; () } = {}
	for _, name in names do
		local theme = Config.THEMES[name]
		local r = row(p, 64)
		local swatches = UI.New("Frame", {
			Position = UDim2.new(0, 14, 0.5, 0),
			AnchorPoint = Vector2.new(0, 0.5),
			Size = UDim2.fromOffset(70, 26),
			BackgroundTransparency = 1,
			Parent = r,
		}, { UI.List(Enum.FillDirection.Horizontal, -6) })
		for i, colorKey in { "Background", "Surface", "Accent" } do
			UI.New("Frame", {
				LayoutOrder = i,
				Size = UDim2.fromOffset(26, 26),
				BackgroundColor3 = theme[colorKey],
				BorderSizePixel = 0,
				Parent = swatches,
			}, {
				UI.New("UICorner", { CornerRadius = UDim.new(1, 0) }),
				UI.New("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = 0.7, Thickness = 1.5 }),
			})
		end
		UI.Label({
			Position = UDim2.new(0, 96, 0, 12),
			Size = UDim2.new(1, -200, 0, 20),
			Font = UI.Fonts.Bold,
			TextSize = 15,
			TextWrapped = false,
			Text = name,
			Parent = r,
		})
		local sub = UI.Label({
			Position = UDim2.new(0, 96, 0, 32),
			Size = UDim2.new(1, -200, 0, 18),
			TextSize = 12,
			TextColor3 = R("SubText"),
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
			Parent = r,
		})
		local button = UI.Button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(84, 32),
			TextSize = 14,
			Parent = r,
		})
		local function refresh()
			local active = UI.ThemeName() == name
			sub.Text = (THEME_DESCRIPTIONS[name] or "") .. (if name == Config.THEME then " · সবার জন্য চালু" else "")
			button.Text = if active then "চলছে" else "দেখুন"
			UI.SetButtonStyle(button, if active then "primary" else "ghost")
		end
		button.Activated:Connect(function()
			UI.SetTheme(name)
			for _, fn in refreshers do
				fn()
			end
		end)
		table.insert(refreshers, refresh)
		refresh()
	end
end

----------------------------------------------------------------------
-- প্যানেল
----------------------------------------------------------------------
local function showTab(name: string)
	for tabName, scroll in pages do
		scroll.Visible = tabName == name
	end
	for tabName, button in tabButtons do
		UI.SetButtonStyle(button, if tabName == name then "primary" else "ghost")
	end
end

local function buildPanel(gui: ScreenGui): Frame
	local root = UI.Card({
		Name = "AdminPanel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.94, 0.86),
		Visible = false,
		Parent = gui,
	}, {
		UI.New("UISizeConstraint", { MaxSize = Vector2.new(440, 600) }),
	})

	UI.Label({
		Position = UDim2.new(0, 18, 0, 14),
		Size = UDim2.new(1, -80, 0, 26),
		Font = UI.Fonts.Display,
		TextSize = 22,
		TextWrapped = false,
		Text = "BT Tools Event",
		Parent = root,
	})
	UI.Label({
		Position = UDim2.new(0, 18, 0, 40),
		Size = UDim2.new(1, -80, 0, 16),
		TextSize = 13,
		TextColor3 = R("SubText"),
		TextWrapped = false,
		Text = "অ্যাডমিন প্যানেল",
		Parent = root,
	})

	local close = UI.Button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(32, 32),
		Font = UI.Fonts.Bold,
		TextSize = 14,
		Text = "✕",
		Parent = root,
	})
	close.Activated:Connect(function()
		root.Visible = false
	end)

	local tabs = UI.New("Frame", {
		Position = UDim2.new(0, 18, 0, 64),
		Size = UDim2.new(1, -36, 0, 32),
		BackgroundTransparency = 1,
		Parent = root,
	}, { UI.List(Enum.FillDirection.Horizontal, 6) })
	for i, tab in { { "Event", "ইভেন্ট" }, { "Players", "প্লেয়ার" }, { "History", "ইতিহাস" }, { "Theme", "থিম" } } do
		local button = UI.Button({
			LayoutOrder = i,
			Size = UDim2.new(0.25, -5, 1, 0),
			TextSize = 14,
			Text = tab[2],
			Parent = tabs,
		})
		button.Activated:Connect(function()
			showTab(tab[1])
		end)
		tabButtons[tab[1]] = button
	end

	buildEventPage(root)
	buildPlayersPage(root)
	buildHistoryPage(root)
	buildThemePage(root)
	showTab("Event")
	return root
end

----------------------------------------------------------------------
-- চ্যাট কমান্ড
----------------------------------------------------------------------
local function listenForCommand(onCommand: () -&gt; ())
	local command = string.lower(Config.ADMIN_COMMAND)
	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		-- এভাবে বানানো কমান্ড চ্যাটে অন্য কেউ দেখে না।
		local chatCommand = Instance.new("TextChatCommand")
		chatCommand.Name = "BTToolsAdminCommand"
		chatCommand.PrimaryAlias = Config.ADMIN_COMMAND
		chatCommand.Triggered:Connect(function(source: TextSource)
			if source.UserId == player.UserId then
				onCommand()
			end
		end)
		chatCommand.Parent = TextChatService
	else
		player.Chatted:Connect(function(message)
			local trimmed = string.gsub(message, "^%s*(.-)%s*$", "%1")
			if string.lower(trimmed) == command then
				onCommand()
			end
		end)
	end
end

function AdminPanel.Init()
	if not Config.IsAdmin(player) then
		return
	end
	local gui = UI.ScreenGui("BTToolsEventsAdmin", 10)

	local toggle = UI.Button({
		Name = "Toggle",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.5, 0),
		Size = UDim2.fromOffset(50, 50),
		BackgroundColor3 = R("Background"),
		BackgroundTransparency = UI.GlassTransparency,
		Text = "🎁",
		TextSize = 24,
		Visible = false,
		Parent = gui,
	})
	UI.Round(toggle)
	UI.Stroke("Accent", 0.2).Parent = toggle
	local toggleScale = toggle:FindFirstChildOfClass("UIScale")

	local loading = false
	toggle.Activated:Connect(function()
		if panel then
			panel.Visible = not panel.Visible
			if panel.Visible and refreshEventStatus then
				refreshEventStatus()
			end
			return
		end
		if loading then
			return
		end
		loading = true
		local response = call("GetInfo")
		loading = false
		if not response.ok or type(response.data) ~= "table" then
			HUD.Toast(response.message or "অ্যাডমিন প্যানেল খোলা যায়নি", "Danger")
			return
		end
		info = response.data
		local built = buildPanel(gui)
		panel = built
		built.Visible = true
	end)

	listenForCommand(function()
		toggle.Visible = not toggle.Visible
		if toggle.Visible then
			HUD.Toast("অ্যাডমিন বাটন চালু", "Success")
			if toggleScale then
				toggleScale.Scale = 0.5
				TweenService:Create(toggleScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
			end
		else
			HUD.Toast("অ্যাডমিন বাটন বন্ধ", nil)
			if panel then
				panel.Visible = false
			end
		end
	end)
end

return AdminPanel
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBT9E23D1D897164F3FA88338D5D00572E3"><Properties><string name="Name">BoxVisuals</string><ProtectedString name="Source">--[[
	BT Tools Event: BoxVisuals (ModuleScript, ক্লায়েন্ট)
	মাটির বক্সগুলো ঘোরায় আর হালকা ভাসায়। শুধু নিজের স্ক্রিনে চলে, তাই সার্ভারে কোনো ল্যাগ নেই (I15)।
	সার্ভার শুধু স্থির Root আর Prompt রাখে, এখানে শুধু "Visual" অংশটা নড়ে।
]]

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local SPIN_SPEED = math.rad(50) -- প্রতি সেকেন্ডে
local BOB_HEIGHT = 0.4
local BOB_SPEED = 2

local BoxVisuals = {}

type Entry = { visual: Model, base: CFrame, phase: number }

local entries: { [Model]: Entry } = {}

local function track(model: Instance)
	if not model:IsA("Model") then
		return
	end
	local visual = model:WaitForChild("Visual", 5)
	if not visual or not visual:IsA("Model") or not model.Parent then
		return
	end
	entries[model] = { visual = visual, base = visual:GetPivot(), phase = math.random() * math.pi * 2 }
end

function BoxVisuals.Init()
	task.spawn(function()
		local folder = Workspace:WaitForChild("BTToolsEvents_Boxes")
		folder.ChildAdded:Connect(function(child)
			track(child)
		end)
		folder.ChildRemoved:Connect(function(child)
			if child:IsA("Model") then
				entries[child] = nil
			end
		end)
		for _, child in folder:GetChildren() do
			task.spawn(track, child)
		end
	end)

	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		for model, entry in entries do
			if not model.Parent or not entry.visual.Parent then
				entries[model] = nil
				continue
			end
			local t = now + entry.phase
			local bob = math.sin(t * BOB_SPEED) * BOB_HEIGHT
			entry.visual:PivotTo(entry.base * CFrame.new(0, bob, 0) * CFrame.Angles(0, t * SPIN_SPEED, 0))
		end
	end)
end

return BoxVisuals
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBTCB84C4E74B5040BC85113786644F4BC7"><Properties><string name="Name">HUD</string><ProtectedString name="Source">--[[
	BT Tools Event: HUD (ModuleScript, ক্লায়েন্ট)

	- ওপরে ছোট কাচের কাউন্টার: [ 17/20 খোলা | 4:32 বাকি ] (R12)। ইভেন্ট না চললে লুকানো।
	- ব্যানার: ইভেন্ট শুরু, কেউ জিতলে, ইভেন্ট শেষ। বাঁ পাশে রঙিন দাগ।
	- ফলাফল কার্ড: বক্স খোলার পরে কী পেলেন।
	- ছোট মেসেজ (toast)।
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("BTToolsEvents")
local Remotes = Shared:WaitForChild("Remotes")

local Modules = script.Parent
local UI = require(Modules:WaitForChild("UI"))
local Sounds = require(Modules:WaitForChild("Sounds"))

local R = UI.Role

local HUD = {}

local gui: ScreenGui
local pill: Frame
local countLabel: TextLabel
local timeLabel: TextLabel
local pillScale: UIScale

local bannerQueue: { { title: string, body: string, role: string } } = {}
local bannerRunning = false

----------------------------------------------------------------------
-- কাউন্টার
----------------------------------------------------------------------
local function formatTime(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

local function refreshCounter()
	local active = Shared:GetAttribute("Active") == true
	pill.Visible = active
	if not active then
		return
	end
	local total = Shared:GetAttribute("Total") or 0
	local opened = Shared:GetAttribute("Opened") or 0
	countLabel.Text = `{opened}/{total}`
end

local function refreshTimer()
	local endsAt = Shared:GetAttribute("EndsAt")
	if type(endsAt) == "number" and pill.Visible then
		local left = endsAt - Workspace:GetServerTimeNow()
		timeLabel.Text = formatTime(left)
		UI.Apply(timeLabel, { TextColor3 = R(if left &lt;= 30 then "Danger" else "Text") })
	end
end

local function pulse()
	pillScale.Scale = 1.12
	TweenService:Create(pillScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

-- কাউন্টারের এক ভাগ: বড় সংখ্যা আর তার পাশে ছোট লেখা।
local function segment(order: number, caption: string): TextLabel
	local holder = UI.New("Frame", {
		LayoutOrder = order,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X,
		Parent = pill,
	}, { UI.List(Enum.FillDirection.Horizontal, 5) })
	local value = UI.Label({
		LayoutOrder = 1,
		Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = UI.Fonts.Display,
		TextSize = 18,
		TextWrapped = false,
		Parent = holder,
	})
	UI.Label({
		LayoutOrder = 2,
		Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = UI.Fonts.Medium,
		TextSize = 13,
		TextColor3 = R("SubText"),
		TextWrapped = false,
		Text = caption,
		Parent = holder,
	})
	return value
end

local function buildCounter()
	pill = UI.Card({
		Name = "Counter",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(0, 32),
		AutomaticSize = Enum.AutomaticSize.X,
		Visible = false,
		Parent = gui,
	}, {
		UI.New("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }),
		UI.List(Enum.FillDirection.Horizontal, 12),
	})
	UI.Round(pill)
	pillScale = UI.New("UIScale", { Parent = pill })

	-- বাঁ পাশে accent রঙের ছোট বিন্দু, ইভেন্ট চলছে বোঝাতে।
	UI.New("Frame", {
		LayoutOrder = 0,
		Size = UDim2.fromOffset(8, 8),
		BackgroundColor3 = R("Accent"),
		BorderSizePixel = 0,
		Parent = pill,
	}, { UI.New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	countLabel = segment(1, "খোলা")
	UI.New("Frame", {
		LayoutOrder = 2,
		Size = UDim2.fromOffset(1, 16),
		BackgroundColor3 = R("Stroke"),
		BackgroundTransparency = 0.8,
		BorderSizePixel = 0,
		Parent = pill,
	})
	timeLabel = segment(3, "বাকি")

	local lastOpened = Shared:GetAttribute("Opened")
	for _, attribute in { "Active", "Total", "Opened", "EndsAt" } do
		Shared:GetAttributeChangedSignal(attribute):Connect(function()
			refreshCounter()
			refreshTimer()
			local opened = Shared:GetAttribute("Opened")
			if attribute == "Opened" and opened ~= lastOpened and (opened or 0) &gt; 0 then
				pulse()
			end
			lastOpened = opened
		end)
	end
	refreshCounter()
	refreshTimer()
	task.spawn(function()
		while true do
			task.wait(0.25)
			refreshTimer()
		end
	end)
end

----------------------------------------------------------------------
-- ব্যানার
----------------------------------------------------------------------
local BANNER_HIDDEN = UDim2.new(0.5, 0, 0, -110)
local BANNER_SHOWN = UDim2.new(0.5, 0, 0, 50)

local function showBanner(title: string, body: string, role: string)
	local card = UI.Card({
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = BANNER_HIDDEN,
		Size = UDim2.new(0.92, 0, 0, 72),
		Parent = gui,
	}, {
		UI.New("UISizeConstraint", { MaxSize = Vector2.new(500, 72) }),
		UI.New("Frame", {
			Name = "AccentBar",
			Position = UDim2.new(0, 12, 0, 14),
			Size = UDim2.new(0, 4, 1, -28),
			BackgroundColor3 = R(role),
			BorderSizePixel = 0,
		}, { UI.New("UICorner", { CornerRadius = UDim.new(1, 0) }) }),
		UI.Label({
			Name = "Title",
			Position = UDim2.new(0, 28, 0, 12),
			Size = UDim2.new(1, -44, 0, 24),
			Font = UI.Fonts.Display,
			TextSize = 19,
			TextColor3 = R(role),
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
			Text = title,
		}),
		UI.Label({
			Name = "Body",
			Position = UDim2.new(0, 28, 0, 38),
			Size = UDim2.new(1, -44, 0, 22),
			TextSize = 14,
			TextColor3 = R("SubText"),
			TextTruncate = Enum.TextTruncate.AtEnd,
			TextWrapped = false,
			Text = body,
		}),
	})
	local inTween = TweenService:Create(card, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = BANNER_SHOWN,
	})
	inTween:Play()
	inTween.Completed:Wait()
	task.wait(4.5)
	local outTween = TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
		Position = BANNER_HIDDEN,
	})
	outTween:Play()
	outTween.Completed:Wait()
	card:Destroy()
end

-- ব্যানার একটার পর একটা দেখায়, একসাথে দুটো না। role = থিমের রং ("Accent", "Info" ...)।
function HUD.Banner(title: string, body: string, role: string?)
	table.insert(bannerQueue, { title = title, body = body, role = role or "Accent" })
	if bannerRunning then
		return
	end
	bannerRunning = true
	task.spawn(function()
		while #bannerQueue &gt; 0 do
			local item = table.remove(bannerQueue, 1)
			if item then
				showBanner(item.title, item.body, item.role)
			end
		end
		bannerRunning = false
	end)
end

----------------------------------------------------------------------
-- ছোট মেসেজ আর ফলাফল কার্ড
----------------------------------------------------------------------
local toast: Frame
local toastDot: Frame
local toastLabel: TextLabel
local toastToken = 0

function HUD.Toast(text: string, role: string?)
	toastToken += 1
	local token = toastToken
	toastLabel.Text = text
	UI.Apply(toastDot, { BackgroundColor3 = R(role or "Accent") })
	toast.Visible = true
	task.delay(2.5, function()
		if toastToken == token then
			toast.Visible = false
		end
	end)
end

local resultCard: Frame
local resultCaption: TextLabel
local resultTitle: TextLabel
local resultBody: TextLabel
local resultBar: Frame
local resultScale: UIScale
local resultToken = 0

function HUD.ShowResult(caption: string, title: string, body: string, role: string)
	resultToken += 1
	local token = resultToken
	resultCaption.Text = caption
	resultTitle.Text = title
	resultBody.Text = body
	UI.Apply(resultTitle, { TextColor3 = R(role) })
	UI.Apply(resultBar, { BackgroundColor3 = R(role) })
	resultCard.Visible = true
	resultScale.Scale = 0.85
	TweenService:Create(resultScale, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(4, function()
		if resultToken == token then
			resultCard.Visible = false
		end
	end)
end

local function buildCards()
	toast = UI.Card({
		Name = "Toast",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.2),
		Size = UDim2.fromOffset(0, 38),
		AutomaticSize = Enum.AutomaticSize.X,
		Visible = false,
		Parent = gui,
	}, {
		UI.New("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 16) }),
		UI.List(Enum.FillDirection.Horizontal, 10),
	})
	UI.Round(toast)
	toastDot = UI.New("Frame", {
		LayoutOrder = 1,
		Size = UDim2.fromOffset(8, 8),
		BorderSizePixel = 0,
		Parent = toast,
	}, { UI.New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	toastLabel = UI.Label({
		LayoutOrder = 2,
		Size = UDim2.fromOffset(0, 38),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextWrapped = false,
		Parent = toast,
	})

	resultCard = UI.Card({
		Name = "Result",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.new(0.86, 0, 0, 118),
		Visible = false,
		Parent = gui,
	}, {
		UI.New("UISizeConstraint", { MaxSize = Vector2.new(380, 118) }),
	})
	resultScale = UI.New("UIScale", { Parent = resultCard })
	resultBar = UI.New("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(0.4, 0, 0, 3),
		BorderSizePixel = 0,
		Parent = resultCard,
	}, { UI.New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	resultCaption = UI.Caption({
		Position = UDim2.new(0, 0, 0, 16),
		Size = UDim2.new(1, 0, 0, 16),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = resultCard,
	})
	resultTitle = UI.Label({
		Position = UDim2.new(0, 16, 0, 36),
		Size = UDim2.new(1, -32, 0, 38),
		Font = UI.Fonts.Display,
		TextScaled = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = resultCard,
	})
	UI.New("UITextSizeConstraint", { MaxTextSize = 32, Parent = resultTitle })
	resultBody = UI.Label({
		Position = UDim2.new(0, 16, 0, 80),
		Size = UDim2.new(1, -32, 0, 22),
		TextSize = 14,
		TextColor3 = R("SubText"),
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = resultCard,
	})
end

----------------------------------------------------------------------
-- সার্ভারের মেসেজ
----------------------------------------------------------------------
local function systemChat(text: string)
	pcall(function()
		local channels = TextChatService:FindFirstChild("TextChannels")
		local general = channels and channels:FindFirstChild("RBXGeneral")
		if general and general:IsA("TextChannel") then
			general:DisplaySystemMessage(text)
		end
	end)
end

local END_REASONS = {
	time = "সময় শেষ",
	all = "সব বক্স খোলা হয়েছে",
	admin = "অ্যাডমিন বন্ধ করেছেন",
}

local function onAnnounce(kind: string, data: any)
	if type(data) ~= "table" then
		return
	end
	if kind == "Start" then
		Sounds.Play("EventStart")
		HUD.Banner("🎁 Treasure Hunt শুরু", `ম্যাপে {data.total} টা উপহার বক্স লুকানো আছে, খুঁজে বের করুন!`, "Accent")
	elseif kind == "Winner" then
		HUD.Banner(`🏆 {data.name} জিতেছেন`, `পার্মানেন্ট {data.tool} এখন তার!`, "Accent")
		systemChat(`🏆 {data.name} উপহার বক্স খুলে পার্মানেন্ট {data.tool} জিতে নিয়েছেন!`)
	elseif kind == "End" then
		Sounds.Play("EventEnd")
		local names = {}
		for _, winner in data.winners or {} do
			table.insert(names, `{winner.name} ({winner.tool})`)
		end
		local body = if #names &gt; 0 then "বিজয়ী: " .. table.concat(names, ", ") else "এবার কেউ টুল পায়নি।"
		HUD.Banner("ইভেন্ট শেষ · " .. (END_REASONS[data.reason] or ""), body, "Info")
	end
end

local function onNotify(kind: string, data: any)
	if type(data) ~= "table" then
		return
	end
	if kind == "Warn" then
		HUD.Toast(data.text or "", "Accent")
	elseif kind == "Pickup" then
		Sounds.Play("Pickup")
	elseif kind == "OpenFailed" then
		HUD.Toast(data.text or "", "Danger")
	elseif kind == "Result" then
		Sounds.Play("Unbox")
		task.delay(0.3, function()
			if data.reward == "Tool" then
				Sounds.Play("ToolWin")
				HUD.ShowResult("অভিনন্দন · নতুন পার্মানেন্ট টুল", data.tool, "এখন থেকে প্রতিবার গেমে ঢুকলেই পাবেন", "Accent")
			else
				Sounds.Play("Coin")
				HUD.ShowResult("পুরস্কার", `+{data.amount} {data.currency}`, "এই বক্সে টুল ছিল না, পরেরটায় চেষ্টা করুন", "Success")
			end
		end)
	end
end

function HUD.Init()
	gui = UI.ScreenGui("BTToolsEventsHUD", 5)
	buildCounter()
	buildCards()
	local announceRemote = Remotes:WaitForChild("Announce") :: RemoteEvent
	local notifyRemote = Remotes:WaitForChild("Notify") :: RemoteEvent
	announceRemote.OnClientEvent:Connect(onAnnounce)
	notifyRemote.OnClientEvent:Connect(onNotify)
end

return HUD
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBT545DD093A7DF454C957EB6C67ED28391"><Properties><string name="Name">Minigame</string><ProtectedString name="Source">--[[
	BT Tools Event: Minigame (ModuleScript, ক্লায়েন্ট)

	বক্স খোলার টাইমিং বার (R10, Option A):
	  বক্স খুলুন                     ● ● ○
	  [━━━━━━━▇▇▇━━━━━━━━━━]   ← কাঁটা এদিক-ওদিক চলে, হাইলাইট অংশে এলে ক্লিক বা TAP।
	- সঠিক ক্লিক (HIT): একটা বিন্দু ভরে যায়, Hit সাউন্ড (প্রতিবার সুর একটু উঁচু),
	  পরের রাউন্ডে জোন ছোট হয় আর কাঁটা দ্রুত চলে।
	- ভুল ক্লিক (MISS): বার লাল হয়ে কাঁপে, Miss সাউন্ড, MISS_STUN সেকেন্ড অপেক্ষা।
	  ভরা বিন্দু আবার খালি হয় না।
	- সব বিন্দু ভরলে সার্ভারকে বক্স খুলতে বলা হয়। কী পাবেন সেটা সার্ভার ঠিক করে।
	- বক্স হাত থেকে নামালে মিনি-গেম বন্ধ হয়ে শূন্য থেকে শুরু হয়।
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("BTToolsEvents")
local Config = require(Shared:WaitForChild("Config"))
local Remotes = Shared:WaitForChild("Remotes")
local OpenBoxRemote = Remotes:WaitForChild("OpenBox") :: RemoteEvent
local NotifyRemote = Remotes:WaitForChild("Notify") :: RemoteEvent

local Modules = script.Parent
local UI = require(Modules:WaitForChild("UI"))
local Sounds = require(Modules:WaitForChild("Sounds"))

local R = UI.Role
local M = Config.Minigame
local BOX_ATTRIBUTE = "BTBoxId"
local TOLERANCE = 0.012
local CONTAINER_POSITION = UDim2.new(0.5, 0, 1, -104)
local HINT_TEXT = "কাঁটা হাইলাইট করা অংশে এলে ক্লিক বা TAP করুন"

type Session = {
	tool: Tool,
	boxId: number,
	hits: number,
	zoneStart: number,
	zoneSize: number,
	speed: number,
	pos: number,
	dir: number,
	state: "play" | "stun" | "sending",
	activatedConn: RBXScriptConnection,
}

local Minigame = {}

local player = Players.LocalPlayer
local session: Session? = nil
local pickupTimes: { [number]: number } = {}

local gui: ScreenGui
local container: Frame
local hint: TextLabel
local pips: { Frame } = {}
local track: Frame
local trackStroke: UIStroke
local zone: Frame
local needle: Frame

----------------------------------------------------------------------
-- UI
----------------------------------------------------------------------
local function buildUI()
	gui = UI.ScreenGui("BTBoxMinigame", 6)
	container = UI.Card({
		Name = "Container",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = CONTAINER_POSITION,
		Size = UDim2.new(0.92, 0, 0, 150),
		Visible = false,
		Parent = gui,
	}, {
		UI.New("UISizeConstraint", { MaxSize = Vector2.new(400, 150) }),
	})

	UI.Label({
		Name = "Title",
		Position = UDim2.new(0, 18, 0, 14),
		Size = UDim2.new(1, -120, 0, 22),
		Font = UI.Fonts.Display,
		TextSize = 19,
		TextWrapped = false,
		Text = "🎁 বক্স খুলুন",
		Parent = container,
	})

	local pipRow = UI.New("Frame", {
		Name = "Pips",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 18),
		Size = UDim2.fromOffset(90, 14),
		BackgroundTransparency = 1,
		Parent = container,
	}, {
		UI.New("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			VerticalAlignment = Enum.VerticalAlignment.Center,
			Padding = UDim.new(0, 8),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	for i = 1, M.HITS_REQUIRED do
		local pip = UI.New("Frame", {
			Name = "Pip" .. i,
			LayoutOrder = i,
			Size = UDim2.fromOffset(12, 12),
			BackgroundColor3 = R("Surface"),
			BorderSizePixel = 0,
			Parent = pipRow,
		}, {
			UI.New("UICorner", { CornerRadius = UDim.new(1, 0) }),
			UI.Stroke("Accent", 0.3),
		})
		UI.New("UIScale", { Parent = pip })
		table.insert(pips, pip)
	end

	hint = UI.Label({
		Name = "Hint",
		Position = UDim2.new(0, 18, 0, 38),
		Size = UDim2.new(1, -36, 0, 18),
		TextSize = 13,
		TextColor3 = R("SubText"),
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextWrapped = false,
		Text = HINT_TEXT,
		Parent = container,
	})

	track = UI.New("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 68),
		Size = UDim2.new(1, -36, 0, 12),
		BackgroundColor3 = R("Surface"),
		BorderSizePixel = 0,
		Parent = container,
	}, { UI.New("UICorner", { CornerRadius = UDim.new(1, 0) }) })
	trackStroke = UI.Stroke()
	trackStroke.Parent = track

	zone = UI.New("Frame", {
		Name = "Zone",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0.2, 1),
		Parent = track,
	}, { UI.New("UICorner", { CornerRadius = UDim.new(1, 0) }), UI.AccentGradient(0) })

	needle = UI.New("Frame", {
		Name = "Needle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(0, 4, 1, 16),
		BackgroundColor3 = R("Text"),
		BorderSizePixel = 0,
		ZIndex = 3,
		Parent = track,
	}, { UI.New("UICorner", { CornerRadius = UDim.new(1, 0) }) })

	local tap = UI.Button({
		Name = "Tap",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 96),
		Size = UDim2.new(1, -36, 0, 40),
		Font = UI.Fonts.Display,
		TextSize = 18,
		Text = "TAP",
		Parent = container,
	}, "primary")
	tap.Activated:Connect(function()
		Minigame._Attempt()
	end)
end

local function setPips(hits: number)
	for i, pip in pips do
		UI.Apply(pip, { BackgroundColor3 = R(if i &lt;= hits then "Accent" else "Surface") })
	end
end

local function popPip(index: number)
	local pip = pips[index]
	local scale = pip and pip:FindFirstChildOfClass("UIScale")
	if scale then
		scale.Scale = 1.7
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
end

local function flashTrack(role: string)
	UI.Apply(trackStroke, { Color = R(role), Transparency = 0 })
	trackStroke.Thickness = 2
	task.delay(0.25, function()
		UI.Apply(trackStroke, {
			Color = R("Stroke"),
			Transparency = UI.Fn(function(theme)
				return theme.StrokeTransparency
			end),
		})
		trackStroke.Thickness = 1
	end)
end

local function setHint(text: string, role: string)
	hint.Text = text
	UI.Apply(hint, { TextColor3 = R(role) })
end

local function shake()
	task.spawn(function()
		for _, dx in { -9, 9, -6, 6, -3, 0 } do
			container.Position = CONTAINER_POSITION + UDim2.fromOffset(dx, 0)
			task.wait(0.03)
		end
		container.Position = CONTAINER_POSITION
	end)
end

local function placeZone(s: Session)
	local size = s.zoneSize
	-- নতুন জোন কাঁটার ঠিক নিচে যেন না পড়ে।
	for _ = 1, 10 do
		s.zoneStart = math.random() * (1 - size)
		local center = s.zoneStart + size / 2
		if math.abs(center - s.pos) &gt; 0.25 then
			break
		end
	end
	zone.Size = UDim2.fromScale(size, 1)
	zone.Position = UDim2.fromScale(s.zoneStart, 0)
end

----------------------------------------------------------------------
-- খেলা
----------------------------------------------------------------------
local function stop()
	local s = session
	if not s then
		return
	end
	s.activatedConn:Disconnect()
	session = nil
	container.Visible = false
end

local function resetRound(s: Session)
	s.hits = 0
	s.zoneSize = M.ZONE_SIZE_START
	s.speed = M.NEEDLE_SPEED_START
	s.state = "play"
	setPips(0)
	setHint(HINT_TEXT, "SubText")
	placeZone(s)
end

local function sendOpen(s: Session)
	s.state = "sending"
	setHint("বক্স খুলছে…", "Accent")
	-- সার্ভার MIN_OPEN_TIME এর আগে বক্স খোলে না, তাই দরকার হলে একটু অপেক্ষা।
	local pickedAt = pickupTimes[s.boxId] or 0
	local waitLeft = pickedAt + Config.MIN_OPEN_TIME + 0.15 - os.clock()
	task.delay(math.max(0, waitLeft), function()
		if session ~= s then
			return
		end
		OpenBoxRemote:FireServer(s.boxId)
		-- উত্তর না এলে আবার চেষ্টা করার সুযোগ।
		task.delay(5, function()
			if session == s and s.state == "sending" then
				resetRound(s)
			end
		end)
	end)
end

function Minigame._Attempt()
	local s = session
	if not s or s.state ~= "play" then
		return
	end
	if s.pos &gt;= s.zoneStart - TOLERANCE and s.pos &lt;= s.zoneStart + s.zoneSize + TOLERANCE then
		s.hits += 1
		setPips(s.hits)
		popPip(s.hits)
		flashTrack("Accent")
		Sounds.Play("Hit", 1 + 0.2 * (s.hits - 1))
		if s.hits &gt;= M.HITS_REQUIRED then
			sendOpen(s)
			return
		end
		s.zoneSize = math.max(M.ZONE_SIZE_MIN, M.ZONE_SIZE_START - M.ZONE_SHRINK * s.hits)
		s.speed = M.NEEDLE_SPEED_START + M.NEEDLE_SPEED_UP * s.hits
		placeZone(s)
	else
		-- MISS: অপেক্ষা, কিন্তু ভরা বিন্দু খালি হবে না।
		s.state = "stun"
		flashTrack("Danger")
		shake()
		Sounds.Play("Miss")
		setHint("মিস! একটু অপেক্ষা…", "Danger")
		task.delay(M.MISS_STUN, function()
			if session == s and s.state == "stun" then
				s.state = "play"
				setHint(HINT_TEXT, "SubText")
			end
		end)
	end
end

local function start(tool: Tool)
	local boxId = tool:GetAttribute(BOX_ATTRIBUTE)
	if type(boxId) ~= "number" then
		return
	end
	stop()
	if not pickupTimes[boxId] then
		pickupTimes[boxId] = os.clock()
	end
	local s: Session = {
		tool = tool,
		boxId = boxId,
		hits = 0,
		zoneStart = 0,
		zoneSize = M.ZONE_SIZE_START,
		speed = M.NEEDLE_SPEED_START,
		pos = 0,
		dir = 1,
		state = "play",
		activatedConn = tool.Activated:Connect(function()
			Minigame._Attempt()
		end),
	}
	session = s
	resetRound(s)
	container.Visible = true
end

local function watchCharacter(character: Model)
	character.ChildAdded:Connect(function(child)
		if child:IsA("Tool") and child:GetAttribute(BOX_ATTRIBUTE) ~= nil then
			start(child)
		end
	end)
	character.ChildRemoved:Connect(function(child)
		if session and session.tool == child then
			stop()
		end
	end)
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute(BOX_ATTRIBUTE) ~= nil then
			start(child)
		end
	end
end

function Minigame.Init()
	buildUI()

	NotifyRemote.OnClientEvent:Connect(function(kind: string, data: any)
		if kind == "Pickup" and type(data) == "table" and type(data.boxId) == "number" then
			pickupTimes[data.boxId] = os.clock()
		elseif kind == "OpenFailed" then
			local s = session
			if s and s.state == "sending" then
				task.delay(0.8, function()
					if session == s then
						resetRound(s)
					end
				end)
			end
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		local s = session
		if not s or s.state ~= "play" then
			return
		end
		s.pos += s.dir * s.speed * dt
		if s.pos &gt;= 1 then
			s.pos = 1
			s.dir = -1
		elseif s.pos &lt;= 0 then
			s.pos = 0
			s.dir = 1
		end
		needle.Position = UDim2.fromScale(s.pos, 0.5)
	end)

	player.CharacterAdded:Connect(function(character)
		stop()
		watchCharacter(character)
	end)
	if player.Character then
		watchCharacter(player.Character)
	end
end

return Minigame
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBTEA1C3B8E3EEC4E81811545495A82A6A3"><Properties><string name="Name">Sounds</string><ProtectedString name="Source">--[[
	BT Tools Event: Sounds (ModuleScript, ক্লায়েন্ট)
	Config.SOUND_IDS থেকে সাউন্ড বাজায়। ID 0 বা খালি হলে চুপচাপ কিছু করে না।
]]

local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("BTToolsEvents"):WaitForChild("Config"))

local Sounds = {}

local templates: { [string]: Sound } = {}

function Sounds.Init()
	local folder = Instance.new("Folder")
	folder.Name = "BTToolsEventsSounds"
	folder.Parent = SoundService
	local toPreload = {}
	for name, id in Config.SOUND_IDS do
		if Config.IsSoundSet(id) then
			local sound = Instance.new("Sound")
			sound.Name = name
			sound.SoundId = id
			sound.Volume = Config.SOUND_VOLUME
			sound.Parent = folder
			templates[name] = sound
			table.insert(toPreload, sound)
		end
	end
	task.spawn(function()
		pcall(function()
			ContentProvider:PreloadAsync(toPreload)
		end)
	end)
end

function Sounds.Play(name: string, pitch: number?)
	local template = templates[name]
	if not template then
		return
	end
	local sound = template:Clone()
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = SoundService
	sound.Ended:Once(function()
		sound:Destroy()
	end)
	sound:Play()
	task.delay(15, function()
		if sound.Parent then
			sound:Destroy()
		end
	end)
end

return Sounds
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBT30580D0BD4564E1F8EF5931C6D8AEFD2"><Properties><string name="Name">UI</string><ProtectedString name="Source">--[[
	BT Tools Event: UI (ModuleScript, ক্লায়েন্ট)

	সব UI এর ডিজাইনের ভিত্তি: থিম, ফন্ট, আর ছোট সাহায্যকারী ফাংশন।

	থিম কীভাবে কাজ করে:
	- রং সরাসরি না লিখে UI.Role("Accent") এর মতো "ভূমিকা" দেওয়া হয়।
	- UI.New সেই ভূমিকা মনে রাখে, তাই UI.SetTheme("Frost") ডাকলে সব UI সাথে সাথে নতুন রঙে বদলে যায়।
	- থিমের রং Config.THEMES এ।
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("BTToolsEvents"):WaitForChild("Config"))

type Theme = { [string]: any }
type Binding = { __btRole: string? , __btFn: ((Theme) -&gt; any)? }

local UI = {}

UI.Fonts = {
	Display = Enum.Font.BuilderSansExtraBold,
	Bold = Enum.Font.BuilderSansBold,
	Medium = Enum.Font.BuilderSansMedium,
	Regular = Enum.Font.BuilderSans,
}

local currentName = Config.THEME
local current: Theme = Config.GetTheme(currentName)

-- instance -&gt; { property -&gt; binding }। weak key, তাই মুছে যাওয়া UI মেমরিতে আটকে থাকে না।
local bindings: { [Instance]: { [string]: Binding } } = setmetatable({}, { __mode = "k" }) :: any
local themeChanged = Instance.new("BindableEvent")
UI.ThemeChanged = themeChanged.Event

----------------------------------------------------------------------
-- থিম
----------------------------------------------------------------------
-- থিমের একটা রং (যেমন UI.Role("Accent"))।
function UI.Role(role: string): Binding
	return { __btRole = role }
end

-- থিম থেকে হিসাব করা মান (যেমন gradient বা transparency)।
function UI.Fn(fn: (Theme) -&gt; any): Binding
	return { __btFn = fn }
end

local function isBinding(value: any): boolean
	return type(value) == "table" and (value.__btRole ~= nil or value.__btFn ~= nil)
end

local function resolve(binding: Binding): any
	if binding.__btFn then
		return binding.__btFn(current)
	end
	return current[binding.__btRole :: string]
end

function UI.Theme(): Theme
	return current
end

function UI.ThemeName(): string
	return currentName
end

function UI.SetTheme(name: string)
	if not Config.THEMES[name] then
		return
	end
	currentName = name
	current = Config.GetTheme(name)
	for inst, props in bindings do
		local target: any = inst
		for key, binding in props do
			target[key] = resolve(binding)
		end
	end
	themeChanged:Fire(name)
end

-- props বসায়। কোনো মান থিমের ভূমিকা হলে সেটা মনে রাখে।
function UI.Apply(inst: Instance, props: { [string]: any })
	for key, value in props do
		if key == "Parent" then
			continue
		end
		if isBinding(value) then
			local map = bindings[inst]
			if not map then
				map = {}
				bindings[inst] = map
			end
			map[key] = value
			local target: any = inst
			target[key] = resolve(value)
		else
			local map = bindings[inst]
			if map then
				map[key] = nil
			end
			local target: any = inst
			target[key] = value
		end
	end
end

function UI.New(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className)
	if props then
		UI.Apply(inst, props)
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

----------------------------------------------------------------------
-- ছোট অংশ
----------------------------------------------------------------------
local R = UI.Role

-- প্যানেলের কাচের মতো হালকা স্বচ্ছ পেছন।
UI.GlassTransparency = UI.Fn(function(theme)
	return theme.Glass
end)

function UI.Corner(radius: number?): UICorner
	return UI.New("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

-- কোণা পুরো গোল (pill বা বৃত্ত)।
function UI.Round(inst: Instance)
	local corner = inst:FindFirstChildOfClass("UICorner")
	if corner then
		corner.CornerRadius = UDim.new(1, 0)
	else
		UI.New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = inst })
	end
end

-- হালকা চিকন বর্ডার। role দিলে সেই রঙে (যেমন "Accent")।
function UI.Stroke(role: string?, transparency: number?): UIStroke
	return UI.New("UIStroke", {
		Color = R(role or "Stroke"),
		Transparency = if transparency
			then transparency
			else UI.Fn(function(theme)
				return if role then 0.35 else theme.StrokeTransparency
			end),
		Thickness = 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.Padding(x: number, y: number?): UIPadding
	return UI.New("UIPadding", {
		PaddingLeft = UDim.new(0, x),
		PaddingRight = UDim.new(0, x),
		PaddingTop = UDim.new(0, y or x),
		PaddingBottom = UDim.new(0, y or x),
	})
end

function UI.AccentGradient(rotation: number?): UIGradient
	return UI.New("UIGradient", {
		Rotation = rotation or 0,
		Color = UI.Fn(function(theme)
			return ColorSequence.new(theme.Accent, theme.AccentDeep)
		end),
	})
end

function UI.List(direction: Enum.FillDirection?, padding: number?, align: Enum.HorizontalAlignment?): UIListLayout
	return UI.New("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Left,
		VerticalAlignment = Enum.VerticalAlignment.Center,
	})
end

-- কাচের প্যানেল (Frame)।
function UI.Card(props: { [string]: any }, children: { Instance }?): Frame
	local defaults: { [string]: any } = {
		BackgroundColor3 = R("Background"),
		BackgroundTransparency = UI.GlassTransparency,
		BorderSizePixel = 0,
	}
	for key, value in props do
		defaults[key] = value
	end
	local card = UI.New("Frame", defaults, children)
	UI.Corner(14).Parent = card
	UI.Stroke().Parent = card
	return card
end

function UI.Label(props: { [string]: any }): TextLabel
	local defaults: { [string]: any } = {
		BackgroundTransparency = 1,
		Font = UI.Fonts.Medium,
		TextColor3 = R("Text"),
		TextSize = 15,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for key, value in props do
		defaults[key] = value
	end
	return UI.New("TextLabel", defaults)
end

-- ছোট বড়-হাতের মতো সেকশন শিরোনাম।
function UI.Caption(props: { [string]: any }): TextLabel
	local defaults: { [string]: any } = {
		Font = UI.Fonts.Bold,
		TextSize = 12,
		TextColor3 = R("SubText"),
		Size = UDim2.new(1, 0, 0, 18),
	}
	for key, value in props do
		defaults[key] = value
	end
	return UI.Label(defaults)
end

local BUTTON_STYLES: { [string]: { bg: string, text: string } } = {
	primary = { bg = "Accent", text = "OnAccent" },
	ghost = { bg = "Surface", text = "Text" },
	success = { bg = "Success", text = "OnAccent" },
	danger = { bg = "Danger", text = "OnAccent" },
	info = { bg = "Info", text = "OnAccent" },
}

-- বাটন: hover এ হালকা উজ্জ্বল, চাপলে একটু ছোট হয়।
function UI.Button(props: { [string]: any }, style: string?): TextButton
	local s = BUTTON_STYLES[style or "ghost"] or BUTTON_STYLES.ghost
	local defaults: { [string]: any } = {
		BackgroundColor3 = R(s.bg),
		TextColor3 = if style == "success" or style == "danger" or style == "info"
			then Color3.new(1, 1, 1)
			else R(s.text),
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Font = UI.Fonts.Bold,
		TextSize = 15,
	}
	for key, value in props do
		defaults[key] = value
	end
	local button = UI.New("TextButton", defaults)
	UI.Corner(10).Parent = button
	local scale = UI.New("UIScale", { Parent = button })
	local quick = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	-- hover এর আগের স্বচ্ছতা মনে রাখা, যাতে কাচের বাটন hover এর পরে ভরাট না হয়ে যায়।
	local baseTransparency: number? = nil
	button.MouseEnter:Connect(function()
		baseTransparency = baseTransparency or button.BackgroundTransparency
		local target = math.min(1, (baseTransparency :: number) + 0.12)
		TweenService:Create(button, quick, { BackgroundTransparency = target }):Play()
	end)
	button.MouseLeave:Connect(function()
		if baseTransparency then
			TweenService:Create(button, quick, { BackgroundTransparency = baseTransparency }):Play()
			baseTransparency = nil
		end
		TweenService:Create(scale, quick, { Scale = 1 }):Play()
	end)
	button.MouseButton1Down:Connect(function()
		TweenService:Create(scale, quick, { Scale = 0.96 }):Play()
	end)
	button.MouseButton1Up:Connect(function()
		TweenService:Create(scale, quick, { Scale = 1 }):Play()
	end)
	return button
end

-- বাটনের ধরন বদলানো (যেমন ট্যাব সিলেক্ট হলে)।
function UI.SetButtonStyle(button: TextButton, style: string)
	local s = BUTTON_STYLES[style] or BUTTON_STYLES.ghost
	UI.Apply(button, { BackgroundColor3 = R(s.bg), TextColor3 = R(s.text) })
end

function UI.ScreenGui(name: string, displayOrder: number): ScreenGui
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local old = playerGui:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	return UI.New("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = displayOrder,
		Parent = playerGui,
	})
end

return UI
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXBT14F141E3FE614AB6ACECD5D8F4B77500"><Properties><string name="Name">WinnerTags</string><ProtectedString name="Source">--[[
	BT Tools Event: WinnerTags (ModuleScript, ক্লায়েন্ট)
	বিজয়ীর "👑 WINNER" ট্যাগে countdown বার আর সোনালি ঝিলিক চালায়।
	ট্যাগগুলো সার্ভার বানায় (Showcase), এখানে শুধু নিজের স্ক্রিনে নড়াচড়া।
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local TAG_NAME = "BTWinnerTag"

local WinnerTags = {}

local tags: { [BillboardGui]: boolean } = {}

local function update(tag: BillboardGui, now: number, shimmer: number)
	local card = tag:FindFirstChild("Card")
	if not card then
		return
	end
	local title = card:FindFirstChild("Title")
	local gradient = title and title:FindFirstChildOfClass("UIGradient")
	if gradient then
		gradient.Offset = Vector2.new(0, shimmer)
	end

	local expiresAt = tag:GetAttribute("ExpiresAt")
	local duration = tag:GetAttribute("Duration")
	if type(expiresAt) ~= "number" or type(duration) ~= "number" or duration &lt;= 0 then
		return
	end
	local left = math.max(0, expiresAt - now)
	local barBack = card:FindFirstChild("BarBack")
	local fill = barBack and barBack:FindFirstChild("BarFill")
	if fill and fill:IsA("Frame") then
		fill.Size = UDim2.fromScale(math.clamp(left / duration, 0, 1), 1)
	end
	local timeText = card:FindFirstChild("TimeText")
	if timeText and timeText:IsA("TextLabel") then
		timeText.Text = `{math.ceil(left)}s`
	end
end

function WinnerTags.Init()
	local function add(instance: Instance)
		if instance:IsA("BillboardGui") then
			tags[instance] = true
		end
	end
	CollectionService:GetInstanceAddedSignal(TAG_NAME):Connect(add)
	CollectionService:GetInstanceRemovedSignal(TAG_NAME):Connect(function(instance)
		if instance:IsA("BillboardGui") then
			tags[instance] = nil
		end
	end)
	for _, instance in CollectionService:GetTagged(TAG_NAME) do
		add(instance)
	end

	RunService.Heartbeat:Connect(function()
		if not next(tags) then
			return
		end
		local now = Workspace:GetServerTimeNow()
		local shimmer = math.sin(os.clock() * 2) * 0.3
		for tag in tags do
			if tag.Parent then
				update(tag, now, shimmer)
			else
				tags[tag] = nil
			end
		end
	end)
end

return WinnerTags
