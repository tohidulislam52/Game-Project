					<Item class="Script" referent="RBX3A95868ACAF0455EB9C8527CD8749AF9">
						<Properties>
							<ProtectedString name="Source">local tool = script.Parent
local remoteEvent = tool:WaitForChild("RemoteEvent")

-- প্রতি প্লেয়ারের কাফ স্টেট ট্র্যাক করার টেবিল (গ্লোবাল বাগ ফিক্সড)
local cuffedPlayers = {}

local function getRootPart(character)
	return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
end

remoteEvent.OnServerEvent:Connect(function(player, state, targetPart)
	local playerChar = player.Character
	if not playerChar then return end
	local playerRoot = getRootPart(playerChar)
	if not playerRoot then return end

	if state == "Cuff" and targetPart then
		local targetChar = targetPart.Parent
		if targetChar:IsA("Accessory") then 
			targetChar = targetChar.Parent 
		end

		local targetHumanoid = targetChar:FindFirstChildOfClass("Humanoid")
		local targetRoot = getRootPart(targetChar)

		-- টার্গেট সঠিক কিনা এবং প্লেয়ার থেকে ১৫ স্টাডের মধ্যে আছে কিনা তা চেক করা
		if targetHumanoid and targetRoot and targetChar ~= playerChar then
			local distance = (playerRoot.Position - targetRoot.Position).Magnitude
			if distance &lt;= 15 then
				-- যদি প্লেয়ার আগে থেকেই কাউকে ধরে থাকে তবে নতুন করে ধরবে না
				if cuffedPlayers[player] then return end

				-- টার্গেটকে প্লেয়ারের ঠিক সামনে পজিশন করা
				targetRoot.CFrame = playerRoot.CFrame * CFrame.new(0, 0, -3)

				-- Physics Weld দিয়ে যুক্ত করা (লুপ ছাড়াই স্মুথলি কাজ করবে)
				local weld = Instance.new("WeldConstraint")
				weld.Name = "HandcuffWeld"
				weld.Part0 = playerRoot
				weld.Part1 = targetRoot
				weld.Parent = targetRoot

				cuffedPlayers[player] = weld
				remoteEvent:FireClient(player, "Use")
			end
		end

	elseif state == "UnCuff" then
		if cuffedPlayers[player] then
			if cuffedPlayers[player].Parent then
				cuffedPlayers[player]:Destroy()
			end
			cuffedPlayers[player] = nil
			remoteEvent:FireClient(player, "UnUse")
		end
	end
end)</ProtectedString>
