					<Item class="LocalScript" referent="RBXDFD5B1552AE84D8FA72D6484EF11FD40">
						<Properties>
							<ProtectedString name="Source">local tool = script.Parent

-- অ্যানিমেশন তৈরি
local idleAnim = Instance.new("Animation")
idleAnim.Name = "IdleAnim"
idleAnim.AnimationId = "rbxassetid://109232434446616" -- Idle Animation ID

local equipAnim = Instance.new("Animation")
equipAnim.Name = "EquipAnim"
equipAnim.AnimationId = "rbxassetid://109232434446616" -- Equip Tool Animation ID

-- ভেরিয়েবল সেটআপ
local idleTrack = nil
local equipTrack = nil

-- যখন টুল হাতে নেওয়া হয় (Equipped)
tool.Equipped:Connect(function()
	local character = tool.Parent
	local humanoid = character:FindFirstChild("Humanoid")

	if humanoid then
		-- আধুনিক নিয়মে Animator দিয়ে অ্যানিমেশন লোড করতে হয়
		local animator = humanoid:FindFirstChild("Animator") or humanoid:WaitForChild("Animator")

		-- যদি আগে লোড করা না থাকে, তবেই একবার লোড করবে
		if not idleTrack then
			idleTrack = animator:LoadAnimation(idleAnim)
			idleTrack.Priority = Enum.AnimationPriority.Action -- টুলের জন্য Action প্রিওরটি সবচেয়ে ভালো
			idleTrack.Looped = true
		end

		if not equipTrack then
			equipTrack = animator:LoadAnimation(equipAnim)
			equipTrack.Priority = Enum.AnimationPriority.Action
		end

		-- অ্যানিমেশন প্লে করা
		idleTrack:Play()
		equipTrack:Play()
	end
end)

-- যখন টুল হাত থেকে নামানো হয় (Unequipped)
tool.Unequipped:Connect(function()
	-- অ্যানিমেশন থামিয়ে দেওয়া
	if idleTrack then
		idleTrack:Stop()
	end
	if equipTrack then
		equipTrack:Stop()
	end
end)</ProtectedString>
