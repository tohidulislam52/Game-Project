					<Item class="Script" referent="RBXCFFC7DCB30F34CE58C009B90E38123B9">
						<Properties>
							<ProtectedString name="Source">local tool = script.Parent
local handle = tool:WaitForChild("Handle")

-- টুলের ভিতরের সব পার্টকে Handle এর সাথে যুক্ত করার ফাংশন
local function weldToolParts()
	for _, item in ipairs(tool:GetDescendants()) do
		if item:IsA("BasePart") and item ~= handle then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = item
			weld.Parent = item

			item.Anchored = false
		end
	end
end

-- টুল চালু হওয়ার সাথে সাথে মাত্র একবার ওয়েল্ড হবে
weldToolParts()</ProtectedString>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null /></Content>
							<token name="RunContext">0</token>
							<string name="ScriptGuid">{AC820B54-4DC8-4C40-AB77-166216BBCBC3}</string>
							<BinaryString name="AttributesSerialize" />
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<string name="Name">Script</string>
							<BinaryString name="SerializedOverrides" />
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
